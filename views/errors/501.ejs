
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || "Feature Unavailable" %> | Gyansify HRMS</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: grid;
            place-items: center;
            padding: 24px;
            background: #f4f7fb;
            color: #172033;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        }

        .card {
            width: 100%;
            max-width: 520px;
            padding: 40px 28px;
            text-align: center;
            background: white;
            border: 1px solid #e2e8f0;
            border-radius: 18px;
            box-shadow: 0 16px 45px rgba(15, 23, 42, .07);
        }

        .code {
            margin: 0;
            color: #2563eb;
            font-size: 76px;
            font-weight: 800;
        }

        h1 {
            margin: 12px 0;
            font-size: 25px;
        }

        p {
            color: #64748b;
            line-height: 1.7;
        }

        a {
            display: inline-block;
            margin-top: 18px;
            padding: 12px 20px;
            border-radius: 9px;
            background: #2563eb;
            color: white;
            text-decoration: none;
            font-weight: 600;
        }
    </style>
</head>

<body>
    <main class="card">
        <p class="code">501</p>

        <h1><%= title || "Feature Not Implemented" %></h1>

        <p>
            <%= message || "This feature is not available yet. Please contact your HR administrator." %>
        </p>

        <a href="/payroll">Back to Payroll</a>
    </main>
</body>
</html>
