
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#f8fafc">
    <meta name="description" content="Securely activate your Gyansify HRMS account.">

    <title><%= typeof title !== "undefined" && title ? title : "Set Password" %> - Gyansify HRMS</title>

    <style>
        :root {
            --primary: #4f46e5;
            --primary-dark: #4338ca;
            --text: #172033;
            --muted: #64748b;
            --border: #dbe3ef;
            --surface: #ffffff;
            --background: #f4f7fc;
            --danger: #b91c1c;
            --success: #15803d;
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            min-height: 100vh;
            display: grid;
            place-items: center;
            padding: 24px;
            color: var(--text);
            background:
                radial-gradient(circle at 10% 10%, #e0e7ff 0, transparent 32%),
                radial-gradient(circle at 90% 90%, #dbeafe 0, transparent 30%),
                var(--background);
            font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI",
                sans-serif;
        }

        .page {
            width: 100%;
            max-width: 460px;
        }

        .brand {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            margin-bottom: 24px;
        }

        .brand-logo {
            display: grid;
            place-items: center;
            width: 46px;
            height: 46px;
            border-radius: 14px;
            color: #fff;
            background: linear-gradient(135deg, #4f46e5, #2563eb);
            font-size: 21px;
            font-weight: 800;
            box-shadow: 0 8px 20px #4f46e533;
        }

        .brand-name {
            font-size: 22px;
            font-weight: 800;
            letter-spacing: -0.6px;
        }

        .brand-subtitle {
            margin-top: 3px;
            color: var(--muted);
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1.5px;
        }

        .card {
            padding: 34px;
            background: var(--surface);
            border: 1px solid #e7ecf4;
            border-radius: 22px;
            box-shadow: 0 24px 70px #17203312;
        }

        .icon-box {
            display: grid;
            place-items: center;
            width: 54px;
            height: 54px;
            margin-bottom: 22px;
            border-radius: 16px;
            background: #eef2ff;
            color: var(--primary);
            font-size: 25px;
        }

        h1 {
            margin: 0;
            font-size: clamp(25px, 5vw, 30px);
            letter-spacing: -1px;
        }

        .intro {
            margin: 11px 0 24px;
            color: var(--muted);
            font-size: 14px;
            line-height: 1.7;
        }

        .account {
            padding: 12px 14px;
            margin-bottom: 22px;
            background: #f8fafc;
            border: 1px solid #e8edf5;
            border-radius: 11px;
        }

        .account-label {
            display: block;
            margin-bottom: 5px;
            color: var(--muted);
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.8px;
        }

        .email {
            overflow-wrap: anywhere;
            font-size: 13px;
            font-weight: 650;
        }

        .alert {
            display: flex;
            gap: 10px;
            padding: 13px 14px;
            margin-bottom: 20px;
            border-radius: 11px;
            font-size: 13px;
            line-height: 1.6;
        }

        .alert-error {
            color: var(--danger);
            background: #fef2f2;
            border: 1px solid #fecaca;
        }

        .alert-success {
            color: var(--success);
            background: #f0fdf4;
            border: 1px solid #bbf7d0;
        }

        .field {
            margin-top: 19px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            font-size: 13px;
            font-weight: 700;
        }

        .input-wrap {
            position: relative;
        }

        input {
            width: 100%;
            min-height: 48px;
            padding: 12px 48px 12px 14px;
            border: 1px solid var(--border);
            border-radius: 10px;
            outline: none;
            background: #fff;
            color: var(--text);
            font: inherit;
            font-size: 14px;
            transition: border-color .2s, box-shadow .2s;
        }

        input:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 4px #4f46e51a;
        }

        input.invalid {
            border-color: #ef4444;
        }

        .toggle-password {
            position: absolute;
            top: 50%;
            right: 8px;
            transform: translateY(-50%);
            width: auto;
            margin: 0;
            padding: 7px 9px;
            border: 0;
            border-radius: 7px;
            background: transparent;
            color: var(--muted);
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
        }

        .toggle-password:hover {
            background: #f1f5f9;
            color: var(--text);
        }

        .hint {
            margin: 8px 0 0;
            color: var(--muted);
            font-size: 12px;
            line-height: 1.5;
        }

        .strength {
            display: flex;
            gap: 5px;
            margin-top: 10px;
        }

        .strength span {
            height: 4px;
            flex: 1;
            border-radius: 10px;
            background: #e2e8f0;
        }

        .strength-label {
            margin-top: 7px;
            color: var(--muted);
            font-size: 11px;
        }

        .field-error {
            display: none;
            margin-top: 7px;
            color: var(--danger);
            font-size: 12px;
        }

        .field-error.visible {
            display: block;
        }

        .requirements {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 9px;
            margin-top: 14px;
            padding: 14px;
            background: #f8fafc;
            border-radius: 10px;
        }

        .requirement {
            color: var(--muted);
            font-size: 11px;
        }

        .requirement.valid {
            color: var(--success);
        }

        .submit-button {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 9px;
            width: 100%;
            min-height: 50px;
            margin-top: 25px;
            padding: 14px 18px;
            border: 0;
            border-radius: 11px;
            background: var(--primary);
            color: #fff;
            font: inherit;
            font-size: 14px;
            font-weight: 750;
            cursor: pointer;
            transition: background .2s, transform .2s;
        }

        .submit-button:hover {
            background: var(--primary-dark);
            transform: translateY(-1px);
        }

        .submit-button:disabled {
            opacity: .65;
            cursor: not-allowed;
            transform: none;
        }

        .security-note {
            display: flex;
            justify-content: center;
            gap: 7px;
            margin: 20px 0 0;
            color: var(--muted);
            font-size: 11px;
            line-height: 1.6;
            text-align: center;
        }

        .footer {
            margin-top: 22px;
            color: #94a3b8;
            font-size: 11px;
            text-align: center;
        }

        .back-link {
            display: inline-block;
            margin-top: 18px;
            color: var(--primary);
            font-size: 13px;
            font-weight: 650;
            text-decoration: none;
        }

        .back-link:hover {
            text-decoration: underline;
        }

        @media (max-width: 480px) {
            body { padding: 16px; }
            .card { padding: 25px 21px; border-radius: 17px; }
            .requirements { grid-template-columns: 1fr; }
        }
    </style>
</head>

<body>
    <main class="page">
        <div class="brand">
            <div class="brand-logo" aria-hidden="true">G</div>
            <div>
                <div class="brand-name">Gyansify</div>
                <div class="brand-subtitle">HUMAN RESOURCE MANAGEMENT</div>
            </div>
        </div>

        <section class="card">
            <div class="icon-box" aria-hidden="true">🔐</div>

            <h1>Set your password</h1>
            <p class="intro">
                Welcome to Gyansify HRMS. Create a strong password to activate
                your account and securely access your employee workspace.
            </p>

            <% if (typeof error !== "undefined" && error) { %>
                <div class="alert alert-error" role="alert">
                    <span aria-hidden="true">⚠</span>
                    <span><%= error %></span>
                </div>
            <% } %>

            <% if (typeof success !== "undefined" && success) { %>
                <div class="alert alert-success" role="status">
                    <span aria-hidden="true">✓</span>
                    <span><%= success %></span>
                </div>
            <% } %>

            <% if (typeof email !== "undefined" && email) { %>
                <div class="account">
                    <span class="account-label">Account email</span>
                    <div class="email"><%= email %></div>
                </div>
            <% } %>

            <% if (typeof token !== "undefined" && token && typeof email !== "undefined" && email) { %>
                <form id="passwordForm" method="POST" action="/accept-invitation">
                    <input type="hidden" name="token" value="<%= token %>">
                    <input type="hidden" name="email" value="<%= email %>">

                    <div class="field">
                        <label for="password">New password</label>
                        <div class="input-wrap">
                            <input
                                id="password"
                                type="password"
                                name="password"
                                minlength="12"
                                maxlength="128"
                                autocomplete="new-password"
                                placeholder="Create a strong password"
                                aria-describedby="passwordHint passwordError"
                                required
                            >
                            <button class="toggle-password" type="button"
                                data-target="password" aria-label="Show password">
                                Show
                            </button>
                        </div>

                        <div class="strength" aria-hidden="true">
                            <span></span><span></span><span></span><span></span>
                        </div>
                        <div id="strengthLabel" class="strength-label">
                            Password strength: not entered
                        </div>

                        <p id="passwordHint" class="hint">
                            Use at least 12 characters for better account security.
                        </p>
                        <div id="passwordError" class="field-error" role="alert"></div>

                        <div class="requirements">
                            <div class="requirement" id="reqLength">○ 12+ characters</div>
                            <div class="requirement" id="reqUpper">○ Uppercase letter</div>
                            <div class="requirement" id="reqLower">○ Lowercase letter</div>
                            <div class="requirement" id="reqNumber">○ Number</div>
                            <div class="requirement" id="reqSpecial">○ Special character</div>
                        </div>
                    </div>

                    <div class="field">
                        <label for="confirmPassword">Confirm password</label>
                        <div class="input-wrap">
                            <input
                                id="confirmPassword"
                                type="password"
                                name="confirmPassword"
                                minlength="12"
                                maxlength="128"
                                autocomplete="new-password"
                                placeholder="Enter the same password again"
                                aria-describedby="confirmError"
                                required
                            >
                            <button class="toggle-password" type="button"
                                data-target="confirmPassword" aria-label="Show password">
                                Show
                            </button>
                        </div>
                        <div id="confirmError" class="field-error" role="alert"></div>
                    </div>

                    <button class="submit-button" id="submitButton" type="submit">
                        <span>Set Password &amp; Activate Account</span>
                        <span aria-hidden="true">→</span>
                    </button>

                    <p class="security-note">
                        <span aria-hidden="true">🔒</span>
                        Your password should be unique and never shared with anyone.
                    </p>
                </form>
            <% } else if (!(typeof error !== "undefined" && error)) { %>
                <div class="alert alert-error" role="alert">
                    This invitation link is missing required information or is invalid.
                    Please request a new invitation from your HR administrator.
                </div>
            <% } %>

            <a class="back-link" href="/login">← Back to login</a>
        </section>

        <div class="footer">
            © <%= typeof currentYear !== "undefined" ? currentYear : new Date().getFullYear() %>
            Gyansify HRMS. All rights reserved.
        </div>
    </main>

    <script>
        (() => {
            const form = document.getElementById("passwordForm");
            if (!form) return;

            const password = document.getElementById("password");
            const confirmPassword = document.getElementById("confirmPassword");
            const submitButton = document.getElementById("submitButton");

            const rules = {
                reqLength: value => value.length >= 12,
                reqUpper: value => /[A-Z]/.test(value),
                reqLower: value => /[a-z]/.test(value),
                reqNumber: value => /\d/.test(value),
                reqSpecial: value => /[^A-Za-z0-9]/.test(value)
            };

            function updateRequirement(id, valid) {
                const element = document.getElementById(id);
                element.classList.toggle("valid", valid);
                element.textContent = (valid ? "✓ " : "○ ") +
                    element.textContent.replace(/^[✓○]\s*/, "");
            }

            function updateStrength() {
                const value = password.value;
                let score = 0;

                Object.entries(rules).forEach(([id, test]) => {
                    const valid = test(value);
                    if (valid) score++;
                    updateRequirement(id, valid);
                });

                const bars = document.querySelectorAll(".strength span");
                const label = document.getElementById("strengthLabel");
                const labels = [
                    "Password strength: very weak",
                    "Password strength: weak",
                    "Password strength: fair",
                    "Password strength: good",
                    "Password strength: strong",
                    "Password strength: strong"
                ];

                bars.forEach((bar, index) => {
                    bar.style.background =
                        value && index < score
                            ? (score <= 2 ? "#ef4444" :
                               score <= 3 ? "#f59e0b" : "#16a34a")
                            : "#e2e8f0";
                });

                label.textContent = value
                    ? labels[score]
                    : "Password strength: not entered";

                if (confirmPassword.value) validateConfirmation(false);
            }

            function validateConfirmation(showError = true) {
                const error = document.getElementById("confirmError");
                const mismatch = confirmPassword.value !== password.value;

                confirmPassword.classList.toggle(
                    "invalid",
                    showError && mismatch && confirmPassword.value.length > 0
                );

                error.textContent =
                    mismatch && confirmPassword.value.length > 0
                        ? "Passwords do not match."
                        : "";

                error.classList.toggle(
                    "visible",
                    showError && mismatch && confirmPassword.value.length > 0
                );

                return !mismatch && confirmPassword.value.length > 0;
            }

            document.querySelectorAll(".toggle-password").forEach(button => {
                button.addEventListener("click", () => {
                    const input = document.getElementById(button.dataset.target);
                    const showing = input.type === "text";

                    input.type = showing ? "password" : "text";
                    button.textContent = showing ? "Show" : "Hide";
                    button.setAttribute(
                        "aria-label",
                        showing ? "Show password" : "Hide password"
                    );
                });
            });

            password.addEventListener("input", updateStrength);

            confirmPassword.addEventListener("input", () => {
                validateConfirmation(true);
            });

            form.addEventListener("submit", event => {
                const value = password.value;
                const allRulesPassed = Object.values(rules)
                    .every(test => test(value));
                const matches = validateConfirmation(true);

                const passwordError = document.getElementById("passwordError");
                passwordError.textContent = allRulesPassed
                    ? ""
                    : "Meet all password requirements before continuing.";
                passwordError.classList.toggle("visible", !allRulesPassed);

                if (!allRulesPassed || !matches || !form.checkValidity()) {
                    event.preventDefault();
                    return;
                }

                submitButton.disabled = true;
                submitButton.querySelector("span").textContent = "Submitting...";
            });
        })();
    </script>
</body>
</html>
