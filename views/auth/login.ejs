<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Gyansify HRMS - Login
    </title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {

            min-height: 100vh;

            font-family:
                Inter,
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                sans-serif;

            background:
                linear-gradient(
                    135deg,
                    #f8fafc 0%,
                    #eef2f7 100%
                );

            color: #111827;

        }

        /* ================================================= */
        /* PAGE */
        /* ================================================= */

        .login-page {

            min-height: 100vh;

            display: flex;

            align-items: center;

            justify-content: center;

            padding: 30px 20px;

        }

        .login-wrapper {

            width: 100%;

            max-width: 430px;

        }

        /* ================================================= */
        /* BACK HOME */
        /* ================================================= */

        .back-home {

            display: inline-flex;

            align-items: center;

            gap: 7px;

            margin-bottom: 18px;

            color: #6b7280;

            text-decoration: none;

            font-size: 12px;

        }

        .back-home:hover {

            color: #111827;

        }

        /* ================================================= */
        /* CARD */
        /* ================================================= */

        .login-card {

            background: white;

            border:
                1px solid #e5e7eb;

            border-radius: 16px;

            padding: 38px;

            box-shadow:
                0 20px 50px
                rgba(15, 23, 42, 0.08);

        }

        /* ================================================= */
        /* BRAND */
        /* ================================================= */

        .brand {

            text-align: center;

            margin-bottom: 30px;

        }


/* COMPANY LOGO */
.login-brand-logo {
    width: 76px;
    height: 76px;
    margin: 0 auto 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 16px;
    background: #ffffff;
    text-decoration: none;
}

.login-brand-logo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
}

.login-brand-fallback {
    display: none;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    border-radius: 16px;
    background: #111827;
    color: #ffffff;
    font-size: 34px;
    font-weight: 700;
}

.brand h1 span {
    color: #f4971e;
}


        .brand h1 {

            font-size: 24px;

            letter-spacing: -0.5px;

            color: #00488b;

        }

        .brand p {

            margin-top: 5px;

            color: #9ca3af;

            font-size: 12px;

        }

        /* ================================================= */
        /* HEADING */
        /* ================================================= */

        .login-heading {

            margin-bottom: 22px;

        }

        .login-heading h2 {

            font-size: 18px;

            margin-bottom: 6px;

        }

        .login-heading p {

            color: #6b7280;

            font-size: 12px;

            line-height: 1.5;

        }

        /* ================================================= */
        /* ERROR */
        /* ================================================= */

        .error-message {

            background: #fef2f2;

            border:
                1px solid #fecaca;

            color: #b91c1c;

            border-radius: 8px;

            padding: 11px 13px;

            margin-bottom: 18px;

            font-size: 11px;

            line-height: 1.5;

        }

        /* ================================================= */
        /* FORM */
        /* ================================================= */

        .form-group {

            margin-bottom: 18px;

        }

        label {

            display: block;

            margin-bottom: 7px;

            font-size: 11px;

            font-weight: 600;

            color: #374151;

        }

        input {

            width: 100%;

            height: 44px;

            border:
                1px solid #d1d5db;

            border-radius: 8px;

            padding:
                0 12px;

            outline: none;

            font-size: 12px;

            color: #111827;

            background: white;

            transition:
                border-color .2s,
                box-shadow .2s;

        }

        input::placeholder {

            color: #9ca3af;

        }

        input:focus {

            border-color: #6b7280;

            box-shadow:
                0 0 0 3px
                rgba(107, 114, 128, .10);

        }

        /* ================================================= */
        /* PASSWORD */
        /* ================================================= */

        .password-wrapper {

            position: relative;

        }

        .password-wrapper input {

            padding-right: 65px;

        }

        .show-password {

            position: absolute;

            right: 10px;

            top: 50%;

            transform:
                translateY(-50%);

            border: none;

            background: transparent;

            color: #6b7280;

            font-size: 10px;

            cursor: pointer;

        }

        .show-password:hover {

            color: #111827;

        }

        /* ================================================= */
        /* BUTTON */
        /* ================================================= */

        .login-button {

            width: 100%;

            height: 45px;

            border: none;

            border-radius: 8px;

            background: #111827;

            color: white;

            font-size: 12px;

            font-weight: 600;

            cursor: pointer;

            transition:
                background .2s,
                transform .2s;

        }

        .login-button:hover {

            background: #1f2937;

            transform:
                translateY(-1px);

        }

        .login-button:active {

            transform:
                translateY(0);

        }

        /* ================================================= */
        /* SECURITY */
        /* ================================================= */

        .security-note {

            display: flex;

            align-items: center;

            justify-content: center;

            gap: 6px;

            margin-top: 22px;

            color: #9ca3af;

            font-size: 10px;

        }

        /* ================================================= */
        /* FOOTER */
        /* ================================================= */

        .login-footer {

            text-align: center;

            margin-top: 20px;

            color: #9ca3af;

            font-size: 10px;

        }

        /* ================================================= */
        /* RESPONSIVE */
        /* ================================================= */

        @media(max-width: 500px) {

            .login-page {

                padding: 20px 15px;

            }

            .login-card {

                padding: 28px 22px;

            }

        }

    </style>

</head>


<body>


<div class="login-page">


    <div class="login-wrapper">


        <!-- ================================================= -->
        <!-- BACK HOME -->
        <!-- ================================================= -->

        <a
            href="/"
            class="back-home"
        >
            ← Back to Home
        </a>


        <!-- ================================================= -->
        <!-- LOGIN CARD -->
        <!-- ================================================= -->

        <div class="login-card">


            <!-- BRAND -->

<!-- BRAND -->
<div class="brand">

    <a href="/" class="login-brand-logo" aria-label="Gyansify">
        <img
            src="<%= typeof navbarLogo !== 'undefined' && navbarLogo ? navbarLogo : '/images/gyansify-logo.png' %>"
            alt="Gyansify Company Logo"
            onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
        >

        <span class="login-brand-fallback" aria-hidden="true">G</span>
    </a>

    <h1>
        Gyans<span>ify</span>
    </h1>

    <p>Human Resource Management System</p>

</div>



            <!-- HEADING -->

            <div class="login-heading">

                <h2>
                    Welcome back
                </h2>

                <p>
                    Sign in to access your HRMS workspace.
                </p>

            </div>


            <!-- ERROR -->

            <% if (
                typeof error !== "undefined" &&
                error
            ) { %>

                <div class="error-message">

                    <%= error %>

                </div>

            <% } %>


            <!-- FORM -->

            <form
                action="/login"
                method="POST"
            >


                <!-- EMAIL -->

                <div class="form-group">

                    <label for="email">
                        Email Address
                    </label>

                    <input
                        id="email"
                        type="email"
                        name="email"
                        placeholder="Enter your email address"
                        autocomplete="email"
                        required
                    >

                </div>


                <!-- PASSWORD -->

                <div class="form-group">

                    <label for="password">
                        Password
                    </label>

                    <div class="password-wrapper">

                        <input
                            id="password"
                            type="password"
                            name="password"
                            placeholder="Enter your password"
                            autocomplete="current-password"
                            required
                        >

                        <button
                            type="button"
                            class="show-password"
                            onclick="togglePassword()"
                        >
                            Show
                        </button>

                    </div>

                </div>


                <!-- LOGIN -->

                <button
                    type="submit"
                    class="login-button"
                >
                    Sign In to HRMS
                </button>


            </form>


            <!-- SECURITY -->

            <div class="security-note">

                🔒

                Secure HRMS Access

            </div>


        </div>


        <!-- FOOTER -->

        <div class="login-footer">

            © <%= new Date().getFullYear() %>
            Gyansify HRMS

        </div>


    </div>

</div>


<script>

    function togglePassword() {

        const password =
            document.getElementById(
                "password"
            );

        const button =
            document.querySelector(
                ".show-password"
            );


        if (
            password.type === "password"
        ) {

            password.type = "text";

            button.textContent =
                "Hide";

        } else {

            password.type = "password";

            button.textContent =
                "Show";

        }

    }

</script>


</body>

</html>