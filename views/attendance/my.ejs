<div class="my-attendance">

    <!-- PAGE HEADER -->

    <div class="attendance-page-heading">
        <div>
            <h1>My Attendance</h1>
            <p>
                Track your daily attendance, working hours and attendance history.
            </p>
        </div>

        <div class="attendance-employee-chip">
            <strong><%= employeeName %></strong>
            <% if (employee && employee.employeeId) { %>
                · <%= employee.employeeId %>
            <% } %>
        </div>
    </div>

    <!-- SUMMARY CARDS -->

    <div class="attendance-stats-grid">

        <div class="attendance-stat-card">
            <div class="attendance-stat-label">Recorded Days</div>
            <div class="attendance-stat-value"><%= stats.totalDays %></div>
            <div class="attendance-stat-note">Latest 30 records</div>
        </div>

        <div class="attendance-stat-card">
            <div class="attendance-stat-label">Present</div>
            <div class="attendance-stat-value"><%= stats.present %></div>
            <div class="attendance-stat-note">Marked present</div>
        </div>

        <div class="attendance-stat-card">
            <div class="attendance-stat-label">Late Arrivals</div>
            <div class="attendance-stat-value"><%= stats.late %></div>
            <div class="attendance-stat-note">Late attendance records</div>
        </div>

        <div class="attendance-stat-card">
            <div class="attendance-stat-label">Total Work Hours</div>
            <div class="attendance-stat-value"><%= stats.totalWorkHours %></div>
            <div class="attendance-stat-note">
                Overtime: <%= stats.totalOvertimeHours %> hours
            </div>
        </div>

    </div>

    <!-- TODAY'S ATTENDANCE -->

    <section class="attendance-panel">

        <div class="attendance-panel-header">
            <div>
                <h2>Today's Attendance</h2>
                <p><%= date %> · India Standard Time</p>
            </div>

            <% if (todayRecord) { %>
                <span class="attendance-status <%= statusClass(todayRecord.status) %>">
                    <%= todayRecord.status || "Recorded" %>
                </span>
            <% } else { %>
                <span class="attendance-status status-default">Not Marked</span>
            <% } %>
        </div>

        <div class="attendance-today-content">

            <div class="attendance-time-box">
                <div class="attendance-time-label">Check-in</div>
                <div class="attendance-time-value">
                    <%= todayRecord ? formatTime(todayRecord.checkIn) : "--" %>
                </div>
            </div>

            <div class="attendance-time-box">
                <div class="attendance-time-label">Check-out</div>
                <div class="attendance-time-value">
                    <%= todayRecord ? formatTime(todayRecord.checkOut) : "--" %>
                </div>
            </div>

            <div class="attendance-time-box">
                <div class="attendance-time-label">Working Time</div>
                <div class="attendance-time-value">
                    <%= todayRecord
                        ? formatDuration(todayRecord.workMinutes)
                        : "0h 0m" %>
                </div>
            </div>

        </div>

        <!-- GEOLOCATION CHECK-IN / CHECK-OUT -->

        <div class="attendance-actions">
            <div class="attendance-actions-inner">

                <h3>Office Location Attendance</h3>

                <p class="attendance-actions-description">
                    Allow location access when prompted. Your location will be checked
                    against the office geofence before attendance is recorded.
                </p>

                <% if (!hasCheckedIn) { %>

                    <form
                        method="POST"
                        action="/attendance/check-in/<%= encodeURIComponent(String(employee._id)) %>"
                        data-geolocation-form
                        data-action-label="Check In"
                    >
                        <input type="hidden" name="latitude" value="">
                        <input type="hidden" name="longitude" value="">

                        <div class="attendance-action-buttons">
                            <button
                                type="submit"
                                class="attendance-action-btn attendance-check-in"
                                data-submit-button
                            >
                                <span aria-hidden="true">↗</span>
                                <span data-button-label>Check In</span>
                            </button>
                        </div>
                    </form>

                <% } else if (!hasCheckedOut) { %>

                    <form
                        method="POST"
                        action="/attendance/check-out/<%= encodeURIComponent(String(employee._id)) %>"
                        data-geolocation-form
                        data-action-label="Check Out"
                    >
                        <input type="hidden" name="latitude" value="">
                        <input type="hidden" name="longitude" value="">

                        <div class="attendance-action-buttons">
                            <button
                                type="submit"
                                class="attendance-action-btn attendance-check-out"
                                data-submit-button
                            >
                                <span aria-hidden="true">↙</span>
                                <span data-button-label>Check Out</span>
                            </button>
                        </div>
                    </form>

                <% } else { %>

                    <div class="attendance-complete-message">
                        <strong>Attendance completed for today.</strong>
                        <br>
                        Your check-in and check-out have both been recorded.
                    </div>

                <% } %>

                <div
                    class="attendance-location-message"
                    data-location-message
                    role="status"
                    aria-live="polite"
                ></div>

                <div class="attendance-location-note">
                    <span aria-hidden="true">📍</span>
                    <span>
                        GPS verification is required for both check-in and check-out.
                        Attendance is accepted only inside the radius configured by HR.
                    </span>
                </div>

            </div>
        </div>

    </section>

    <!-- ATTENDANCE HISTORY -->

    <section class="attendance-panel">

        <div class="attendance-panel-header">
            <div>
                <h2>Attendance History</h2>
                <p>Your most recent attendance records.</p>
            </div>

            <span class="attendance-record-count">
                <%= records.length %> records
            </span>
        </div>

        <% if (records.length > 0) { %>

            <div class="attendance-table-wrap">
                <table class="attendance-history-table">

                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Check-in</th>
                            <th>Check-out</th>
                            <th>Working Hours</th>
                            <th>Overtime</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody>
                        <% records.forEach(record => { %>
                            <tr>
                                <td>
                                    <strong><%= formatDate(record.date) %></strong>
                                </td>
                                <td><%= formatTime(record.checkIn) %></td>
                                <td><%= formatTime(record.checkOut) %></td>
                                <td><%= formatDuration(record.workMinutes) %></td>
                                <td><%= formatDuration(record.overtimeMinutes) %></td>
                                <td>
                                    <span class="attendance-status <%= statusClass(record.status) %>">
                                        <%= record.status || "Unspecified" %>
                                    </span>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>

                </table>
            </div>

        <% } else { %>

            <div class="attendance-empty">
                <strong>No attendance records yet</strong>
                Your attendance history will appear here after attendance is recorded.
            </div>

        <% } %>

    </section>

</div>

<script>
(() => {
    "use strict";

    const forms = document.querySelectorAll("[data-geolocation-form]");

    forms.forEach((form) => {
        form.addEventListener("submit", (event) => {
            event.preventDefault();

            if (form.dataset.submitting === "true") {
                return;
            }

            const message = document.querySelector("[data-location-message]");
            const button = form.querySelector("[data-submit-button]");
            const buttonLabel = form.querySelector("[data-button-label]");
            const latitudeInput = form.querySelector('[name="latitude"]');
            const longitudeInput = form.querySelector('[name="longitude"]');
            const actionLabel = form.dataset.actionLabel || "Attendance";

            const showMessage = (text, type) => {
                if (!message) return;

                message.textContent = text;
                message.className =
                    "attendance-location-message is-visible is-" + type;
            };

            if (!navigator.geolocation) {
                showMessage(
                    "Your browser does not support GPS location. Please use a supported browser.",
                    "error"
                );
                return;
            }

            form.dataset.submitting = "true";

            if (button) {
                button.disabled = true;
            }

            if (buttonLabel) {
                buttonLabel.textContent = "Getting location...";
            }

            showMessage(
                "Please allow location access. Retrieving your current position...",
                "info"
            );

            navigator.geolocation.getCurrentPosition(
                (position) => {
                    const latitude = position.coords.latitude;
                    const longitude = position.coords.longitude;
                    const accuracy = position.coords.accuracy;

                    if (
                        !Number.isFinite(latitude) ||
                        !Number.isFinite(longitude) ||
                        !Number.isFinite(accuracy)
                    ) {
                        resetButton();
                        showMessage(
                            "Your browser returned an invalid location. Please try again.",
                            "error"
                        );
                        return;
                    }

                    // Avoid proceeding with an obviously imprecise fix.
                    // The server still performs the authoritative radius check.
                    if (accuracy > 100) {
                        resetButton();
                        showMessage(
                            "GPS accuracy is approximately " +
                            Math.round(accuracy) +
                            " metres. Move to an area with a clearer GPS signal and try again.",
                            "error"
                        );
                        return;
                    }

                    latitudeInput.value = String(latitude);
                    longitudeInput.value = String(longitude);

                    showMessage(
                        "Location obtained. Submitting " +
                        actionLabel.toLowerCase() +
                        " request for server-side verification...",
                        "info"
                    );

                    // Native submission bypasses this submit listener.
                    HTMLFormElement.prototype.submit.call(form);
                },
                (error) => {
                    resetButton();

                    let errorMessage =
                        "Unable to retrieve your location. Please try again.";

                    if (error.code === error.PERMISSION_DENIED) {
                        errorMessage =
                            "Location permission was denied. Enable location access for this site and try again.";
                    } else if (error.code === error.POSITION_UNAVAILABLE) {
                        errorMessage =
                            "Your current location is unavailable. Check device location settings and try again.";
                    } else if (error.code === error.TIMEOUT) {
                        errorMessage =
                            "Location request timed out. Please try again in an area with a better GPS signal.";
                    }

                    showMessage(errorMessage, "error");
                },
                {
                    enableHighAccuracy: true,
                    timeout: 20000,
                    maximumAge: 0
                }
            );

            function resetButton() {
                form.dataset.submitting = "false";

                if (button) {
                    button.disabled = false;
                }

                if (buttonLabel) {
                    buttonLabel.textContent = actionLabel;
                }
            }
        });
    });
})();
</script>
