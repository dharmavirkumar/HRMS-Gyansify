
<%
    const employeeName = employee
        ? [employee.firstName, employee.lastName].filter(Boolean).join(" ")
        : "Employee";

    const records = Array.isArray(attendanceRecords)
        ? attendanceRecords
        : [];

    const todayRecord = todayAttendance || null;

    const formatTime = (value) => {
        if (!value) return "--";
        const date = new Date(value);

        return date.toLocaleTimeString("en-IN", {
            timeZone: "Asia/Kolkata",
            hour: "2-digit",
            minute: "2-digit",
            hour12: true
        });
    };

    const formatDate = (value) => {
        if (!value) return "--";

        const date = new Date(value + "T00:00:00+05:30");

        return date.toLocaleDateString("en-IN", {
            timeZone: "Asia/Kolkata",
            day: "2-digit",
            month: "short",
            year: "numeric"
        });
    };

    const formatDuration = (minutes) => {
        const total = Number(minutes) || 0;
        const hours = Math.floor(total / 60);
        const mins = total % 60;

        return `${hours}h ${mins}m`;
    };

    const statusClass = (status) => {
        const value = String(status || "").toLowerCase();

        if (value === "present") return "status-present";
        if (value === "late") return "status-late";
        if (value === "leave") return "status-leave";
        if (value === "half day") return "status-halfday";

        return "status-default";
    };
%>

<link rel="stylesheet" href="/css/dashboard.css">

<style>
    .my-attendance {
        max-width: 1440px;
        margin: 0 auto;
        color: var(--text-primary, #172033);
    }

    .attendance-page-heading {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 26px;
        flex-wrap: wrap;
    }

    .attendance-page-heading h1 {
        margin: 0 0 8px;
        font-size: clamp(24px, 3vw, 32px);
        font-weight: 750;
    }

    .attendance-page-heading p {
        margin: 0;
        color: var(--text-secondary, #64748b);
        font-size: 14px;
    }

    .attendance-employee-chip {
        padding: 10px 15px;
        border: 1px solid #e2e8f0;
        background: #fff;
        border-radius: 12px;
        font-size: 13px;
        color: #475569;
    }

    .attendance-stats-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 18px;
        margin-bottom: 24px;
    }

    .attendance-stat-card {
        background: #fff;
        border: 1px solid #e8edf4;
        border-radius: 16px;
        padding: 21px;
        box-shadow: 0 4px 18px rgba(15, 23, 42, 0.035);
        min-width: 0;
    }

    .attendance-stat-label {
        color: #64748b;
        font-size: 13px;
        margin-bottom: 12px;
    }

    .attendance-stat-value {
        font-size: 27px;
        font-weight: 750;
        line-height: 1.2;
        color: #172033;
    }

    .attendance-stat-note {
        color: #94a3b8;
        font-size: 12px;
        margin-top: 8px;
    }

    .attendance-panel {
        background: #fff;
        border: 1px solid #e8edf4;
        border-radius: 16px;
        overflow: hidden;
        margin-bottom: 24px;
        box-shadow: 0 4px 18px rgba(15, 23, 42, 0.035);
    }

    .attendance-panel-header {
        padding: 21px 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
        border-bottom: 1px solid #edf1f6;
    }

    .attendance-panel-header h2 {
        margin: 0;
        font-size: 17px;
        font-weight: 700;
    }

    .attendance-panel-header p {
        margin: 6px 0 0;
        color: #64748b;
        font-size: 13px;
    }

    .attendance-today-content {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 20px;
        padding: 24px;
    }

    .attendance-time-box {
        background: #f8fafc;
        border: 1px solid #edf1f6;
        padding: 18px;
        border-radius: 12px;
    }

    .attendance-time-label {
        color: #64748b;
        font-size: 13px;
        margin-bottom: 9px;
    }

    .attendance-time-value {
        font-size: 22px;
        font-weight: 750;
        color: #172033;
    }

    .attendance-status {
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        padding: 6px 11px;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    .status-present {
        color: #047857;
        background: #d1fae5;
    }

    .status-late {
        color: #b45309;
        background: #fef3c7;
    }

    .status-leave {
        color: #1d4ed8;
        background: #dbeafe;
    }

    .status-halfday {
        color: #7e22ce;
        background: #f3e8ff;
    }

    .status-default {
        color: #475569;
        background: #f1f5f9;
    }

    .attendance-table-wrap {
        overflow-x: auto;
        width: 100%;
    }

    .attendance-history-table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
        min-width: 720px;
    }

    .attendance-history-table th {
        padding: 14px 22px;
        background: #f8fafc;
        color: #64748b;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .035em;
        white-space: nowrap;
    }

    .attendance-history-table td {
        padding: 16px 22px;
        border-top: 1px solid #edf1f6;
        font-size: 13px;
        color: #334155;
    }

    .attendance-history-table tbody tr:hover {
        background: #fafcff;
    }

    .attendance-empty {
        padding: 42px 20px;
        text-align: center;
        color: #64748b;
    }

    .attendance-empty strong {
        display: block;
        margin-bottom: 7px;
        color: #334155;
        font-size: 15px;
    }

    .attendance-record-count {
        font-size: 12px;
        color: #64748b;
    }

    @media (max-width: 1000px) {
        .attendance-stats-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 650px) {
        .attendance-stats-grid {
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        .attendance-stat-card {
            padding: 15px;
        }

        .attendance-stat-value {
            font-size: 22px;
        }

        .attendance-today-content {
            grid-template-columns: 1fr;
            padding: 16px;
            gap: 12px;
        }

        .attendance-panel-header {
            padding: 18px;
        }
    }

    @media (max-width: 380px) {
        .attendance-stats-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="my-attendance">

    <div class="attendance-page-heading">
        <div>
            <h1>My Attendance</h1>
            <p>
                Track your daily attendance, working hours and attendance history.
            </p>
        </div>

        <div class="attendance-employee-chip">
            <strong><%= employeeName %></strong>
            <% if (employee && employee.employeeId) { %>
                · <%= employee.employeeId %>
            <% } %>
        </div>
    </div>

    <!-- SUMMARY CARDS -->

    <div class="attendance-stats-grid">

        <div class="attendance-stat-card">
            <div class="attendance-stat-label">Recorded Days</div>
            <div class="attendance-stat-value">
                <%= stats.totalDays %>
            </div>
            <div class="attendance-stat-note">Latest 30 records</div>
        </div>

        <div class="attendance-stat-card">
            <div class="attendance-stat-label">Present</div>
            <div class="attendance-stat-value">
                <%= stats.present %>
            </div>
            <div class="attendance-stat-note">Marked present</div>
        </div>

        <div class="attendance-stat-card">
            <div class="attendance-stat-label">Late Arrivals</div>
            <div class="attendance-stat-value">
                <%= stats.late %>
            </div>
            <div class="attendance-stat-note">Late attendance records</div>
        </div>

        <div class="attendance-stat-card">
            <div class="attendance-stat-label">Total Work Hours</div>
            <div class="attendance-stat-value">
                <%= stats.totalWorkHours %>
            </div>
            <div class="attendance-stat-note">
                Overtime: <%= stats.totalOvertimeHours %> hours
            </div>
        </div>

    </div>

    <!-- TODAY'S ATTENDANCE -->

    <section class="attendance-panel">

        <div class="attendance-panel-header">
            <div>
                <h2>Today's Attendance</h2>
                <p><%= date %> · India Standard Time</p>
            </div>

            <% if (todayRecord) { %>
                <span class="attendance-status <%= statusClass(todayRecord.status) %>">
                    <%= todayRecord.status || "Recorded" %>
                </span>
            <% } else { %>
                <span class="attendance-status status-default">
                    Not Marked
                </span>
            <% } %>
        </div>

        <div class="attendance-today-content">

            <div class="attendance-time-box">
                <div class="attendance-time-label">Check-in</div>
                <div class="attendance-time-value">
                    <%= todayRecord ? formatTime(todayRecord.checkIn) : "--" %>
                </div>
            </div>

            <div class="attendance-time-box">
                <div class="attendance-time-label">Check-out</div>
                <div class="attendance-time-value">
                    <%= todayRecord ? formatTime(todayRecord.checkOut) : "--" %>
                </div>
            </div>

            <div class="attendance-time-box">
                <div class="attendance-time-label">Working Time</div>
                <div class="attendance-time-value">
                    <%= todayRecord
                        ? formatDuration(todayRecord.workMinutes)
                        : "0h 0m" %>
                </div>
            </div>

        </div>
    </section>

    <!-- ATTENDANCE HISTORY -->

    <section class="attendance-panel">

        <div class="attendance-panel-header">
            <div>
                <h2>Attendance History</h2>
                <p>Your most recent attendance records.</p>
            </div>

            <span class="attendance-record-count">
                <%= records.length %> records
            </span>
        </div>

        <% if (records.length > 0) { %>

            <div class="attendance-table-wrap">

                <table class="attendance-history-table">

                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Check-in</th>
                            <th>Check-out</th>
                            <th>Working Hours</th>
                            <th>Overtime</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody>

                        <% records.forEach(record => { %>

                            <tr>
                                <td>
                                    <strong><%= formatDate(record.date) %></strong>
                                </td>

                                <td><%= formatTime(record.checkIn) %></td>

                                <td><%= formatTime(record.checkOut) %></td>

                                <td><%= formatDuration(record.workMinutes) %></td>

                                <td><%= formatDuration(record.overtimeMinutes) %></td>

                                <td>
                                    <span class="attendance-status <%= statusClass(record.status) %>">
                                        <%= record.status || "Unspecified" %>
                                    </span>
                                </td>
                            </tr>

                        <% }) %>

                    </tbody>

                </table>

            </div>

        <% } else { %>

            <div class="attendance-empty">
                <strong>No attendance records yet</strong>
                Your attendance history will appear here after attendance is recorded.
            </div>

        <% } %>

    </section>

</div>
