
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Leave Types | Gyansify HRMS</title>

    <link rel="stylesheet" href="/css/dashboard.css">

    <style>
        * {
            box-sizing: border-box;
        }

        :root {
            --leave-primary: #2563eb;
            --leave-primary-dark: #1d4ed8;
            --leave-text: #172033;
            --leave-muted: #64748b;
            --leave-border: #e5eaf2;
            --leave-background: #f5f7fb;
            --leave-success: #15803d;
            --leave-danger: #dc2626;
        }

        body {
            margin: 0;
            background: var(--leave-background);
            color: var(--leave-text);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI",
                Roboto, Arial, sans-serif;
        }

        button,
        input,
        select,
        textarea {
            font: inherit;
        }

        .leave-page {
            width: 100%;
            max-width: 1440px;
            margin: 0 auto;
            padding: 30px 36px 45px;
        }

        .page-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 20px;
            margin-bottom: 26px;
        }

        .breadcrumb {
            margin: 0 0 10px;
            color: var(--leave-muted);
            font-size: 13px;
        }

        .breadcrumb a {
            color: var(--leave-primary);
            text-decoration: none;
        }

        .page-title {
            margin: 0;
            font-size: clamp(25px, 3vw, 32px);
            font-weight: 750;
            letter-spacing: -0.8px;
        }

        .page-subtitle {
            margin: 9px 0 0;
            color: var(--leave-muted);
            font-size: 14px;
            line-height: 1.6;
        }

        .header-tag {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 14px;
            border: 1px solid #dbeafe;
            border-radius: 10px;
            background: #eff6ff;
            color: #1d4ed8;
            font-size: 13px;
            font-weight: 650;
        }

        .header-tag span {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #2563eb;
        }

        .overview-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 18px;
            margin-bottom: 24px;
        }

        .overview-card {
            display: flex;
            align-items: center;
            gap: 15px;
            min-width: 0;
            padding: 21px;
            background: #fff;
            border: 1px solid var(--leave-border);
            border-radius: 15px;
            box-shadow: 0 3px 12px rgb(15 23 42 / 3%);
        }

        .overview-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            flex: 0 0 48px;
            width: 48px;
            height: 48px;
            border-radius: 13px;
            background: #eff6ff;
            color: var(--leave-primary);
            font-size: 23px;
        }

        .overview-icon.green {
            background: #f0fdf4;
            color: #15803d;
        }

        .overview-icon.orange {
            background: #fff7ed;
            color: #c2410c;
        }

        .overview-label {
            margin: 0 0 6px;
            color: var(--leave-muted);
            font-size: 13px;
        }

        .overview-value {
            margin: 0;
            font-size: 25px;
            font-weight: 750;
            letter-spacing: -0.5px;
        }

        .panel {
            margin-bottom: 24px;
            overflow: hidden;
            background: #fff;
            border: 1px solid var(--leave-border);
            border-radius: 16px;
            box-shadow: 0 3px 12px rgb(15 23 42 / 3%);
        }

        .panel-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 16px;
            padding: 23px 25px;
            border-bottom: 1px solid var(--leave-border);
        }

        .panel-title {
            margin: 0;
            font-size: 17px;
            font-weight: 750;
        }

        .panel-description {
            margin: 7px 0 0;
            color: var(--leave-muted);
            font-size: 13px;
            line-height: 1.6;
        }

        .panel-body {
            padding: 25px;
        }

        .section-number {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 29px;
            height: 29px;
            margin-right: 9px;
            border-radius: 9px;
            background: #eff6ff;
            color: var(--leave-primary);
            font-size: 13px;
            font-weight: 750;
            vertical-align: middle;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 22px;
        }

        .field {
            display: flex;
            flex-direction: column;
            gap: 8px;
            min-width: 0;
        }

        .field.full {
            grid-column: 1 / -1;
        }

        .field label {
            color: #344054;
            font-size: 13px;
            font-weight: 650;
        }

        .required {
            color: #dc2626;
        }

        .field input,
        .field select,
        .field textarea {
            width: 100%;
            min-height: 45px;
            padding: 11px 13px;
            outline: none;
            border: 1px solid #d7deea;
            border-radius: 9px;
            background: #fff;
            color: var(--leave-text);
            font-size: 14px;
            transition: border-color .2s, box-shadow .2s;
        }

        .field textarea {
            min-height: 100px;
            resize: vertical;
        }

        .field input:focus,
        .field select:focus,
        .field textarea:focus {
            border-color: var(--leave-primary);
            box-shadow: 0 0 0 3px rgb(37 99 235 / 10%);
        }

        .field input::placeholder,
        .field textarea::placeholder {
            color: #98a2b3;
        }

        .field-help {
            margin: 0;
            color: var(--leave-muted);
            font-size: 12px;
            line-height: 1.5;
        }

        .form-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 15px;
            margin-top: 25px;
            padding-top: 22px;
            border-top: 1px solid var(--leave-border);
        }

        .form-note {
            max-width: 550px;
            margin: 0;
            color: var(--leave-muted);
            font-size: 12px;
            line-height: 1.6;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            min-height: 42px;
            padding: 11px 17px;
            border: 1px solid transparent;
            border-radius: 9px;
            font-size: 13px;
            font-weight: 700;
            text-decoration: none;
            cursor: pointer;
            transition: background .2s, border-color .2s;
        }

        .btn-primary {
            background: var(--leave-primary);
            color: #fff;
        }

        .btn-primary:hover {
            background: var(--leave-primary-dark);
        }

        .btn:disabled {
            opacity: .65;
            cursor: not-allowed;
        }

        .search-box {
            position: relative;
            width: min(100%, 280px);
        }

        .search-box input {
            width: 100%;
            min-height: 41px;
            padding: 10px 12px 10px 36px;
            border: 1px solid #d7deea;
            border-radius: 9px;
            outline: none;
            font-size: 13px;
        }

        .search-box input:focus {
            border-color: var(--leave-primary);
        }

        .search-symbol {
            position: absolute;
            top: 50%;
            left: 12px;
            transform: translateY(-50%);
            color: #94a3b8;
        }

        .table-scroll {
            width: 100%;
            overflow-x: auto;
        }

        .leave-table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
            white-space: nowrap;
        }

        .leave-table th {
            padding: 15px 22px;
            background: #f8fafc;
            border-bottom: 1px solid var(--leave-border);
            color: #64748b;
            font-size: 11px;
            font-weight: 750;
            letter-spacing: .55px;
            text-transform: uppercase;
        }

        .leave-table td {
            padding: 17px 22px;
            border-bottom: 1px solid #edf0f5;
            font-size: 13px;
            vertical-align: middle;
        }

        .leave-table tbody tr:last-child td {
            border-bottom: none;
        }

        .leave-table tbody tr:hover {
            background: #fbfdff;
        }

        .leave-name {
            color: #172033;
            font-weight: 700;
        }

        .code-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 42px;
            padding: 6px 9px;
            border: 1px solid #e2e8f0;
            border-radius: 7px;
            background: #f8fafc;
            color: #475569;
            font-size: 12px;
            font-weight: 750;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 6px 10px;
            border-radius: 30px;
            font-size: 11px;
            font-weight: 750;
        }

        .status-badge::before {
            content: "";
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: currentColor;
        }

        .status-active {
            background: #ecfdf3;
            color: #15803d;
        }

        .status-inactive {
            background: #fef2f2;
            color: #b91c1c;
        }

        .paid-label {
            color: #15803d;
            font-weight: 650;
        }

        .unpaid-label {
            color: #b45309;
            font-weight: 650;
        }

        .action-form {
            display: inline;
            margin: 0;
        }

        .btn-disable {
            min-height: 33px;
            padding: 7px 11px;
            border: 1px solid #fecaca;
            border-radius: 7px;
            background: #fff;
            color: #b91c1c;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
        }

        .btn-disable:hover {
            background: #fef2f2;
        }

        .disabled-text {
            color: #94a3b8;
            font-size: 12px;
            font-weight: 600;
        }

        .empty-state {
            padding: 48px 20px;
            text-align: center;
        }

        .empty-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 58px;
            height: 58px;
            margin: 0 auto 15px;
            border-radius: 16px;
            background: #eff6ff;
            color: #2563eb;
            font-size: 26px;
        }

        .empty-state h3 {
            margin: 0 0 8px;
            font-size: 16px;
        }

        .empty-state p {
            margin: 0;
            color: var(--leave-muted);
            font-size: 13px;
            line-height: 1.6;
        }

        .empty-search {
            display: none;
            padding: 30px;
            color: var(--leave-muted);
            text-align: center;
            font-size: 13px;
        }

        .alert {
            margin-bottom: 20px;
            padding: 13px 16px;
            border: 1px solid;
            border-radius: 10px;
            font-size: 13px;
            line-height: 1.6;
        }

        .alert-success {
            border-color: #bbf7d0;
            background: #f0fdf4;
            color: #166534;
        }

        .alert-error {
            border-color: #fecaca;
            background: #fef2f2;
            color: #991b1b;
        }

        .footer-note {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            padding: 16px 18px;
            border: 1px solid #dbeafe;
            border-radius: 12px;
            background: #eff6ff;
            color: #1e40af;
            font-size: 12px;
            line-height: 1.7;
        }

        @media (max-width: 900px) {
            .leave-page {
                padding: 24px 20px 35px;
            }

            .overview-grid {
                gap: 12px;
            }

            .overview-card {
                padding: 16px;
            }

            .overview-icon {
                flex-basis: 40px;
                width: 40px;
                height: 40px;
            }

            .panel-header,
            .panel-body {
                padding: 20px;
            }
        }

        @media (max-width: 650px) {
            .leave-page {
                padding: 20px 14px 30px;
            }

            .overview-grid {
                grid-template-columns: 1fr;
                gap: 10px;
            }

            .overview-card {
                padding: 15px;
            }

            .overview-value {
                font-size: 22px;
            }

            .form-grid {
                grid-template-columns: 1fr;
                gap: 18px;
            }

            .field.full {
                grid-column: auto;
            }

            .panel-header {
                flex-direction: column;
                padding: 18px;
            }

            .panel-body {
                padding: 18px;
            }

            .form-footer {
                align-items: stretch;
                flex-direction: column;
            }

            .form-footer .btn {
                width: 100%;
            }

            .search-box {
                width: 100%;
            }

            .page-header {
                align-items: flex-start;
                flex-direction: column;
            }
        }
    </style>
</head>

<body>

<main class="leave-page">

    <header class="page-header">
        <div>
            <p class="breadcrumb">
                <a href="/dashboard">Dashboard</a>
                / Leave Management
                / <strong>Leave Types</strong>
            </p>

            <h1 class="page-title">Leave Types</h1>

            <p class="page-subtitle">
                Configure and manage the leave policies available to your organization.
            </p>
        </div>

        <div class="header-tag">
            <span></span>
            Leave Policy Configuration
        </div>
    </header>

    <% const types = Array.isArray(leaveTypes) ? leaveTypes : []; %>
    <% const activeCount = types.filter(type => type.isActive).length; %>
    <% const inactiveCount = types.length - activeCount; %>
    <% const paidCount = types.filter(type => type.isPaid).length; %>

    <% if (typeof success !== "undefined" && success) { %>
        <div class="alert alert-success" role="status">
            <%= success %>
        </div>
    <% } %>

    <% if (typeof error !== "undefined" && error) { %>
        <div class="alert alert-error" role="alert">
            <%= error %>
        </div>
    <% } %>

    <section class="overview-grid" aria-label="Leave type summary">

        <article class="overview-card">
            <div class="overview-icon">▤</div>
            <div>
                <p class="overview-label">Total Leave Types</p>
                <p class="overview-value"><%= types.length %></p>
            </div>
        </article>

        <article class="overview-card">
            <div class="overview-icon green">✓</div>
            <div>
                <p class="overview-label">Active Policies</p>
                <p class="overview-value"><%= activeCount %></p>
            </div>
        </article>

        <article class="overview-card">
            <div class="overview-icon orange">₹</div>
            <div>
                <p class="overview-label">Paid Leave Types</p>
                <p class="overview-value"><%= paidCount %></p>
            </div>
        </article>

    </section>

    <section class="panel">

        <div class="panel-header">
            <div>
                <h2 class="panel-title">
                    <span class="section-number">01</span>
                    Add Leave Type
                </h2>

                <p class="panel-description">
                    Create a leave category and define its default annual allowance.
                </p>
            </div>
        </div>

        <div class="panel-body">

            <form
                id="createLeaveTypeForm"
                method="POST"
                action="/leave/admin/types"
            >

                <div class="form-grid">

                    <div class="field">
                        <label for="name">
                            Leave Name <span class="required">*</span>
                        </label>

                        <input
                            id="name"
                            type="text"
                            name="name"
                            placeholder="e.g. Casual Leave"
                            maxlength="100"
                            autocomplete="off"
                            required
                        >

                        <p class="field-help">
                            Use a clear name employees can understand.
                        </p>
                    </div>

                    <div class="field">
                        <label for="code">
                            Leave Code <span class="required">*</span>
                        </label>

                        <input
                            id="code"
                            type="text"
                            name="code"
                            placeholder="e.g. CL"
                            maxlength="15"
                            pattern="[A-Za-z0-9_-]+"
                            title="Use letters, numbers, hyphens or underscores."
                            autocomplete="off"
                            required
                        >

                        <p class="field-help">
                            A short unique identifier for this policy.
                        </p>
                    </div>

                    <div class="field">
                        <label for="defaultDays">
                            Default Annual Days
                        </label>

                        <input
                            id="defaultDays"
                            type="number"
                            name="defaultDays"
                            min="0"
                            max="365"
                            step="0.5"
                            value="0"
                        >

                        <p class="field-help">
                            Default allowance per employee for the year.
                        </p>
                    </div>

                    <div class="field">
                        <label for="isPaid">
                            Payment Category <span class="required">*</span>
                        </label>

                        <select id="isPaid" name="isPaid" required>
                            <option value="true">Paid Leave</option>
                            <option value="false">Unpaid Leave</option>
                        </select>

                        <p class="field-help">
                            Select whether the leave is paid or unpaid.
                        </p>
                    </div>

                    <div class="field full">
                        <label for="description">Description</label>

                        <textarea
                            id="description"
                            name="description"
                            maxlength="1000"
                            placeholder="Explain when employees can use this leave and any applicable policy rules..."
                        ></textarea>
                    </div>

                </div>

                <div class="form-footer">
                    <p class="form-note">
                        <strong>Note:</strong>
                        Make sure the leave code is unique within your organization.
                        Allowance and policy changes should follow your HR guidelines.
                    </p>

                    <button
                        class="btn btn-primary"
                        id="createLeaveTypeButton"
                        type="submit"
                    >
                        <span aria-hidden="true">+</span>
                        Create Leave Type
                    </button>
                </div>

            </form>

        </div>
    </section>

    <section class="panel">

        <div class="panel-header">
            <div>
                <h2 class="panel-title">
                    <span class="section-number">02</span>
                    Existing Leave Types
                </h2>

                <p class="panel-description">
                    View configured policies and check their current status.
                </p>
            </div>

            <div class="search-box">
                <span class="search-symbol" aria-hidden="true">⌕</span>
                <input
                    type="search"
                    id="leaveTypeSearch"
                    placeholder="Search leave types..."
                    aria-label="Search leave types"
                >
            </div>
        </div>

        <% if (types.length > 0) { %>

            <div class="table-scroll">
                <table class="leave-table">
                    <thead>
                        <tr>
                            <th>Leave Type</th>
                            <th>Code</th>
                            <th>Annual Days</th>
                            <th>Payment</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody id="leaveTypesTableBody">

                        <% types.forEach(type => { %>

                            <tr class="leave-type-row">

                                <td>
                                    <span class="leave-name">
                                        <%= type.name %>
                                    </span>
                                </td>

                                <td>
                                    <span class="code-badge">
                                        <%= type.code %>
                                    </span>
                                </td>

                                <td>
                                    <strong>
                                        <%= type.defaultDays ?? 0 %>
                                    </strong>
                                    <span style="color:#64748b;">days</span>
                                </td>

                                <td>
                                    <% if (type.isPaid) { %>
                                        <span class="paid-label">Paid</span>
                                    <% } else { %>
                                        <span class="unpaid-label">Unpaid</span>
                                    <% } %>
                                </td>

                                <td>
                                    <% if (type.isActive) { %>
                                        <span class="status-badge status-active">
                                            Active
                                        </span>
                                    <% } else { %>
                                        <span class="status-badge status-inactive">
                                            Inactive
                                        </span>
                                    <% } %>
                                </td>

                                <td>
                                    <% if (type.isActive) { %>

                                        <form
                                            class="action-form disable-leave-form"
                                            method="POST"
                                            action="/leave/admin/types/disable/<%= type._id %>"
                                        >
                                            <button
                                                class="btn-disable"
                                                type="submit"
                                            >
                                                Disable
                                            </button>
                                        </form>

                                    <% } else { %>

                                        <span class="disabled-text">
                                            Disabled
                                        </span>

                                    <% } %>
                                </td>

                            </tr>

                        <% }) %>

                    </tbody>
                </table>
            </div>

            <div class="empty-search" id="emptySearchMessage">
                No leave types match your search.
            </div>

        <% } else { %>

            <div class="empty-state">
                <div class="empty-icon" aria-hidden="true">▤</div>

                <h3>No leave types configured</h3>

                <p>
                    Create your first leave type using the form above.
                    Once created, it will appear here.
                </p>
            </div>

        <% } %>

    </section>

    <div class="footer-note">
        <span aria-hidden="true">ⓘ</span>
        <div>
            <strong>HR policy reminder</strong><br>
            Disabling a leave type should prevent it from being selected for
            new leave requests. Confirm that your backend enforces this rule
            and preserves historical leave records.
        </div>
    </div>

</main>

<script>
    (() => {
        const searchInput = document.getElementById("leaveTypeSearch");
        const tableBody = document.getElementById("leaveTypesTableBody");
        const emptySearchMessage = document.getElementById("emptySearchMessage");

        if (searchInput && tableBody) {
            searchInput.addEventListener("input", () => {
                const query = searchInput.value.trim().toLowerCase();
                const rows = tableBody.querySelectorAll(".leave-type-row");
                let visibleCount = 0;

                rows.forEach((row) => {
                    const matches = row.textContent.toLowerCase().includes(query);

                    row.style.display = matches ? "" : "none";

                    if (matches) visibleCount++;
                });

                if (emptySearchMessage) {
                    emptySearchMessage.style.display =
                        visibleCount === 0 ? "block" : "none";
                }
            });
        }

        document.querySelectorAll(".disable-leave-form").forEach((form) => {
            form.addEventListener("submit", (event) => {
                const confirmed = window.confirm(
                    "Are you sure you want to disable this leave type? " +
                    "Employees may no longer be able to select it for new requests."
                );

                if (!confirmed) {
                    event.preventDefault();
                }
            });
        });

        const createForm = document.getElementById("createLeaveTypeForm");
        const createButton = document.getElementById("createLeaveTypeButton");

        if (createForm && createButton) {
            createForm.addEventListener("submit", () => {
                if (!createForm.checkValidity()) return;

                createButton.disabled = true;
                createButton.textContent = "Creating...";
            });
        }

        const codeInput = document.getElementById("code");

        if (codeInput) {
            codeInput.addEventListener("input", () => {
                codeInput.value = codeInput.value.toUpperCase();
            });
        }
    })();
</script>

</body>
</html>