<style>

    /* =====================================================
       LEAVE PAGE
    ===================================================== */

    .leave-page {
        padding: 30px;
    }


    .page-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 25px;
    }


    .page-heading h1 {
        margin: 0;
        font-size: 22px;
        font-weight: 600;
        color: #111827;
    }


    .page-heading p {
        color: #9ca3af;
        font-size: 11px;
        margin: 6px 0 0;
    }


    /* =====================================================
       PRIMARY BUTTON
    ===================================================== */

    .primary-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;

        background: #111827;
        color: #ffffff;

        text-decoration: none;

        padding: 9px 14px;

        border-radius: 7px;

        font-size: 11px;
        font-weight: 500;

        white-space: nowrap;

        transition:
            background .15s ease,
            transform .15s ease;
    }


    .primary-button:hover {
        background: #000000;
        transform: translateY(-1px);
    }


    /* =====================================================
       SUMMARY
    ===================================================== */

    .summary-grid {
        display: grid;

        grid-template-columns:
            repeat(4, minmax(0, 1fr));

        gap: 15px;

        margin-bottom: 20px;
    }


    .summary-card {
        background: #ffffff;

        border: 1px solid #e5e7eb;

        border-radius: 10px;

        padding: 18px;

        transition:
            box-shadow .2s ease,
            transform .2s ease;
    }


    .summary-card:hover {
        box-shadow:
            0 5px 18px rgba(0, 0, 0, .05);

        transform: translateY(-1px);
    }


    .summary-label {
        color: #9ca3af;

        font-size: 9px;

        font-weight: 600;

        text-transform: uppercase;

        letter-spacing: .04em;
    }


    .summary-value {
        font-size: 23px;

        font-weight: 600;

        margin-top: 8px;

        color: #111827;
    }


    .summary-description {
        color: #9ca3af;

        font-size: 10px;

        margin-top: 5px;
    }


    /* =====================================================
       CONTENT CARD
    ===================================================== */

    .content-card {
        background: #ffffff;

        border: 1px solid #e5e7eb;

        border-radius: 12px;

        overflow: hidden;

        margin-bottom: 20px;
    }


    .card-header {
        display: flex;

        justify-content: space-between;

        align-items: center;

        gap: 15px;

        padding: 18px 20px;

        border-bottom:
            1px solid #f0f1f3;
    }


    .card-header h3 {
        margin: 0;

        font-size: 14px;

        font-weight: 600;

        color: #111827;
    }


    .card-header span {
        color: #9ca3af;

        font-size: 10px;
    }


    /* =====================================================
       TABLE
    ===================================================== */

    .table-wrapper {
        width: 100%;

        overflow-x: auto;
    }


    table {
        width: 100%;

        min-width: 850px;

        border-collapse: collapse;
    }


    th {
        text-align: left;

        padding: 12px 18px;

        background: #fafafa;

        color: #9ca3af;

        font-size: 9px;

        font-weight: 600;

        letter-spacing: .03em;

        white-space: nowrap;
    }


    td {
        padding: 13px 18px;

        border-top:
            1px solid #f0f1f3;

        font-size: 11px;

        color: #374151;

        vertical-align: middle;
    }


    tbody tr {
        transition:
            background .15s ease;
    }


    tbody tr:hover {
        background: #fafafa;
    }


    /* =====================================================
       LEAVE TYPE / EMPLOYEE INFO
    ===================================================== */

    .employee-name {
        font-weight: 600;

        color: #111827;

        white-space: nowrap;
    }


    .employee-email {
        color: #9ca3af;

        font-size: 9px;

        margin-top: 3px;
    }


    .reason-text {
        max-width: 220px;

        overflow: hidden;

        text-overflow: ellipsis;

        white-space: nowrap;

        color: #4b5563;
    }


    /* =====================================================
       STATUS
    ===================================================== */

    .status {
        display: inline-flex;

        align-items: center;

        gap: 5px;

        padding: 5px 9px;

        border-radius: 20px;

        font-size: 9px;

        font-weight: 600;

        white-space: nowrap;
    }


    .status::before {
        content: "";

        width: 5px;

        height: 5px;

        border-radius: 50%;

        background: currentColor;
    }


    .status-pending {
        background: #fff7ed;

        color: #c2410c;
    }


    .status-approved {
        background: #ecfdf5;

        color: #047857;
    }


    .status-rejected {
        background: #fef2f2;

        color: #b91c1c;
    }


    .status-cancelled {
        background: #f3f4f6;

        color: #6b7280;
    }


    /* =====================================================
       ACTIONS
    ===================================================== */

    .action-group {
        display: flex;

        align-items: center;

        gap: 8px;
    }


    .action-link {
        border: 0;

        background: transparent;

        padding: 0;

        color: #374151;

        text-decoration: none;

        font-size: 10px;

        cursor: pointer;
    }


    .action-link:hover {
        color: #111827;

        text-decoration: underline;
    }


    .action-disabled {
        color: #d1d5db;

        font-size: 10px;
    }


    /* =====================================================
       EMPTY
    ===================================================== */

    .empty {
        text-align: center;

        padding: 55px 20px;

        color: #9ca3af;
    }


    .empty-icon {
        font-size: 28px;

        margin-bottom: 10px;

        opacity: .55;
    }


    .empty h3 {
        color: #4b5563;

        font-size: 13px;

        font-weight: 600;

        margin: 0 0 5px;
    }


    .empty p {
        font-size: 10px;

        margin: 0;

        color: #9ca3af;
    }


    /* =====================================================
       LEAVE TYPES
    ===================================================== */

    .leave-type-list {
        display: grid;

        grid-template-columns:
            repeat(3, minmax(0, 1fr));

        gap: 15px;

        padding: 20px;
    }


    .leave-type-card {
        border: 1px solid #e5e7eb;

        border-radius: 9px;

        padding: 15px;

        transition:
            border-color .15s ease,
            box-shadow .15s ease;
    }


    .leave-type-card:hover {
        border-color: #d1d5db;

        box-shadow:
            0 3px 12px
            rgba(0, 0, 0, .04);
    }


    .leave-type-card strong {
        display: block;

        font-size: 12px;

        color: #111827;
    }


    .leave-type-card small {
        display: block;

        color: #9ca3af;

        font-size: 9px;

        margin-top: 4px;
    }


    .leave-limit {
        margin-top: 12px;

        font-size: 10px;

        color: #6b7280;
    }


    .leave-limit strong {
        display: inline;

        font-size: 11px;

        color: #111827;
    }


    /* =====================================================
       BALANCE
    ===================================================== */

    .balance-list {
        display: grid;

        grid-template-columns:
            repeat(3, minmax(0, 1fr));

        gap: 15px;

        padding: 20px;
    }


    .balance-card {
        border: 1px solid #e5e7eb;

        border-radius: 9px;

        padding: 16px;

        transition:
            border-color .15s ease,
            box-shadow .15s ease;
    }


    .balance-card:hover {
        border-color: #d1d5db;

        box-shadow:
            0 3px 12px
            rgba(0, 0, 0, .04);
    }


    .balance-title {
        font-size: 12px;

        font-weight: 600;

        color: #111827;
    }


    .balance-code {
        font-size: 9px;

        color: #9ca3af;

        margin-top: 3px;
    }


    .balance-number {
        font-size: 23px;

        font-weight: 600;

        margin-top: 12px;

        color: #111827;
    }


    .balance-info {
        font-size: 9px;

        color: #6b7280;

        margin-top: 5px;
    }


    /* =====================================================
       RESPONSIVE
    ===================================================== */

    @media (max-width: 1100px) {

        .summary-grid {
            grid-template-columns:
                repeat(2, minmax(0, 1fr));
        }


        .leave-type-list,
        .balance-list {
            grid-template-columns:
                repeat(2, minmax(0, 1fr));
        }

    }


    @media (max-width: 750px) {

        .leave-page {
            padding: 20px;
        }


        .page-heading {
            align-items: flex-start;

            flex-direction: column;

            gap: 15px;
        }


        .summary-grid {
            grid-template-columns: 1fr;
        }


        .leave-type-list,
        .balance-list {
            grid-template-columns: 1fr;

            padding: 15px;
        }


        .primary-button {
            width: 100%;
        }

    }


    @media (max-width: 480px) {

        .leave-page {
            padding: 15px;
        }


        .card-header {
            align-items: flex-start;

            flex-direction: column;
        }

    }

</style>

<%- include('../partials/navbar') %>
<section class="leave-page">


    <!-- =====================================================
         PAGE HEADING
    ===================================================== -->

    <div class="page-heading">

        <div>

            <h1>
                Leave Management
            </h1>

            <p>
                Manage your leave requests,
                balances and leave policies.
            </p>

        </div>


        <a
            href="/leave/apply"
            class="primary-button"
        >
            + Apply Leave
        </a>

    </div>


    <!-- =====================================================
         SUMMARY
    ===================================================== -->

    <div class="summary-grid">


        <div class="summary-card">

            <div class="summary-label">
                Pending Requests
            </div>

            <div class="summary-value">
                <%= summary?.pending || 0 %>
            </div>

            <div class="summary-description">
                Waiting for approval
            </div>

        </div>


        <div class="summary-card">

            <div class="summary-label">
                Approved
            </div>

            <div class="summary-value">
                <%= summary?.approved || 0 %>
            </div>

            <div class="summary-description">
                Approved requests
            </div>

        </div>


        <div class="summary-card">

            <div class="summary-label">
                Rejected
            </div>

            <div class="summary-value">
                <%= summary?.rejected || 0 %>
            </div>

            <div class="summary-description">
                Rejected requests
            </div>

        </div>


        <div class="summary-card">

            <div class="summary-label">
                Total Requests
            </div>

            <div class="summary-value">
                <%= summary?.total || 0 %>
            </div>

            <div class="summary-description">
                All your requests
            </div>

        </div>


    </div>


    <!-- =====================================================
         MY LEAVE REQUESTS
    ===================================================== -->

    <div class="content-card">


        <div class="card-header">

            <div>

                <h3>
                    My Leave Requests
                </h3>

            </div>

            <span>
                Latest requests
            </span>

        </div>


        <% if (
            !requests ||
            requests.length === 0
        ) { %>


            <div class="empty">

                <div class="empty-icon">
                    ▣
                </div>

                <h3>
                    No leave requests found
                </h3>

                <p>
                    Your leave requests will appear here.
                </p>

            </div>


        <% } else { %>


            <div class="table-wrapper">

                <table>

                    <thead>

                        <tr>

                            <th>
                                Leave Type
                            </th>

                            <th>
                                From
                            </th>

                            <th>
                                To
                            </th>

                            <th>
                                Days
                            </th>

                            <th>
                                Reason
                            </th>

                            <th>
                                Status
                            </th>

                            <th>
                                Action
                            </th>

                        </tr>

                    </thead>


                    <tbody>


                    <% requests.forEach(request => {

                        const requestStatus =
                            String(
                                request?.status ||
                                "Pending"
                            ).toLowerCase();

                    %>


                        <tr>


                            <!-- LEAVE TYPE -->

                            <td>

                                <div class="employee-name">

                                    <%= request?.leaveType?.name || "-" %>

                                </div>


                                <div class="employee-email">

                                    <%= request?.leaveType?.code || "" %>


                                    <% if (
                                        request?.leaveType?.isPaid !== undefined
                                    ) { %>

                                        ·

                                        <%= request.leaveType.isPaid
                                            ? "Paid"
                                            : "Unpaid"
                                        %>

                                    <% } %>

                                </div>

                            </td>


                            <!-- FROM -->

                            <td>

                                <%= request?.fromDate
                                    ? new Date(
                                        request.fromDate
                                    ).toLocaleDateString("en-IN")
                                    : "-"
                                %>

                            </td>


                            <!-- TO -->

                            <td>

                                <%= request?.toDate
                                    ? new Date(
                                        request.toDate
                                    ).toLocaleDateString("en-IN")
                                    : "-"
                                %>

                            </td>


                            <!-- DAYS -->

                            <td>

                                <%= request?.totalDays || 0 %>

                            </td>


                            <!-- REASON -->

                            <td>

                                <div class="reason-text"
                                     title="<%= request?.reason || '-' %>">

                                    <%= request?.reason || "-" %>

                                </div>

                            </td>


                            <!-- STATUS -->

                            <td>


                                <% if (
                                    requestStatus ===
                                    "approved"
                                ) { %>

                                    <span class="status status-approved">
                                        Approved
                                    </span>


                                <% } else if (
                                    requestStatus ===
                                    "rejected"
                                ) { %>

                                    <span class="status status-rejected">
                                        Rejected
                                    </span>


                                <% } else if (
                                    requestStatus ===
                                    "cancelled"
                                ) { %>

                                    <span class="status status-cancelled">
                                        Cancelled
                                    </span>


                                <% } else { %>

                                    <span class="status status-pending">
                                        Pending
                                    </span>

                                <% } %>


                            </td>


                            <!-- ACTION -->

                            <td>


                                <% if (
                                    requestStatus ===
                                    "pending"
                                ) { %>


                                    <form
                                        action="/leave/cancel/<%= request._id %>"
                                        method="POST"
                                        style="display:inline;"
                                        onsubmit="return confirm('Are you sure you want to cancel this leave request?');"
                                    >

                                        <button
                                            type="submit"
                                            class="action-link"
                                        >
                                            Cancel
                                        </button>

                                    </form>


                                <% } else { %>


                                    <span class="action-disabled">
                                        —
                                    </span>


                                <% } %>


                            </td>


                        </tr>


                    <% }) %>


                    </tbody>

                </table>

            </div>


        <% } %>


    </div>


    <!-- =====================================================
         LEAVE BALANCES
    ===================================================== -->

    <div class="content-card">


        <div class="card-header">

            <h3>
                Leave Balance
            </h3>

            <span>
                <%= currentYear || new Date().getFullYear() %>
            </span>

        </div>


        <% if (
            !balances ||
            balances.length === 0
        ) { %>


            <div class="empty">

                <div class="empty-icon">
                    ◷
                </div>

                <h3>
                    No leave balance available
                </h3>

                <p>
                    Leave balances have not been configured
                    for your employee profile.
                </p>

            </div>


        <% } else { %>


            <div class="balance-list">


                <% balances.forEach(balance => {

                    const allocated =
                        Number(
                            balance?.allocated || 0
                        );

                    const carriedForward =
                        Number(
                            balance?.carriedForward || 0
                        );

                    const used =
                        Number(
                            balance?.used || 0
                        );

                    const adjustment =
                        Number(
                            balance?.adjustment || 0
                        );

                    const available =
                        allocated +
                        carriedForward +
                        adjustment -
                        used;

                %>


                    <div class="balance-card">


                        <div class="balance-title">

                            <%= balance?.leaveType?.name || "Leave" %>

                        </div>


                        <div class="balance-code">

                            <%= balance?.leaveType?.code || "" %>

                        </div>


                        <div class="balance-number">

                            <%= Math.max(
                                available,
                                0
                            ) %>

                            days

                        </div>


                        <div class="balance-info">

                            Allocated:
                            <%= allocated %>

                            · Used:
                            <%= used %>


                            <% if (
                                carriedForward
                            ) { %>

                                · Carried:
                                <%= carriedForward %>

                            <% } %>


                            <% if (
                                adjustment
                            ) { %>

                                · Adjustment:
                                <%= adjustment %>

                            <% } %>

                        </div>


                    </div>


                <% }) %>


            </div>


        <% } %>


    </div>


    <!-- =====================================================
         LEAVE TYPES
    ===================================================== -->

    <div class="content-card">


        <div class="card-header">

            <h3>
                Leave Types
            </h3>

            <span>
                Active leave policies
            </span>

        </div>


        <% if (
            !leaveTypes ||
            leaveTypes.length === 0
        ) { %>


            <div class="empty">

                <div class="empty-icon">
                    ▣
                </div>

                <h3>
                    No leave types configured
                </h3>

                <p>
                    Configure leave types before employees
                    can apply for leave.
                </p>

            </div>


        <% } else { %>


            <div class="leave-type-list">


                <% leaveTypes.forEach(leaveType => { %>


                    <div class="leave-type-card">


                        <strong>
                            <%= leaveType?.name || "Leave Type" %>
                        </strong>


                        <small>

                            <%= leaveType?.code || "" %>


                            <% if (
                                leaveType?.isPaid !== undefined
                            ) { %>

                                ·

                                <%= leaveType.isPaid
                                    ? "Paid"
                                    : "Unpaid"
                                %>

                            <% } %>

                        </small>


                        <div class="leave-limit">

                            Annual Limit:

                            <strong>

                                <%= leaveType?.annualLimit || 0 %>

                            </strong>

                            days

                        </div>


                    </div>


                <% }) %>


            </div>


        <% } %>


    </div>


</section>