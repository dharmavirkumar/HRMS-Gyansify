<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || "Employee Onboarding" %> - Gyansify HRMS</title>
    <link rel="stylesheet" href="/css/dashboard.css">
    <style>
        .onboarding-page{padding:24px;max-width:1500px;margin:auto}
        .page-heading{display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;margin-bottom:24px}
        .page-heading h1{margin:0;font-size:27px;font-weight:750}
        .muted{color:#64748b;font-size:14px;margin-top:6px}
        .primary-btn{display:inline-flex;align-items:center;justify-content:center;padding:11px 17px;border-radius:9px;background:#2563eb;color:#fff;text-decoration:none;font-weight:650;border:0;cursor:pointer}
        .primary-btn:hover{background:#1d4ed8}
        .stats-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;margin-bottom:24px}
        .stat-card,.table-card{background:#fff;border:1px solid #e5e7eb;border-radius:14px;padding:20px}
        .stat-label{color:#64748b;font-size:14px}
        .stat-value{font-size:29px;font-weight:750;margin-top:9px;color:#0f172a}
        .table-card{padding:0;overflow:hidden}
        .table-heading{padding:20px;border-bottom:1px solid #e5e7eb;font-weight:700}
        .table-wrap{overflow-x:auto}
        table{width:100%;border-collapse:collapse;min-width:760px}
        th,td{text-align:left;padding:15px 20px;border-bottom:1px solid #eef2f7;font-size:14px}
        th{background:#f8fafc;color:#64748b;font-weight:650}
        td{color:#334155}
        .person-name{font-weight:650;color:#0f172a}
        .status{display:inline-block;padding:5px 10px;border-radius:20px;font-size:12px;font-weight:700;background:#f1f5f9;color:#475569}
        .status-DRAFT{background:#f1f5f9;color:#475569}
        .status-IN_PROGRESS{background:#dbeafe;color:#1d4ed8}
        .status-PENDING_APPROVAL{background:#fef3c7;color:#92400e}
        .status-APPROVED{background:#dcfce7;color:#166534}
        .status-REJECTED{background:#fee2e2;color:#b91c1c}
        .status-COMPLETED{background:#d1fae5;color:#065f46}
        .status-CANCELLED{background:#e5e7eb;color:#4b5563}
        .view-link{color:#2563eb;text-decoration:none;font-weight:650}
        .empty-state{text-align:center;padding:50px 20px;color:#64748b}
        @media(max-width:700px){.onboarding-page{padding:15px}.stats-grid{grid-template-columns:1fr}.page-heading h1{font-size:23px}}
    </style>
</head>
<body>
    <%- include("../partials/navbar") %>
<main class="onboarding-page">
    <div class="page-heading">
        <div>
            <h1>Employee Onboarding</h1>
            <p class="muted">Manage new hires, joining formalities and onboarding tasks.</p>
        </div>
        <a href="/onboarding/create" class="primary-btn">+ Start Onboarding</a>
    </div>

    <section class="stats-grid">
        <div class="stat-card">
            <div class="stat-label">Total Onboardings</div>
            <div class="stat-value"><%= stats?.total ?? 0 %></div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Pending / In Progress</div>
            <div class="stat-value"><%= stats?.pending ?? 0 %></div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Completed</div>
            <div class="stat-value"><%= stats?.completed ?? 0 %></div>
        </div>
    </section>

    <section class="table-card">
        <div class="table-heading">Recent Onboarding Records</div>
        <% if (onboardings && onboardings.length) { %>
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Employee</th>
                            <th>Email</th>
                            <th>Joining Date</th>
                            <th>Employment Type</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                    <% onboardings.forEach(function(item) {
                        const fullName = [item.firstName, item.lastName].filter(Boolean).join(" ") || "Unnamed employee";
                        const joiningDate = item.joiningDate
                            ? new Date(item.joiningDate).toLocaleDateString("en-IN", {day:"2-digit",month:"short",year:"numeric"})
                            : "—";
                    %>
                        <tr>
                            <td><div class="person-name"><%= fullName %></div></td>
                            <td><%= item.email || "—" %></td>
                            <td><%= joiningDate %></td>
                            <td><%= item.employmentType || "—" %></td>
                            <td>
                                <span class="status status-<%= item.status %>">
                                    <%= String(item.status || "DRAFT").replaceAll("_", " ") %>
                                </span>
                            </td>
                            <td><a class="view-link" href="/onboarding/<%= item._id %>">View details →</a></td>
                        </tr>
                    <% }); %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div class="empty-state">
                <h3>No onboarding records yet</h3>
                <p>Start onboarding a new employee to track joining formalities.</p>
                <a href="/onboarding/create" class="primary-btn">Create First Onboarding</a>
            </div>
        <% } %>
    </section>
</main>
</body>
</html>