</style>

<div class="ph-page">

    <!-- HEADER -->
    <section class="ph-hero">
        <div class="ph-hero-content">
            <div class="ph-eyebrow">GYANSIFY HRMS · FINANCE</div>

            <h1>Payroll History</h1>

            <p>
                Review monthly payroll batches, monitor processing status,
                and track salary disbursement records for your organization.
            </p>
        </div>

        <div class="ph-hero-actions">
            <a href="/payroll" class="ph-btn ph-btn-light">
                ← Payroll Dashboard
            </a>

            <a href="/payroll/salary-structures"
               class="ph-btn ph-btn-outline">
                + Salary Structures
            </a>
        </div>
    </section>

    <!-- SUMMARY -->
    <div class="ph-section-heading">
        <div>
            <h2>Payroll Summary</h2>
            <p>Overview of the payroll batches returned by your controller.</p>
        </div>

        <div class="ph-period">
            ▦ <%= getMonthName(currentMonth) %> <%= currentYear %>
        </div>
    </div>

    <section class="ph-stats">

        <article class="ph-stat">
            <div class="ph-stat-top">
                <span class="ph-stat-label">Total Payroll Batches</span>
                <div class="ph-stat-icon ph-purple" aria-hidden="true">▤</div>
            </div>

            <h3 class="ph-stat-value">
                <%= totalBatches.toLocaleString("en-IN") %>
            </h3>

            <span class="ph-stat-note">All returned payroll records</span>
        </article>

        <article class="ph-stat">
            <div class="ph-stat-top">
                <span class="ph-stat-label">Processed Batches</span>
                <div class="ph-stat-icon ph-green" aria-hidden="true">✓</div>
            </div>

            <h3 class="ph-stat-value">
                <%= processedBatches.toLocaleString("en-IN") %>
            </h3>

            <span class="ph-stat-note">Processed, approved or paid status</span>
        </article>

        <article class="ph-stat">
            <div class="ph-stat-top">
                <span class="ph-stat-label">Total Net Payroll</span>
                <div class="ph-stat-icon ph-blue" aria-hidden="true">₹</div>
            </div>

            <h3 class="ph-stat-value"><%= money(totalNet) %></h3>

            <span class="ph-stat-note">Combined net amount of returned batches</span>
        </article>

        <article class="ph-stat">
            <div class="ph-stat-top">
                <span class="ph-stat-label">Employees Processed</span>
                <div class="ph-stat-icon ph-orange" aria-hidden="true">♙</div>
            </div>

            <h3 class="ph-stat-value">
                <%= totalEmployeesProcessed.toLocaleString("en-IN") %>
            </h3>

            <span class="ph-stat-note">Sum of processed employee counts</span>
        </article>

    </section>

    <!-- PAYROLL HISTORY TABLE -->
    <section class="ph-panel">

        <div class="ph-panel-header">
            <div>
                <h2>All Payroll Records</h2>
                <p>Search and filter payroll batches by period, status or reference.</p>
            </div>

            <span class="ph-count" id="phVisibleBadge">
                <%= totalBatches %> Records
            </span>
        </div>

        <% if (records.length > 0) { %>

            <div class="ph-toolbar">

                <div class="ph-search">
                    <span aria-hidden="true">⌕</span>

                    <input
                        type="search"
                        id="phSearch"
                        class="ph-control"
                        placeholder="Search payroll number..."
                        aria-label="Search payroll number"
                        autocomplete="off"
                    >
                </div>

                <div class="ph-filter">
                    <select id="phMonth" class="ph-control" aria-label="Filter by month">
                        <option value="">All months</option>

                        <% monthNames.forEach((name, index) => { %>
                            <option value="<%= index + 1 %>">
                                <%= name %>
                            </option>
                        <% }); %>
                    </select>
                </div>

                <div class="ph-filter">
                    <select id="phYear" class="ph-control" aria-label="Filter by year">
                        <option value="">All years</option>

                        <% years.forEach(year => { %>
                            <option value="<%= year %>"><%= year %></option>
                        <% }); %>
                    </select>
                </div>

                <div class="ph-filter">
                    <select id="phStatus" class="ph-control" aria-label="Filter by status">
                        <option value="">All statuses</option>

                        <% availableStatuses.forEach(status => { %>
                            <option value="<%= status %>">
                                <%= status.replace(/_/g, " ") %>
                            </option>
                        <% }); %>
                    </select>
                </div>

                <button type="button" class="ph-clear" id="phClearFilters">
                    Reset filters
                </button>

            </div>

            <div class="ph-table-wrap">
                <table class="ph-table">
                    <thead>
                        <tr>
                            <th>Payroll Reference</th>
                            <th>Payroll Period</th>
                            <th>Employees</th>
                            <th>Gross Salary</th>
                            <th>Deductions</th>
                            <th>Net Payroll</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody id="phTableBody">

                        <% records.forEach((item) => {
                            const status = getStatus(item);
                            const month = Number(item.payrollMonth);
                            const year = Number(item.payrollYear);

                            const payrollNumber = String(
                                item.payrollNumber || "Reference unavailable"
                            );

                            const searchable = [
                                payrollNumber,
                                status,
                                getMonthName(month),
                                year
                            ].join(" ").toLowerCase();

                            const employeeCount = Number(
                                item.processedEmployees || 0
                            );

                            const batchTotalEmployees = Number(
                                item.totalEmployees || 0
                            );

                            const dateValue =
                                item.createdAt ||
                                item.processedAt ||
                                item.periodStart;
                        %>

                            <tr
                                class="ph-record-row"
                                data-search="<%= searchable %>"
                                data-month="<%= month %>"
                                data-year="<%= year %>"
                                data-status="<%= status %>"
                            >
                                <td>
                                    <div class="ph-batch">
                                        <div class="ph-batch-icon" aria-hidden="true">
                                            ₹
                                        </div>

                                        <div>
                                            <span class="ph-batch-number">
                                                <%= payrollNumber %>
                                            </span>

                                            <span class="ph-batch-period">
                                                <%= employeeCount %> of
                                                <%= batchTotalEmployees %> processed
                                            </span>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <strong><%= getMonthName(month) %></strong>
                                    <span style="color:#8490a3;"> <%= year || "—" %></span>
                                </td>

                                <td>
                                    <%= batchTotalEmployees.toLocaleString("en-IN") %>
                                </td>

                                <td class="ph-amount">
                                    <%= money(item.totalGrossSalary) %>
                                </td>

                                <td class="ph-amount">
                                    <%= money(item.totalDeductions) %>
                                </td>

                                <td class="ph-net">
                                    <%= money(item.totalNetSalary) %>
                                </td>

                                <td>
                                    <span class="ph-status <%= statusClass(status) %>">
                                        <%= status.replace(/_/g, " ") %>
                                    </span>
                                </td>

                                <td><%= formatDate(dateValue) %></td>

                                <td>
                                    <a
                                        class="ph-row-action"
                                        href="/payroll/payslips?month=<%= month %>&year=<%= year %>"
                                        aria-label="View payslips for <%= getMonthName(month) %> <%= year %>"
                                    >
                                        Payslips ↗
                                    </a>
                                </td>
                            </tr>

                        <% }); %>

                    </tbody>
                </table>
            </div>

            <div class="ph-no-results" id="phNoResults">
                No payroll records match your filters. Try changing your search.
            </div>

            <div class="ph-table-footer">
                <span id="phFooterCount">
                    Showing <%= totalBatches %> of <%= totalBatches %> records
                </span>

                <button type="button" class="ph-clear" id="phClearFiltersBottom">
                    Clear all filters
                </button>
            </div>

        <% } else { %>

            <div class="ph-empty">
                <div class="ph-empty-icon" aria-hidden="true">₹</div>

                <h3>No payroll history yet</h3>

                <p>
                    Your payroll batches will appear here after a monthly
                    payroll has been successfully processed. Create salary
                    structures first if your employees do not have them.
                </p>

                <a href="/payroll" class="ph-btn ph-btn-primary">
                    Go to Payroll Dashboard →
                </a>

                <a href="/payroll/salary-structures"
                   class="ph-btn ph-btn-secondary">
                    Manage Salary Structures
                </a>
            </div>

        <% } %>

    </section>

    <div class="ph-info">
        <span aria-hidden="true">ⓘ</span>

        <div>
            <strong>Payroll records and salary totals</strong>

            This page displays batch totals stored in the payroll database.
            A processed payroll does not necessarily mean payment has been
            made. Use the recorded payroll status and payment information
            to confirm actual disbursement.
        </div>
    </div>

</div>

<script>
(function () {
    const searchInput = document.getElementById("phSearch");
    const monthSelect = document.getElementById("phMonth");
    const yearSelect = document.getElementById("phYear");
    const statusSelect = document.getElementById("phStatus");

    const rows = Array.from(
        document.querySelectorAll(".ph-record-row")
    );

    const badge = document.getElementById("phVisibleBadge");
    const footer = document.getElementById("phFooterCount");
    const noResults = document.getElementById("phNoResults");

    if (!searchInput || !monthSelect || !yearSelect || !statusSelect) {
        return;
    }

    function applyFilters() {
        const search = searchInput.value.trim().toLowerCase();
        const month = monthSelect.value;
        const year = yearSelect.value;
        const status = statusSelect.value;

        let visible = 0;

        rows.forEach(function (row) {
            const matchesSearch =
                (row.dataset.search || "").includes(search);

            const matchesMonth =
                !month || row.dataset.month === month;

            const matchesYear =
                !year || row.dataset.year === year;

            const matchesStatus =
                !status || row.dataset.status === status;

            const show =
                matchesSearch &&
                matchesMonth &&
                matchesYear &&
                matchesStatus;

            row.style.display = show ? "" : "none";

            if (show) visible++;
        });

        if (badge) {
            badge.textContent = visible + " Records";
        }

        if (footer) {
            footer.textContent =
                "Showing " + visible + " of " + rows.length + " records";
        }

        if (noResults) {
            noResults.style.display =
                rows.length > 0 && visible === 0 ? "block" : "none";
        }
    }

    function clearFilters() {
        searchInput.value = "";
        monthSelect.value = "";
        yearSelect.value = "";
        statusSelect.value = "";
        applyFilters();
    }

    searchInput.addEventListener("input", applyFilters);
    monthSelect.addEventListener("change", applyFilters);
    yearSelect.addEventListener("change", applyFilters);
    statusSelect.addEventListener("change", applyFilters);

    const clearButton = document.getElementById("phClearFilters");
    const clearButtonBottom = document.getElementById("phClearFiltersBottom");

    if (clearButton) {
        clearButton.addEventListener("click", clearFilters);
    }

    if (clearButtonBottom) {
        clearButtonBottom.addEventListener("click", clearFilters);
    }

    applyFilters();
})();
</script>