
<%
    const records = Array.isArray(payrolls) ? payrolls : [];

    const money = (value) => {
        const amount = Number(value || 0);

        return new Intl.NumberFormat("en-IN", {
            style: "currency",
            currency: "INR",
            maximumFractionDigits: 2
        }).format(Number.isFinite(amount) ? amount : 0);
    };

    const formatDate = (value) => {
        if (!value) return "—";

        const date = new Date(value);

        if (Number.isNaN(date.getTime())) return "—";

        return date.toLocaleDateString("en-IN", {
            day: "2-digit",
            month: "short",
            year: "numeric",
            timeZone: "Asia/Kolkata"
        });
    };

    const monthNames = [
        "January", "February", "March", "April",
        "May", "June", "July", "August",
        "September", "October", "November", "December"
    ];

    const getMonthName = (month) => {
        const number = Number(month);

        return Number.isInteger(number) && number >= 1 && number <= 12
            ? monthNames[number - 1]
            : "Unknown month";
    };

    const getStatus = (record) => {
        return String(record?.status || "UNKNOWN").toUpperCase();
    };

    const statusClass = (status) => {
        const map = {
            PAID: "ph-status-paid",
            PROCESSED: "ph-status-processed",
            APPROVED: "ph-status-approved",
            PROCESSING: "ph-status-processing",
            PENDING: "ph-status-pending",
            FAILED: "ph-status-failed",
            CANCELLED: "ph-status-cancelled"
        };

        return map[status] || "ph-status-unknown";
    };

    const totalBatches = records.length;

    const processedBatches = records.filter(
        item => ["PROCESSED", "APPROVED", "PAID"].includes(getStatus(item))
    ).length;

    const processingBatches = records.filter(
        item => ["PROCESSING", "PENDING"].includes(getStatus(item))
    ).length;

    const cancelledBatches = records.filter(
        item => ["CANCELLED", "FAILED"].includes(getStatus(item))
    ).length;

    const totalGross = records.reduce(
        (sum, item) => sum + (Number(item.totalGrossSalary) || 0),
        0
    );

    const totalDeductions = records.reduce(
        (sum, item) => sum + (Number(item.totalDeductions) || 0),
        0
    );

    const totalNet = records.reduce(
        (sum, item) => sum + (Number(item.totalNetSalary) || 0),
        0
    );

    const totalEmployeesProcessed = records.reduce(
        (sum, item) => sum + (Number(item.processedEmployees) || 0),
        0
    );

    const years = [...new Set(
        records
            .map(item => Number(item.payrollYear))
            .filter(year => Number.isInteger(year) && year >= 2000 && year <= 2100)
    )].sort((a, b) => b - a);

    const availableStatuses = [...new Set(
        records.map(getStatus)
    )].sort();

    const now = new Date();
    const currentMonth = now.getMonth() + 1;
    const currentYear = now.getFullYear();
%>

