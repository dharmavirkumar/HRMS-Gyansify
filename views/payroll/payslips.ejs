
<%
    const currentYear = new Date().getFullYear();

    const monthNames = [
        "January", "February", "March", "April",
        "May", "June", "July", "August",
        "September", "October", "November", "December"
    ];

    const safePayslips =
        typeof payslips !== "undefined" && Array.isArray(payslips)
            ? payslips
            : [];

    const safeFilters =
        typeof filters !== "undefined" && filters
            ? filters
            : {};

    const safeStats =
        typeof stats !== "undefined" && stats
            ? stats
            : {};

    const currentUser =
        typeof user !== "undefined" && user
            ? user
            : null;

    const currentRole = String(
        currentUser && currentUser.role
            ? currentUser.role
            : ""
    ).toUpperCase();

    const canManagePayroll = [
        "SUPER_ADMIN",
        "HR_ADMIN",
        "HR_EXECUTIVE"
    ].includes(currentRole);

    const selectedMonth = String(safeFilters.month || "");
    const selectedYear = String(safeFilters.year || currentYear);
    const selectedSearch = String(safeFilters.search || "");
    const selectedStatus = String(safeFilters.status || "").toUpperCase();

    const safePagination =
        typeof pagination !== "undefined" && pagination
            ? pagination
            : null;

    const toNumber = (value) => {
        if (typeof value === "number") {
            return Number.isFinite(value) ? value : 0;
        }

        if (typeof value === "string" && value.trim() !== "") {
            const number = Number(value);
            return Number.isFinite(number) ? number : 0;
        }

        if (value && typeof value === "object" && value.toString) {
            const number = Number(value.toString());
            return Number.isFinite(number) ? number : 0;
        }

        return 0;
    };

    const formatCurrency = (amount) =>
        new Intl.NumberFormat("en-IN", {
            style: "currency",
            currency: "INR",
            maximumFractionDigits: 2
        }).format(toNumber(amount));

    const getEmployee = (payslip) => {
        if (!payslip || typeof payslip !== "object") return null;

        const value = payslip.employee || payslip.employeeId;

        return value && typeof value === "object"
            ? value
            : null;
    };

    const getEmployeeName = (payslip) => {
        const employee = getEmployee(payslip);

        if (employee) {
            const fullName = [
                employee.firstName,
                employee.lastName
            ].filter(Boolean).join(" ");

            return fullName ||
                employee.name ||
                payslip.employeeName ||
                "Employee";
        }

        return payslip.employeeName || "Employee";
    };

    const getEmployeeCode = (payslip) => {
        const employee = getEmployee(payslip);

        return employee
            ? employee.employeeId || employee.employeeCode || "—"
            : payslip.employeeCode || "—";
    };

    const getInitials = (name) =>
        String(name || "E")
            .trim()
            .split(/\s+/)
            .filter(Boolean)
            .slice(0, 2)
            .map(part => part.charAt(0))
            .join("")
            .toUpperCase() || "E";

    const getStatus = (payslip) =>
        String(
            payslip.paymentStatus ||
            payslip.status ||
            "PENDING"
        ).trim().toUpperCase();

    const getStatusClass = (status) => {
        if (["PAID", "COMPLETED"].includes(status)) return "paid";
        if (["PROCESSING", "GENERATING"].includes(status)) return "processing";
        if (["FAILED", "CANCELLED", "REJECTED"].includes(status)) return "failed";
        if (status === "APPROVED") return "approved";

        return "pending";
    };

    const getDate = (payslip) => {
        const value =
            payslip.periodStart ||
            payslip.payPeriodStart ||
            payslip.payrollDate ||
            payslip.createdAt;

        if (!value) return null;

        const date = new Date(value);

        return Number.isNaN(date.getTime()) ? null : date;
    };

    const getMonthNumber = (payslip) => {
        const month = toNumber(
            payslip.payrollMonth ?? payslip.month
        );

        if (month >= 1 && month <= 12) return month;

        const date = getDate(payslip);

        return date
            ? Number(
                new Intl.DateTimeFormat("en-US", {
                    month: "numeric",
                    timeZone: "Asia/Kolkata"
                }).format(date)
            )
            : 0;
    };

    const getYearNumber = (payslip) => {
        const year = toNumber(
            payslip.payrollYear ?? payslip.year
        );

        if (year >= 2000 && year <= 2100) return year;

        const date = getDate(payslip);

        return date
            ? Number(
                new Intl.DateTimeFormat("en-US", {
                    year: "numeric",
                    timeZone: "Asia/Kolkata"
                }).format(date)
            )
            : 0;
    };

    const getMonthLabel = (payslip) => {
        const month = getMonthNumber(payslip);
        const year = getYearNumber(payslip);

        if (month >= 1 && month <= 12) {
            return monthNames[month - 1] +
                (year ? " " + year : "");
        }

        return "—";
    };

    const getGrossSalary = (payslip) =>
        toNumber(
            payslip.grossSalary ??
            payslip.totalGrossSalary ??
            payslip.gross
        );

    const getDeductions = (payslip) => {
        const deductions =
            payslip.totalDeductions ?? payslip.deductions;

        if (
            typeof deductions === "number" ||
            typeof deductions === "string"
        ) {
            return Math.max(0, toNumber(deductions));
        }

        if (deductions && typeof deductions === "object") {
            return Math.max(
                0,
                toNumber(deductions.total ?? deductions.amount)
            );
        }

        return 0;
    };

    const getNetSalary = (payslip) =>
        toNumber(
            payslip.netSalary ??
            payslip.totalNetSalary ??
            payslip.netPay
        );

    const getPayslipId = (payslip) =>
        String(payslip._id || payslip.id || "");

    const getSafeStatusLabel = (status) =>
        String(status || "PENDING")
            .toLowerCase()
            .replace(/_/g, " ");

    const getServerStat = (key, fallback) =>
        safeStats[key] !== undefined &&
        safeStats[key] !== null &&
        Number.isFinite(Number(safeStats[key]))
            ? toNumber(safeStats[key])
            : fallback;

    const paidCount = getServerStat(
        "paidCount",
        safePayslips.filter(p =>
            ["PAID", "COMPLETED"].includes(getStatus(p))
        ).length
    );

    const pendingCount = getServerStat(
        "pendingCount",
        safePayslips.filter(p =>
            ["PENDING", "APPROVED"].includes(getStatus(p))
        ).length
    );

    const recordCount = getServerStat(
        "total",
        safePayslips.length
    );

    const netTotal = getServerStat(
        "totalNetSalary",
        safePayslips.reduce((sum, p) => sum + getNetSalary(p), 0)
    );

    const deductionsTotal = getServerStat(
        "totalDeductions",
        safePayslips.reduce((sum, p) => sum + getDeductions(p), 0)
    );
%>

<style>
    .payslip-page {
        padding: 28px 30px 40px;
        color: #111827;
        font-family: inherit;
    }

    .payslip-page *,
    .payslip-page *::before,
    .payslip-page *::after {
        box-sizing: border-box;
    }

    .payslip-page a { text-decoration: none; }

    .ps-heading {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 25px;
    }

    .ps-eyebrow {
        margin-bottom: 8px;
        color: #2563eb;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .07em;
        text-transform: uppercase;
    }

    .ps-heading h1 {
        margin: 0;
        color: #111827;
        font-size: 26px;
        font-weight: 750;
        letter-spacing: -.7px;
    }

    .ps-heading p {
        max-width: 580px;
        margin: 8px 0 0;
        color: #6b7280;
        font-size: 13px;
        line-height: 1.7;
    }

    .ps-actions,
    .ps-filter-buttons,
    .ps-empty-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 9px;
    }

    .ps-btn {
        display: inline-flex;
        min-height: 38px;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 9px 14px;
        border: 1px solid #dbe1ea;
        border-radius: 8px;
        background: #fff;
        color: #374151;
        font-size: 12px;
        font-weight: 650;
        cursor: pointer;
        white-space: nowrap;
    }

    .ps-btn:hover { background: #f8fafc; }

    .ps-btn-primary {
        border-color: #2563eb;
        background: #2563eb;
        color: #fff;
    }

    .ps-btn-primary:hover {
        background: #1d4ed8;
        color: #fff;
    }

    .ps-btn-dark {
        border-color: #111827;
        background: #111827;
        color: #fff;
    }

    .ps-btn-dark:hover {
        background: #273449;
        color: #fff;
    }

    .ps-stats {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 15px;
        margin-bottom: 23px;
    }

    .ps-stat {
        min-width: 0;
        padding: 19px;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        background: #fff;
    }

    .ps-stat-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .ps-stat-label {
        color: #6b7280;
        font-size: 11px;
        font-weight: 600;
    }

    .ps-stat-icon {
        display: flex;
        width: 36px;
        height: 36px;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        background: #eff6ff;
        color: #2563eb;
        font-size: 17px;
    }

    .ps-stat-icon.green { background: #ecfdf5; color: #059669; }
    .ps-stat-icon.amber { background: #fffbeb; color: #b45309; }
    .ps-stat-icon.purple { background: #f5f3ff; color: #7c3aed; }

    .ps-stat-value {
        margin-top: 13px;
        color: #111827;
        font-size: 23px;
        font-weight: 750;
        letter-spacing: -.5px;
        overflow-wrap: anywhere;
    }

    .ps-stat-note {
        margin-top: 5px;
        color: #9ca3af;
        font-size: 10px;
    }

    .ps-card {
        overflow: hidden;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        background: #fff;
    }

    .ps-card-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 19px 21px;
        border-bottom: 1px solid #edf0f4;
    }

    .ps-card-heading h2 {
        margin: 0;
        font-size: 14px;
        font-weight: 750;
    }

    .ps-card-heading p {
        margin: 5px 0 0;
        color: #9ca3af;
        font-size: 11px;
    }

    .ps-record-count {
        padding: 5px 9px;
        border: 1px solid #e5e7eb;
        border-radius: 20px;
        background: #f9fafb;
        color: #4b5563;
        font-size: 10px;
        font-weight: 700;
        white-space: nowrap;
    }

    .ps-filters {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        gap: 12px;
        padding: 16px 21px;
        border-bottom: 1px solid #edf0f4;
        background: #fafbfc;
    }

    .ps-filter {
        display: flex;
        min-width: 135px;
        flex-direction: column;
        gap: 6px;
    }

    .ps-filter-search {
        flex: 1;
        min-width: 190px;
    }

    .ps-filter label {
        color: #4b5563;
        font-size: 10px;
        font-weight: 700;
    }

    .ps-filter input,
    .ps-filter select {
        width: 100%;
        min-height: 38px;
        padding: 0 11px;
        outline: none;
        border: 1px solid #dbe1ea;
        border-radius: 7px;
        background: #fff;
        color: #374151;
        font: inherit;
        font-size: 11px;
    }

    .ps-filter input:focus,
    .ps-filter select:focus {
        border-color: #60a5fa;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, .09);
    }

    .ps-table-wrap {
        width: 100%;
        overflow-x: auto;
    }

    .ps-table {
        width: 100%;
        min-width: 980px;
        border-collapse: collapse;
    }

    .ps-table th {
        padding: 13px 16px;
        border-bottom: 1px solid #e5e7eb;
        background: #f9fafb;
        color: #6b7280;
        font-size: 10px;
        font-weight: 750;
        text-align: left;
        white-space: nowrap;
    }

    .ps-table td {
        padding: 14px 16px;
        border-bottom: 1px solid #f1f3f6;
        color: #374151;
        font-size: 11px;
        vertical-align: middle;
        white-space: nowrap;
    }

    .ps-table tbody tr:hover { background: #fafcff; }
    .ps-table tbody tr:last-child td { border-bottom: 0; }
    .ps-table tbody tr[hidden] { display: none; }

    .ps-employee {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .ps-avatar {
        display: flex;
        width: 35px;
        height: 35px;
        flex: 0 0 35px;
        align-items: center;
        justify-content: center;
        border: 1px solid #dbeafe;
        border-radius: 10px;
        background: #eff6ff;
        color: #1d4ed8;
        font-size: 10px;
        font-weight: 800;
    }

    .ps-employee-name {
        max-width: 190px;
        overflow: hidden;
        color: #111827;
        font-weight: 750;
        text-overflow: ellipsis;
    }

    .ps-employee-id {
        margin-top: 4px;
        color: #9ca3af;
        font-size: 10px;
    }

    .ps-money {
        color: #374151;
        font-weight: 650;
        font-variant-numeric: tabular-nums;
    }

    .ps-net {
        color: #111827;
        font-weight: 800;
        font-variant-numeric: tabular-nums;
    }

    .ps-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 9px;
        border-radius: 20px;
        font-size: 9px;
        font-weight: 800;
        text-transform: capitalize;
    }

    .ps-status::before {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: currentColor;
        content: "";
    }

    .ps-status-paid { background: #ecfdf5; color: #047857; }
    .ps-status-pending { background: #fffbeb; color: #b45309; }
    .ps-status-processing { background: #eff6ff; color: #1d4ed8; }
    .ps-status-failed { background: #fef2f2; color: #b91c1c; }
    .ps-status-approved { background: #f5f3ff; color: #6d28d9; }

    .ps-row-actions {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .ps-icon-btn {
        display: inline-flex;
        width: 31px;
        height: 31px;
        align-items: center;
        justify-content: center;
        border: 1px solid #e5e7eb;
        border-radius: 7px;
        background: #fff;
        color: #4b5563;
        font-size: 14px;
    }

    .ps-icon-btn:hover {
        border-color: #bfdbfe;
        background: #eff6ff;
        color: #1d4ed8;
    }

    .ps-empty {
        padding: 66px 22px;
        text-align: center;
    }

    .ps-empty-icon {
        display: flex;
        width: 66px;
        height: 66px;
        align-items: center;
        justify-content: center;
        margin: 0 auto 18px;
        border: 1px solid #dbeafe;
        border-radius: 20px;
        background: #eff6ff;
        color: #2563eb;
        font-size: 28px;
    }

    .ps-empty h3 {
        margin: 0;
        font-size: 16px;
        font-weight: 750;
    }

    .ps-empty p {
        max-width: 420px;
        margin: 9px auto 20px;
        color: #9ca3af;
        font-size: 12px;
        line-height: 1.8;
    }

    .ps-empty-actions { justify-content: center; }

    .ps-table-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        padding: 14px 20px;
        border-top: 1px solid #edf0f4;
        color: #9ca3af;
        font-size: 10px;
    }

    .ps-table-footer strong { color: #4b5563; }

    .ps-no-results {
        display: none;
        padding: 28px 15px;
        color: #6b7280;
        font-size: 12px;
        text-align: center;
    }

    .ps-pagination {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .ps-alert {
        margin-bottom: 18px;
        padding: 12px 15px;
        border: 1px solid #fecaca;
        border-radius: 8px;
        background: #fef2f2;
        color: #991b1b;
        font-size: 12px;
    }

    @media (max-width: 1100px) {
        .ps-stats {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 700px) {
        .payslip-page { padding: 18px 14px 28px; }
        .ps-heading { flex-direction: column; }
        .ps-heading h1 { font-size: 23px; }
        .ps-actions { width: 100%; }
        .ps-actions .ps-btn { flex: 1; }
        .ps-stats { gap: 10px; }
        .ps-stat { padding: 14px; }
        .ps-stat-value { font-size: 19px; }
        .ps-card-heading { align-items: flex-start; }
        .ps-filters { align-items: stretch; flex-direction: column; }
        .ps-filter, .ps-filter-search {
            min-width: 0;
            width: 100%;
        }
        .ps-filter-buttons { width: 100%; }
        .ps-filter-buttons .ps-btn { flex: 1; }
        .ps-table-footer { align-items: flex-start; flex-direction: column; }
    }

    @media (max-width: 380px) {
        .ps-stats { grid-template-columns: 1fr; }
    }
</style>

<%- include('../partials/navbar') %>
<section class="payslip-page">

    <header class="ps-heading">
        <div>
            <div class="ps-eyebrow">₹ &nbsp; Payroll Management</div>
            <h1>Employee Payslips</h1>
            <p>View salary statements, review payment status and manage monthly payslip records.</p>
        </div>

        <div class="ps-actions">
            <% if (canManagePayroll) { %>
                <a href="/payroll/process" class="ps-btn ps-btn-primary">
                    ＋ Process Payroll
                </a>
                <a href="/payroll" class="ps-btn">
                    ← Back to Payroll
                </a>
            <% } %>
        </div>
    </header>

    <% if (typeof error !== "undefined" && error) { %>
        <div class="ps-alert" role="alert"><%= error %></div>
    <% } %>

    <div class="ps-stats">
        <article class="ps-stat">
            <div class="ps-stat-top">
                <span class="ps-stat-label">Payslip Records</span>
                <span class="ps-stat-icon">▤</span>
            </div>
            <div class="ps-stat-value"><%= recordCount %></div>
            <div class="ps-stat-note">Total records reported by the server</div>
        </article>

        <article class="ps-stat">
            <div class="ps-stat-top">
                <span class="ps-stat-label">Paid Records</span>
                <span class="ps-stat-icon green">✓</span>
            </div>
            <div class="ps-stat-value"><%= paidCount %></div>
            <div class="ps-stat-note">Records marked paid or completed</div>
        </article>

        <article class="ps-stat">
            <div class="ps-stat-top">
                <span class="ps-stat-label">Pending Records</span>
                <span class="ps-stat-icon amber">◷</span>
            </div>
            <div class="ps-stat-value"><%= pendingCount %></div>
            <div class="ps-stat-note">Records awaiting further action</div>
        </article>

        <article class="ps-stat">
            <div class="ps-stat-top">
                <span class="ps-stat-label">Net Salary Total</span>
                <span class="ps-stat-icon purple">₹</span>
            </div>
            <div class="ps-stat-value"><%= formatCurrency(netTotal) %></div>
            <div class="ps-stat-note">Total supplied by the server or current records</div>
        </article>
    </div>

    <section class="ps-card">
        <div class="ps-card-heading">
            <div>
                <h2>Payslip Register</h2>
                <p>Search and filter employee salary records.</p>
            </div>
            <span class="ps-record-count">
                <%= safePayslips.length %> loaded
            </span>
        </div>

        <form
            id="payslipFilterForm"
            class="ps-filters"
            method="GET"
            action="/payroll/payslips"
        >
            <div class="ps-filter ps-filter-search">
                <label for="employeeSearch">Search Employee</label>
                <input
                    type="search"
                    id="employeeSearch"
                    name="search"
                    value="<%= selectedSearch %>"
                    placeholder="Name or employee ID..."
                    autocomplete="off"
                >
            </div>

            <div class="ps-filter">
                <label for="payrollMonth">Payroll Month</label>
                <select id="payrollMonth" name="month">
                    <option value="">All months</option>
                    <% monthNames.forEach((monthName, index) => { %>
                        <option
                            value="<%= index + 1 %>"
                            <%= selectedMonth === String(index + 1) ? "selected" : "" %>
                        ><%= monthName %></option>
                    <% }) %>
                </select>
            </div>

            <div class="ps-filter">
                <label for="payrollYear">Payroll Year</label>
                <input
                    type="number"
                    id="payrollYear"
                    name="year"
                    min="2000"
                    max="2100"
                    value="<%= selectedYear %>"
                >
            </div>

            <div class="ps-filter">
                <label for="statusFilter">Payment Status</label>
                <select id="statusFilter" name="status">
                    <option value="">All statuses</option>
                    <% [
                        "PAID",
                        "COMPLETED",
                        "PENDING",
                        "PROCESSING",
                        "GENERATING",
                        "APPROVED",
                        "FAILED",
                        "CANCELLED",
                        "REJECTED"
                    ].forEach((statusOption) => { %>
                        <option
                            value="<%= statusOption %>"
                            <%= selectedStatus === statusOption ? "selected" : "" %>
                        ><%= statusOption.charAt(0) + statusOption.slice(1).toLowerCase() %></option>
                    <% }) %>
                </select>
            </div>

            <div class="ps-filter-buttons">
                <button type="submit" class="ps-btn ps-btn-dark">
                    Apply Filters
                </button>
                <a href="/payroll/payslips" class="ps-btn">Reset</a>
            </div>
        </form>

        <% if (safePayslips.length > 0) { %>
            <div class="ps-table-wrap">
                <table class="ps-table">
                    <thead>
                        <tr>
                            <th>EMPLOYEE</th>
                            <th>PAYROLL PERIOD</th>
                            <th>GROSS SALARY</th>
                            <th>DEDUCTIONS</th>
                            <th>NET SALARY</th>
                            <th>STATUS</th>
                            <th>ACTIONS</th>
                        </tr>
                    </thead>

                    <tbody id="payslipTableBody">
                        <% safePayslips.forEach((payslip) => {
                            const employeeName = getEmployeeName(payslip);
                            const employeeCode = getEmployeeCode(payslip);
                            const status = getStatus(payslip);
                            const recordId = getPayslipId(payslip);
                        %>
                            <tr
                                class="ps-payslip-row"
                                data-employee="<%= (employeeName + ' ' + employeeCode).toLowerCase() %>"
                                data-month="<%= getMonthNumber(payslip) %>"
                                data-year="<%= getYearNumber(payslip) %>"
                                data-status="<%= status %>"
                            >
                                <td>
                                    <div class="ps-employee">
                                        <div class="ps-avatar">
                                            <%= getInitials(employeeName) %>
                                        </div>
                                        <div>
                                            <div class="ps-employee-name">
                                                <%= employeeName %>
                                            </div>
                                            <div class="ps-employee-id">
                                                ID: <%= employeeCode %>
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <strong><%= getMonthLabel(payslip) %></strong>
                                </td>

                                <td class="ps-money">
                                    <%= formatCurrency(getGrossSalary(payslip)) %>
                                </td>

                                <td class="ps-money">
                                    <%= formatCurrency(getDeductions(payslip)) %>
                                </td>

                                <td class="ps-net">
                                    <%= formatCurrency(getNetSalary(payslip)) %>
                                </td>

                                <td>
                                    <span class="ps-status ps-status-<%= getStatusClass(status) %>">
                                        <%= getSafeStatusLabel(status) %>
                                    </span>
                                </td>

                                <td>
                                    <div class="ps-row-actions">
                                        <% if (/^[a-fA-F0-9]{24}$/.test(recordId)) { %>
                                            <a
                                                class="ps-icon-btn"
                                                href="/payroll/payslips/<%= encodeURIComponent(recordId) %>"
                                                title="View payslip"
                                                aria-label="View payslip"
                                            >↗</a>

                                            <a
                                                class="ps-icon-btn"
                                                href="/payroll/payslips/<%= encodeURIComponent(recordId) %>/download"
                                                title="Download payslip"
                                                aria-label="Download payslip"
                                            >↓</a>
                                        <% } else { %>
                                            <span title="Payslip record ID unavailable">—</span>
                                        <% } %>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>

            <div id="payslipNoResults" class="ps-no-results" role="status">
                No records match your current filters. Try changing your search.
            </div>

            <div class="ps-table-footer">
                <span>
                    Showing <strong id="visiblePayslipCount"><%= safePayslips.length %></strong>
                    of <strong><%= recordCount %></strong> total records
                </span>

                <span>
                    Total deductions:
                    <strong><%= formatCurrency(deductionsTotal) %></strong>
                </span>

                <% if (safePagination) { %>
                    <div class="ps-pagination">
                        <% if (safePagination.previousUrl) { %>
                            <a class="ps-btn" href="<%= safePagination.previousUrl %>">
                                Previous
                            </a>
                        <% } %>

                        <% if (safePagination.nextUrl) { %>
                            <a class="ps-btn" href="<%= safePagination.nextUrl %>">
                                Next
                            </a>
                        <% } %>
                    </div>
                <% } %>
            </div>

        <% } else { %>
            <div class="ps-empty">
                <div class="ps-empty-icon">₹</div>
                <h3>No Payslips Available</h3>
                <p>
                    No payslip records were returned. Check your filters,
                    or contact HR if you expect a salary statement here.
                </p>

                <% if (canManagePayroll) { %>
                    <div class="ps-empty-actions">
                        <a href="/payroll/process" class="ps-btn ps-btn-primary">
                            Process Payroll
                        </a>
                        <a href="/payroll" class="ps-btn">
                            View Payroll
                        </a>
                    </div>
                <% } %>
            </div>
        <% } %>
    </section>
</section>

<script>
(function () {
    "use strict";

    const searchInput = document.getElementById("employeeSearch");
    const monthInput = document.getElementById("payrollMonth");
    const yearInput = document.getElementById("payrollYear");
    const statusInput = document.getElementById("statusFilter");

    const rows = Array.from(
        document.querySelectorAll(".ps-payslip-row")
    );

    const noResults = document.getElementById("payslipNoResults");
    const visibleCount = document.getElementById("visiblePayslipCount");

    function filterPayslips() {
        const search = searchInput
            ? searchInput.value.trim().toLowerCase()
            : "";

        const month = monthInput ? monthInput.value : "";
        const year = yearInput ? yearInput.value : "";
        const status = statusInput
            ? statusInput.value.toUpperCase()
            : "";

        let visible = 0;

        rows.forEach((row) => {
            const matchesSearch =
                !search ||
                (row.dataset.employee || "").includes(search);

            const matchesMonth =
                !month || row.dataset.month === month;

            const matchesYear =
                !year || row.dataset.year === year;

            const matchesStatus =
                !status || row.dataset.status === status;

            const matches =
                matchesSearch &&
                matchesMonth &&
                matchesYear &&
                matchesStatus;

            row.hidden = !matches;

            if (matches) visible++;
        });

        if (visibleCount) {
            visibleCount.textContent = String(visible);
        }

        if (noResults) {
            noResults.style.display =
                rows.length > 0 && visible === 0
                    ? "block"
                    : "none";
        }
    }

    if (searchInput) {
        searchInput.addEventListener("input", filterPayslips);
    }

    if (monthInput) {
        monthInput.addEventListener("change", filterPayslips);
    }

    if (yearInput) {
        yearInput.addEventListener("input", filterPayslips);
    }

    if (statusInput) {
        statusInput.addEventListener("change", filterPayslips);
    }

    filterPayslips();
})();
</script>
