<script>
(function () {
    "use strict";

    const form = document.getElementById("salaryStructureForm");

    if (!form || form.dataset.initialized === "true") {
        return;
    }

    form.dataset.initialized = "true";

    const earningsFields = [
        "basicSalary",
        "hra",
        "conveyanceAllowance",
        "medicalAllowance",
        "specialAllowance",
        "otherAllowance"
    ];

    const deductionFields = [
        "providentFund",
        "professionalTax",
        "tds",
        "otherDeduction"
    ];

    const allFields = [...earningsFields, ...deductionFields];

    const getInput = (id) => document.getElementById(id);

    const getAmount = (id) => {
        const input = getInput(id);

        if (!input || input.value.trim() === "") {
            return 0;
        }

        const value = Number(input.value);

        return Number.isFinite(value) ? value : 0;
    };

    const formatMoney = (amount) => {
        return "₹" + amount.toLocaleString("en-IN", {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        });
    };

    const grossOutput = getInput("previewGross");
    const deductionsOutput = getInput("previewDeductions");
    const netOutput = getInput("previewNet");
    const message = getInput("salaryCalculationMessage");
    const basicInput = getInput("basicSalary");
    const effectiveDateInput = getInput("effectiveFrom");
    const submitButton = form.querySelector('[type="submit"]');

    const calculate = () => {
        const gross = earningsFields.reduce(
            (total, id) => total + getAmount(id),
            0
        );

        const deductions = deductionFields.reduce(
            (total, id) => total + getAmount(id),
            0
        );

        return {
            gross,
            deductions,
            net: gross - deductions
        };
    };

    const updateSummary = () => {
        const { gross, deductions, net } = calculate();

        if (grossOutput) {
            grossOutput.textContent = formatMoney(gross);
        }

        if (deductionsOutput) {
            deductionsOutput.textContent = formatMoney(deductions);
        }

        if (netOutput) {
            netOutput.textContent = formatMoney(Math.max(0, net));
        }

        allFields.forEach((id) => {
            const input = getInput(id);

            if (!input) return;

            const raw = input.value.trim();
            const value = Number(raw);

            const invalid =
                raw !== "" &&
                (!Number.isFinite(value) || value < 0);

            input.setCustomValidity(
                invalid
                    ? "Enter a valid amount greater than or equal to zero."
                    : ""
            );
        });

        if (!message) return;

        message.classList.remove("is-error", "is-success");

        if (net < 0) {
            message.textContent =
                "Total deductions exceed gross salary. Reduce deductions before saving.";
            message.classList.add("is-error");
        } else if (gross > 0) {
            message.textContent =
                "Net salary: " + formatMoney(net) +
                ". Final amounts are validated by the server.";
            message.classList.add("is-success");
        } else {
            message.textContent =
                "Estimate only. The server validates all submitted amounts.";
        }
    };

    allFields.forEach((id) => {
        const input = getInput(id);

        if (input) {
            input.addEventListener("input", updateSummary);
            input.addEventListener("change", updateSummary);
        }
    });

    form.addEventListener("submit", (event) => {
        updateSummary();

        const { gross, deductions, net } = calculate();

        if (!form.checkValidity()) {
            event.preventDefault();
            form.reportValidity();
            return;
        }

        if (!basicInput || basicInput.value.trim() === "") {
            event.preventDefault();

            if (basicInput) {
                basicInput.focus();
            }

            return;
        }

        if (Number(basicInput.value) < 0 || gross < 0) {
            event.preventDefault();
            return;
        }

        if (!effectiveDateInput || !effectiveDateInput.value) {
            event.preventDefault();

            if (effectiveDateInput) {
                effectiveDateInput.focus();
            }

            return;
        }

        if (deductions > gross || net < 0) {
            event.preventDefault();

            if (message) {
                message.textContent =
                    "Cannot save this salary structure: total deductions cannot exceed gross salary.";
                message.classList.add("is-error");
                message.classList.remove("is-success");

                message.scrollIntoView({
                    behavior: "smooth",
                    block: "center"
                });
            }

            return;
        }

        if (submitButton) {
            submitButton.disabled = true;
            submitButton.textContent = "Saving Salary Structure...";
        }
    });

    updateSummary();
})();
</script>