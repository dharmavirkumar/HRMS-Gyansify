
<%
    const currentDate = new Date();
    const currentYear = currentDate.getFullYear();
    const currentMonth = currentDate.getMonth() + 1;

    const selectedMonth = Number(
        typeof payrollMonth !== "undefined" && payrollMonth
            ? payrollMonth
            : currentMonth
    );

    const selectedYear = Number(
        typeof payrollYear !== "undefined" && payrollYear
            ? payrollYear
            : currentYear
    );

    const months = [
        "January", "February", "March", "April",
        "May", "June", "July", "August",
        "September", "October", "November", "December"
    ];

    const safeStats =
        typeof stats !== "undefined" && stats
            ? stats
            : {};

    const pageError =
        typeof error !== "undefined" ? error : null;

    const pageSuccess =
        typeof success !== "undefined" ? success : null;

    const formatMoney = (value) => {
        const amount = Number(value ?? 0);

        return (Number.isFinite(amount) ? amount : 0)
            .toLocaleString("en-IN", {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });
    };

    const getMonthStart = (year, month) => {
        return [
            year,
            String(month).padStart(2, "0"),
            "01"
        ].join("-");
    };

    const getMonthEnd = (year, month) => {
        const date = new Date(Date.UTC(year, month, 0));

        return [
            date.getUTCFullYear(),
            String(date.getUTCMonth() + 1).padStart(2, "0"),
            String(date.getUTCDate()).padStart(2, "0")
        ].join("-");
    };

    const defaultStart =
        selectedMonth >= 1 && selectedMonth <= 12
            ? getMonthStart(selectedYear, selectedMonth)
            : "";

    const defaultEnd =
        selectedMonth >= 1 && selectedMonth <= 12
            ? getMonthEnd(selectedYear, selectedMonth)
            : "";

    const selectedPeriodStart =
        typeof periodStart !== "undefined" && periodStart
            ? String(periodStart).slice(0, 10)
            : defaultStart;

    const selectedPeriodEnd =
        typeof periodEnd !== "undefined" && periodEnd
            ? String(periodEnd).slice(0, 10)
            : defaultEnd;
%>

<section class="process-page">

    <!-- PAGE HEADER -->

    <header class="process-heading">
        <div>
            <div class="process-eyebrow">PAYROLL MANAGEMENT</div>

            <h1>Process Payroll</h1>

            <p>
                Configure the payroll period, review salary inputs
                and initiate monthly payroll processing.
            </p>
        </div>

        <a href="/payroll" class="process-back-button">
            <span aria-hidden="true">←</span>
            Back to Payroll
        </a>
    </header>

    <!-- FEEDBACK -->

    <% if (pageError) { %>
        <div class="process-alert process-alert-error" role="alert">
            <span class="alert-icon" aria-hidden="true">!</span>

            <div>
                <strong>Payroll could not be processed</strong>
                <p><%= pageError %></p>
            </div>
        </div>
    <% } %>

    <% if (pageSuccess) { %>
        <div class="process-alert process-alert-success" role="status">
            <span class="alert-icon" aria-hidden="true">✓</span>

            <div>
                <strong>Payroll request completed</strong>
                <p><%= pageSuccess %></p>
            </div>
        </div>
    <% } %>

    <!-- PAYROLL OVERVIEW -->

    <div class="process-overview">

        <article class="overview-card">
            <div class="overview-icon icon-blue">₹</div>

            <div>
                <span>Payroll Period</span>
                <strong id="overviewPeriod">
                    <%= months[selectedMonth - 1] || "Select month" %>
                    <%= selectedYear %>
                </strong>
                <small>Selected processing cycle</small>
            </div>
        </article>

        <article class="overview-card">
            <div class="overview-icon icon-purple">01</div>

            <div>
                <span>Processing Stage</span>
                <strong>Pre-processing</strong>
                <small>Before payroll generation</small>
            </div>
        </article>

        <article class="overview-card">
            <div class="overview-icon icon-green">✓</div>

            <div>
                <span>Validation</span>
                <strong>Required</strong>
                <small>Server-side checks before saving</small>
            </div>
        </article>

    </div>

    <!-- PAYROLL PERIOD FORM -->

    <section class="process-card">

        <div class="process-card-header">
            <div class="process-card-icon">01</div>

            <div>
                <h2>Payroll Period</h2>
                <p>
                    Choose the month, year and exact payroll date range.
                </p>
            </div>

            <span class="process-badge">REQUIRED</span>
        </div>

        <form
            method="POST"
            action="/payroll/process"
            class="process-form"
            id="processPayrollForm"
        >

            <div class="process-form-grid">

                <!-- MONTH -->

                <div class="process-field">
                    <label for="payrollMonth">
                        Payroll Month <span>*</span>
                    </label>

                    <select
                        id="payrollMonth"
                        name="payrollMonth"
                        required
                    >
                        <option value="">Select month</option>

                        <% months.forEach((month, index) => { %>
                            <option
                                value="<%= index + 1 %>"
                                <%= selectedMonth === index + 1 ? "selected" : "" %>
                            >
                                <%= month %>
                            </option>
                        <% }) %>
                    </select>
                </div>

                <!-- YEAR -->

                <div class="process-field">
                    <label for="payrollYear">
                        Payroll Year <span>*</span>
                    </label>

                    <input
                        type="number"
                        id="payrollYear"
                        name="payrollYear"
                        value="<%= selectedYear %>"
                        min="2000"
                        max="2100"
                        step="1"
                        required
                    >
                </div>

                <!-- START DATE -->

                <div class="process-field">
                    <label for="periodStart">
                        Period Start <span>*</span>
                    </label>

                    <input
                        type="date"
                        id="periodStart"
                        name="periodStart"
                        value="<%= selectedPeriodStart %>"
                        required
                    >

                    <small>First day included in this payroll.</small>
                </div>

                <!-- END DATE -->

                <div class="process-field">
                    <label for="periodEnd">
                        Period End <span>*</span>
                    </label>

                    <input
                        type="date"
                        id="periodEnd"
                        name="periodEnd"
                        value="<%= selectedPeriodEnd %>"
                        required
                    >

                    <small>Last day included in this payroll.</small>
                </div>

            </div>

            <!-- PERIOD PREVIEW -->

            <div class="period-preview">
                <div class="period-preview-icon" aria-hidden="true">i</div>

                <div>
                    <strong id="periodPreviewTitle">
                        Payroll period preview
                    </strong>

                    <p id="periodPreviewText">
                        Select a valid payroll month and date range.
                    </p>
                </div>
            </div>

            <div class="process-form-footer">

                <p>
                    <span>*</span> Required fields. The server must validate
                    the payroll period and duplicate processing.
                </p>

                <button
                    type="submit"
                    class="process-primary-button"
                    id="processPayrollButton"
                >
                    <span>Process Payroll</span>
                    <span aria-hidden="true">→</span>
                </button>

            </div>

        </form>
    </section>

    <!-- PAYROLL PRE-CHECKS -->

    <section class="process-card">

        <div class="process-card-header">
            <div class="process-card-icon process-icon-orange">02</div>

            <div>
                <h2>Pre-processing Checklist</h2>
                <p>
                    Verify payroll inputs before calculating employee salaries.
                </p>
            </div>
        </div>

        <div class="precheck-list">

            <div class="precheck-item">
                <div class="precheck-symbol">01</div>

                <div class="precheck-content">
                    <strong>Employee eligibility</strong>
                    <p>
                        Include eligible employees belonging to the authenticated
                        organization and exclude exited employees according to
                        your payroll policy.
                    </p>
                </div>

                <span class="precheck-label">VERIFY</span>
            </div>

            <div class="precheck-item">
                <div class="precheck-symbol">02</div>

                <div class="precheck-content">
                    <strong>Effective salary structures</strong>
                    <p>
                        Confirm that each employee has the appropriate salary
                        structure effective during the selected payroll period.
                    </p>
                </div>

                <span class="precheck-label">VERIFY</span>
            </div>

            <div class="precheck-item">
                <div class="precheck-symbol">03</div>

                <div class="precheck-content">
                    <strong>Attendance and leave</strong>
                    <p>
                        Verify attendance, approved leave, holidays and any
                        applicable loss-of-pay calculations.
                    </p>
                </div>

                <span class="precheck-label">VERIFY</span>
            </div>

            <div class="precheck-item">
                <div class="precheck-symbol">04</div>

                <div class="precheck-content">
                    <strong>Earnings and statutory deductions</strong>
                    <p>
                        Validate allowances, PF, professional tax, TDS and
                        other deductions against your organization's rules.
                    </p>
                </div>

                <span class="precheck-label">VERIFY</span>
            </div>

            <div class="precheck-item">
                <div class="precheck-symbol">05</div>

                <div class="precheck-content">
                    <strong>Duplicate payroll prevention</strong>
                    <p>
                        Check whether payroll already exists for this organization,
                        month and year before creating a new record.
                    </p>
                </div>

                <span class="precheck-label">VERIFY</span>
            </div>

        </div>

        <div class="precheck-note">
            <strong>Important:</strong>
            This checklist is informational. It does not confirm that these
            checks have already passed in your backend.
        </div>

    </section>

    <!-- PROCESSING WORKFLOW -->

    <section class="process-card">

        <div class="process-card-header">
            <div class="process-card-icon process-icon-green">03</div>

            <div>
                <h2>Payroll Processing Workflow</h2>
                <p>
                    Recommended lifecycle for the Gyansify HRMS payroll module.
                </p>
            </div>
        </div>

        <div class="workflow">

            <div class="workflow-step">
                <div class="workflow-step-number">1</div>

                <div>
                    <strong>Validate inputs</strong>
                    <p>
                        Validate organization, period, employee eligibility
                        and salary structures.
                    </p>
                </div>
            </div>

            <div class="workflow-connector"></div>

            <div class="workflow-step">
                <div class="workflow-step-number">2</div>

                <div>
                    <strong>Calculate payroll</strong>
                    <p>
                        Calculate earnings, deductions, attendance adjustments
                        and net salary.
                    </p>
                </div>
            </div>

            <div class="workflow-connector"></div>

            <div class="workflow-step">
                <div class="workflow-step-number">3</div>

                <div>
                    <strong>Review payroll</strong>
                    <p>
                        Inspect employee-level calculations and resolve
                        validation errors.
                    </p>
                </div>
            </div>

            <div class="workflow-connector"></div>

            <div class="workflow-step">
                <div class="workflow-step-number">4</div>

                <div>
                    <strong>Approve payroll</strong>
                    <p>
                        Allow an authorized approver to approve the
                        reviewed payroll batch.
                    </p>
                </div>
            </div>

            <div class="workflow-connector"></div>

            <div class="workflow-step">
                <div class="workflow-step-number">5</div>

                <div>
                    <strong>Generate payslips and payment records</strong>
                    <p>
                        Generate employee payslips and record payment status
                        after the appropriate approval.
                    </p>
                </div>
            </div>

        </div>

    </section>

</section>

<style>
