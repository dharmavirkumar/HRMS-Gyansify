        }

        .process-form {
            padding: 16px;
        }

        .process-form-grid {
            grid-template-columns: 1fr;
        }

        .process-form-footer {
            align-items: stretch;
            flex-direction: column;
        }

        .process-primary-button {
            width: 100%;
        }

        .precheck-list {
            padding-right: 16px;
            padding-left: 16px;
        }

        .precheck-item {
            gap: 10px;
        }

        .precheck-label {
            display: none;
        }

        .precheck-note {
            margin-right: 16px;
            margin-left: 16px;
        }

        .workflow {
            padding-right: 16px;
            padding-left: 16px;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .process-page *,
        .process-page *::before,
        .process-page *::after {
            transition: none !important;
            animation: none !important;
        }
    }
</style>

<script>
(function () {
    "use strict";

    const form = document.getElementById("processPayrollForm");

    if (!form || form.dataset.initialized === "true") {
        return;
    }

    form.dataset.initialized = "true";

    const monthInput = document.getElementById("payrollMonth");
    const yearInput = document.getElementById("payrollYear");
    const startInput = document.getElementById("periodStart");
    const endInput = document.getElementById("periodEnd");

    const preview = document.querySelector(".period-preview");
    const previewTitle = document.getElementById("periodPreviewTitle");
    const previewText = document.getElementById("periodPreviewText");
    const overviewPeriod = document.getElementById("overviewPeriod");
    const submitButton = document.getElementById("processPayrollButton");

    const monthNames = [
        "January", "February", "March", "April",
        "May", "June", "July", "August",
        "September", "October", "November", "December"
    ];

    const formatDate = (value) => {
        if (!value) return "";

        const parts = value.split("-").map(Number);

        if (parts.length !== 3 || parts.some(Number.isNaN)) {
            return "";
        }

        const date = new Date(
            Date.UTC(parts[0], parts[1] - 1, parts[2])
        );

        if (Number.isNaN(date.getTime())) {
            return "";
        }

        return date.toLocaleDateString("en-IN", {
            day: "2-digit",
            month: "short",
            year: "numeric",
            timeZone: "UTC"
        });
    };

    const getPeriodProblem = () => {
        const month = Number(monthInput.value);
        const year = Number(yearInput.value);
        const start = startInput.value;
        const end = endInput.value;

        if (!monthInput.value || month < 1 || month > 12) {
            return "Select a valid payroll month.";
        }

        if (
            !yearInput.value ||
            !Number.isInteger(year) ||
            year < 2000 ||
            year > 2100
        ) {
            return "Enter a valid payroll year between 2000 and 2100.";
        }

        if (!start || !end) {
            return "Select both the period start and period end dates.";
        }

        if (start > end) {
            return "Period start cannot be after period end.";
        }

        const expectedStart =
            year + "-" + String(month).padStart(2, "0") + "-01";

        const lastDay = new Date(Date.UTC(year, month, 0))
            .getUTCDate();

        const expectedEnd =
            year + "-" +
            String(month).padStart(2, "0") + "-" +
            String(lastDay).padStart(2, "0");

        if (start < expectedStart || end > expectedEnd) {
            return (
                "The selected dates must fall within " +
                monthNames[month - 1] + " " + year + "."
            );
        }

        return "";
    };

    const updatePreview = () => {
        const month = Number(monthInput.value);
        const year = Number(yearInput.value);
        const problem = getPeriodProblem();

        if (overviewPeriod) {
            overviewPeriod.textContent =
                month >= 1 && month <= 12 && year
                    ? monthNames[month - 1] + " " + year
                    : "Select period";
        }

        if (preview) {
            preview.classList.toggle("is-error", Boolean(problem));
        }

        if (problem) {
            previewTitle.textContent = "Check payroll period";
            previewText.textContent = problem;

            startInput.setCustomValidity(
                startInput.value && endInput.value && startInput.value > endInput.value
                    ? "Period start cannot be after period end."
                    : ""
            );

            endInput.setCustomValidity(
                startInput.value && endInput.value && startInput.value > endInput.value
                    ? "Period end must be on or after the start date."
                    : ""
            );

            return false;
        }

        startInput.setCustomValidity("");
        endInput.setCustomValidity("");

        const first = formatDate(startInput.value);
        const last = formatDate(endInput.value);

        previewTitle.textContent =
            monthNames[month - 1] + " " + year + " payroll period";

        previewText.textContent =
            first + " to " + last +
            ". Confirm that attendance and salary inputs are ready before processing.";

        return true;
    };

    [monthInput, yearInput, startInput, endInput].forEach((input) => {
        input.addEventListener("change", updatePreview);
        input.addEventListener("input", updatePreview);
    });

    form.addEventListener("submit", (event) => {
        const validPeriod = updatePreview();

        if (!form.checkValidity() || !validPeriod) {
            event.preventDefault();
            form.reportValidity();
            return;
        }

        /*
         * Do not calculate or save payroll in browser JavaScript.
         * The server must perform the authoritative calculations,
         * authorization, validation and duplicate checks.
         */
        if (submitButton) {
            submitButton.disabled = true;

            const label = submitButton.querySelector("span");

            if (label) {
                label.textContent = "Submitting...";
            }
        }
    });

    updatePreview();
})();
</script>
