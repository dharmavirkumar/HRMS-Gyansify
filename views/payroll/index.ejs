
<style>
    .payroll-page {
        padding: 28px 32px;
        color: #111827;
        max-width: 1600px;
        margin: 0 auto;
    }

    .payroll-page *,
    .payroll-page *::before,
    .payroll-page *::after {
        box-sizing: border-box;
    }

    .payroll-page .page-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 26px;
    }

    .payroll-page .heading-copy h1 {
        margin: 0;
        font-size: 25px;
        font-weight: 700;
        letter-spacing: -0.6px;
    }

    .payroll-page .heading-copy p {
        margin: 7px 0 0;
        color: #6b7280;
        font-size: 13px;
        line-height: 1.6;
    }

    .payroll-page .heading-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .payroll-page .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 40px;
        padding: 10px 16px;
        border: 1px solid transparent;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 600;
        text-decoration: none;
        transition: background .2s, border-color .2s;
        cursor: pointer;
    }

    .payroll-page .button:focus-visible,
    .payroll-page .module-link:focus-visible {
        outline: 3px solid #93c5fd;
        outline-offset: 3px;
    }

    .payroll-page .button-primary {
        background: #2563eb;
        color: #fff;
    }

    .payroll-page .button-primary:hover {
        background: #1d4ed8;
    }

    .payroll-page .button-secondary {
        background: #fff;
        border-color: #e5e7eb;
        color: #374151;
    }

    .payroll-page .button-secondary:hover {
        background: #f9fafb;
        border-color: #d1d5db;
    }

    .payroll-page .summary-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 25px;
    }

    .payroll-page .summary-card {
        min-width: 0;
        padding: 20px;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        box-shadow: 0 2px 5px rgb(15 23 42 / 2%);
    }

    .payroll-page .summary-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .payroll-page .summary-label {
        color: #6b7280;
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .5px;
    }

    .payroll-page .summary-icon {
        display: grid;
        place-items: center;
        flex-shrink: 0;
        width: 36px;
        height: 36px;
        border-radius: 9px;
        background: #eff6ff;
        color: #2563eb;
        font-size: 17px;
    }

    .payroll-page .summary-value {
        margin-top: 15px;
        font-size: clamp(22px, 2vw, 28px);
        font-weight: 700;
        line-height: 1.25;
        letter-spacing: -.6px;
        overflow-wrap: anywhere;
    }

    .payroll-page .summary-description {
        margin-top: 7px;
        color: #9ca3af;
        font-size: 11px;
        line-height: 1.5;
    }

    .payroll-page .content-card {
        margin-bottom: 22px;
        overflow: hidden;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
    }

    .payroll-page .card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 20px 22px;
        border-bottom: 1px solid #f0f1f3;
    }

    .payroll-page .card-header h2 {
        margin: 0;
        font-size: 14px;
        font-weight: 700;
    }

    .payroll-page .card-header p {
        margin: 5px 0 0;
        color: #9ca3af;
        font-size: 11px;
        line-height: 1.5;
    }

    .payroll-page .section-tag {
        padding: 6px 9px;
        border-radius: 6px;
        background: #f3f4f6;
        color: #6b7280;
        font-size: 10px;
        font-weight: 600;
        white-space: nowrap;
    }

    .payroll-page .payroll-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 15px;
        padding: 22px;
    }

    .payroll-page .payroll-card {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        min-width: 0;
        min-height: 180px;
        padding: 19px;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        transition: border-color .2s, box-shadow .2s, transform .2s;
    }

    .payroll-page .payroll-card:hover {
        border-color: #bfdbfe;
        box-shadow: 0 5px 16px rgb(37 99 235 / 5%);
        transform: translateY(-2px);
    }

    .payroll-page .module-icon {
        display: grid;
        place-items: center;
        width: 38px;
        height: 38px;
        margin-bottom: 15px;
        border-radius: 10px;
        background: #f3f6ff;
        color: #2563eb;
        font-size: 18px;
    }

    .payroll-page .payroll-card h3 {
        margin: 0 0 8px;
        font-size: 13px;
        font-weight: 700;
    }

    .payroll-page .payroll-card p {
        margin: 0;
        color: #6b7280;
        font-size: 11px;
        line-height: 1.7;
    }

    .payroll-page .module-link {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        margin-top: auto;
        padding-top: 16px;
        color: #2563eb;
        font-size: 11px;
        font-weight: 700;
        text-decoration: none;
    }

    .payroll-page .module-link:hover {
        color: #1d4ed8;
        text-decoration: underline;
    }

    .payroll-page .setup-panel {
        display: flex;
        align-items: flex-start;
        gap: 15px;
        padding: 24px;
    }

    .payroll-page .setup-icon {
        display: grid;
        flex-shrink: 0;
        place-items: center;
        width: 44px;
        height: 44px;
        border-radius: 11px;
        background: #eff6ff;
        color: #2563eb;
        font-size: 20px;
    }

    .payroll-page .setup-copy {
        flex: 1;
        min-width: 0;
    }

    .payroll-page .setup-copy h3 {
        margin: 1px 0 7px;
        font-size: 14px;
    }

    .payroll-page .setup-copy p {
        margin: 0;
        color: #6b7280;
        font-size: 12px;
        line-height: 1.7;
    }

    .payroll-page .setup-copy .setup-note {
        margin-top: 10px;
        color: #9ca3af;
        font-size: 11px;
    }

    .payroll-page .setup-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-top: 12px;
        padding: 6px 9px;
        border-radius: 6px;
        background: #fffbeb;
        color: #92400e;
        font-size: 11px;
        font-weight: 600;
    }

    @media (max-width: 1100px) {
        .payroll-page .summary-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .payroll-page .payroll-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 700px) {
        .payroll-page {
            padding: 20px;
        }

        .payroll-page .page-heading {
            align-items: stretch;
            flex-direction: column;
        }

        .payroll-page .heading-actions {
            width: 100%;
        }

        .payroll-page .heading-actions .button {
            flex: 1;
        }

        .payroll-page .payroll-grid {
            padding: 15px;
            gap: 12px;
        }

        .payroll-page .card-header {
            padding: 17px;
        }
    }

    @media (max-width: 480px) {
        .payroll-page {
            padding: 14px;
        }

        .payroll-page .heading-copy h1 {
            font-size: 21px;
        }

        .payroll-page .summary-grid,
        .payroll-page .payroll-grid {
            grid-template-columns: 1fr;
        }

        .payroll-page .summary-card {
            padding: 17px;
        }

        .payroll-page .payroll-card {
            min-height: 160px;
        }

        .payroll-page .setup-panel {
            padding: 17px;
        }

        .payroll-page .section-tag {
            display: none;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .payroll-page *,
        .payroll-page *::before,
        .payroll-page *::after {
            transition: none !important;
            transform: none !important;
            scroll-behavior: auto !important;
        }
    }
</style>

<%
    const safeEmployeeCount = Math.max(
        0,
        Number(employeeCount) || 0
    );

    const safeGrossSalary = Math.max(
        0,
        Number(grossSalary) || 0
    );

    const safeDeductions = Math.max(
        0,
        Number(deductions) || 0
    );

    const safeNetPayroll = Math.max(
        0,
        Number(netPayroll) || 0
    );

    const formatMoney = (amount) =>
        Number(amount).toLocaleString("en-IN", {
            minimumFractionDigits: 0,
            maximumFractionDigits: 2
        });

    const formatCount = (count) =>
        Number(count).toLocaleString("en-IN");
%>

<%- include('../partials/navbar') %>

<section class="payroll-page">

    <header class="page-heading">
        <div class="heading-copy">
            <h1>Payroll Management</h1>
            <p>
                Manage employee compensation, salary structures,
                deductions and payroll records.
            </p>
        </div>

        <div class="heading-actions">
            <a href="/reports/payroll" class="button button-secondary">
                Payroll Reports
            </a>

            <a href="/payroll/process" class="button button-primary">
                <span aria-hidden="true">＋</span>
                Run Payroll
            </a>
        </div>
    </header>

    <!-- CURRENT SALARY SUMMARY -->

    <div class="summary-grid">

        <article class="summary-card">
            <div class="summary-top">
                <div class="summary-label">Active Employees</div>
                <div class="summary-icon" aria-hidden="true">♙</div>
            </div>

            <div class="summary-value">
                <%= formatCount(safeEmployeeCount) %>
            </div>

            <div class="summary-description">
                Active employees in your organization
            </div>
        </article>

        <article class="summary-card">
            <div class="summary-top">
                <div class="summary-label">Current Gross Salary</div>
                <div class="summary-icon" aria-hidden="true">₹</div>
            </div>

            <div class="summary-value">
                ₹<%= formatMoney(safeGrossSalary) %>
            </div>

            <div class="summary-description">
                Combined gross amount from current effective salary structures
            </div>
        </article>

        <article class="summary-card">
            <div class="summary-top">
                <div class="summary-label">Current Deductions</div>
                <div class="summary-icon" aria-hidden="true">−</div>
            </div>

            <div class="summary-value">
                ₹<%= formatMoney(safeDeductions) %>
            </div>

            <div class="summary-description">
                Combined deductions configured in current salary structures
            </div>
        </article>

        <article class="summary-card">
            <div class="summary-top">
                <div class="summary-label">Estimated Monthly Net</div>
                <div class="summary-icon" aria-hidden="true">✓</div>
            </div>

            <div class="summary-value">
                ₹<%= formatMoney(safeNetPayroll) %>
            </div>

            <div class="summary-description">
                Estimated net amount based on configured salary structures
            </div>
        </article>

    </div>

    <!-- PAYROLL MODULES -->

    <section class="content-card">
        <header class="card-header">
            <div>
                <h2>Payroll Operations</h2>
                <p>
                    Access salary configuration, payroll processing
                    and compensation records.
                </p>
            </div>

            <span class="section-tag">PAYROLL WORKSPACE</span>
        </header>

        <div class="payroll-grid">

            <article class="payroll-card">
                <div class="module-icon" aria-hidden="true">▤</div>

                <h3>Salary Structure</h3>

                <p>
                    Manage basic salary, allowances, deductions
                    and employee compensation components.
                </p>

                <a class="module-link" href="/payroll/salary-structures">
                    Manage salary
                    <span aria-hidden="true">→</span>
                </a>
            </article>

            <article class="payroll-card">
                <div class="module-icon" aria-hidden="true">₹</div>

                <h3>Payroll Processing</h3>

                <p>
                    Access the payroll processing page to review
                    the monthly payroll workflow.
                </p>

                <a class="module-link" href="/payroll/process">
                    Open processing
                    <span aria-hidden="true">→</span>
                </a>
            </article>

            <article class="payroll-card">
                <div class="module-icon" aria-hidden="true">▧</div>

                <h3>Payslips</h3>

                <p>
                    Access the payslips area for available
                    employee payroll records.
                </p>

                <a class="module-link" href="/payroll/payslips">
                    View payslips
                    <span aria-hidden="true">→</span>
                </a>
            </article>

            <article class="payroll-card">
                <div class="module-icon" aria-hidden="true">◷</div>

                <h3>Payroll History</h3>

                <p>
                    Open the payroll history page to review
                    payroll cycle records.
                </p>

                <a class="module-link" href="/payroll/history">
                    View history
                    <span aria-hidden="true">→</span>
                </a>
            </article>

            <article class="payroll-card">
                <div class="module-icon" aria-hidden="true">≡</div>

                <h3>Deductions</h3>

                <p>
                    Review configured provident fund, professional tax,
                    TDS and other deductions.
                </p>

                <a class="module-link" href="/payroll/deductions">
                    Review deductions
                    <span aria-hidden="true">→</span>
                </a>
            </article>

            <article class="payroll-card">
                <div class="module-icon" aria-hidden="true">▥</div>

                <h3>Payroll Reports</h3>

                <p>
                    Access the payroll reporting page for available
                    compensation and payroll summaries.
                </p>

                <a class="module-link" href="/reports/payroll">
                    View reports
                    <span aria-hidden="true">→</span>
                </a>
            </article>

        </div>
    </section>

    <!-- PAYROLL SETUP -->

    <section class="content-card">
        <header class="card-header">
            <div>
                <h2>Payroll Setup &amp; Status</h2>
                <p>
                    Verify configuration before running a payroll cycle.
                </p>
            </div>

            <span class="section-tag">SETUP</span>
        </header>

        <div class="setup-panel">
            <div class="setup-icon" aria-hidden="true">⚙</div>

            <div class="setup-copy">
                <h3>Verify payroll configuration</h3>

                <p>
                    Ensure employees have valid salary structures and
                    verify payroll periods, attendance inputs, allowances,
                    deductions and applicable statutory rules.
                </p>

                <p class="setup-note">
                    The figures above represent configured salary amounts.
                    They are not confirmation of a processed or paid payroll.
                </p>

                <div class="setup-status">
                    <span aria-hidden="true">●</span>
                    Salary summary only — payroll processing status not confirmed
                </div>
            </div>
        </div>
    </section>

</section>
