
<%
    const safeNumber = (value) => {
        const number = Number(value || 0);
        return Number.isFinite(number) ? number : 0;
    };

    const formatMoney = (value) => {
        return new Intl.NumberFormat("en-IN", {
            style: "currency",
            currency: "INR",
            maximumFractionDigits: 2
        }).format(safeNumber(value));
    };

    const formatDate = (value) => {
        if (!value) return "—";

        const date = new Date(value);

        if (Number.isNaN(date.getTime())) return "—";

        return date.toLocaleDateString("en-IN", {
            day: "2-digit",
            month: "short",
            year: "numeric",
            timeZone: "Asia/Kolkata"
        });
    };

    const structures = Array.isArray(salaryStructures)
        ? salaryStructures
        : [];

    const totalEmployees = safeNumber(employeeCount);
    const totalStructures = structures.length;

    const activeStructures = structures.filter(
        item => item.status === "ACTIVE"
    ).length;

    const missingStructures = Math.max(
        0,
        totalEmployees - totalStructures
    );

    const currentMonth = new Date().getMonth() + 1;
    const currentYear = new Date().getFullYear();

    const monthNames = [
        "January", "February", "March", "April",
        "May", "June", "July", "August",
        "September", "October", "November", "December"
    ];

    const employeeLabel = (employee) => {
        if (!employee) return "Employee not found";

        const name = [
            employee.firstName,
            employee.lastName
        ].filter(Boolean).join(" ");

        return name || employee.employeeId || employee.email || "Employee";
    };
%>

<style>
    .payroll-page {
        --payroll-ink: #172033;
        --payroll-muted: #718096;
        --payroll-border: #e7ebf2;
        --payroll-primary: #4f46e5;
        --payroll-bg: #f6f8fc;
        color: var(--payroll-ink);
        padding: 8px 0 32px;
    }

    .payroll-page * {
        box-sizing: border-box;
    }

    .payroll-page a {
        text-decoration: none;
    }

    .payroll-page button,
    .payroll-page input,
    .payroll-page select,
    .payroll-page textarea {
        font: inherit;
    }

    .payroll-hero {
        position: relative;
        overflow: hidden;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 24px;
        padding: 30px;
        margin-bottom: 24px;
        color: #fff;
        border-radius: 22px;
        background: linear-gradient(120deg, #29246d, #4f46e5 62%, #7c3aed);
        box-shadow: 0 15px 35px rgba(79, 70, 229, .16);
    }

    .payroll-hero::after {
        content: "";
        position: absolute;
        width: 240px;
        height: 240px;
        right: 8%;
        top: -150px;
        border: 35px solid rgba(255,255,255,.08);
        border-radius: 50%;
        pointer-events: none;
    }

    .payroll-hero-content {
        position: relative;
        z-index: 1;
    }

    .payroll-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 10px;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: #dcdcff;
    }

    .payroll-hero h1 {
        margin: 0 0 10px;
        color: #fff;
        font-size: clamp(26px, 3vw, 36px);
        font-weight: 850;
        letter-spacing: -.8px;
    }

    .payroll-hero p {
        max-width: 570px;
        margin: 0;
        color: #e4e4ff;
        font-size: 14px;
        line-height: 1.8;
    }

    .payroll-hero-actions {
        position: relative;
        z-index: 2;
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .payroll-btn {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
        min-height: 43px;
        padding: 11px 16px;
        border: 1px solid transparent;
        border-radius: 11px;
        font-size: 13px;
        font-weight: 750;
        cursor: pointer;
        transition: transform .2s ease, box-shadow .2s ease;
    }

    .payroll-btn:hover {
        transform: translateY(-2px);
    }

    .payroll-btn-light {
        background: #fff;
        color: #3730a3;
    }

    .payroll-btn-outline {
        color: #fff;
        border-color: rgba(255,255,255,.35);
        background: rgba(255,255,255,.10);
    }

    .payroll-btn-primary {
        color: #fff;
        background: var(--payroll-primary);
        box-shadow: 0 5px 14px rgba(79,70,229,.15);
    }

    .payroll-btn-secondary {
        color: #344054;
        background: #fff;
        border-color: var(--payroll-border);
    }

    .payroll-section-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 14px;
        margin: 27px 0 15px;
    }

    .payroll-section-heading h2 {
        margin: 0;
        font-size: 17px;
        font-weight: 850;
        letter-spacing: -.3px;
    }

    .payroll-section-heading p {
        margin: 5px 0 0;
        color: var(--payroll-muted);
        font-size: 12px;
    }

    .payroll-period {
        padding: 8px 12px;
        border: 1px solid var(--payroll-border);
        border-radius: 10px;
        background: #fff;
        color: #475467;
        font-size: 12px;
        font-weight: 750;
