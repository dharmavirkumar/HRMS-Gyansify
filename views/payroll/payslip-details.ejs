
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Payslip Details | Gyansify HRMS</title>
    <link rel="stylesheet" href="/css/dashboard.css">

    <style>
        :root {
            --ps-ink: #172033;
            --ps-muted: #667085;
            --ps-border: #d9dee7;
            --ps-soft: #f4f6f9;
            --ps-blue: #173b72;
            --ps-green: #16794b;
        }

        .payslip-page,
        .payslip-page * {
            box-sizing: border-box;
        }

        .payslip-page {
            width: 100%;
            max-width: 1120px;
            margin: 28px auto;
            padding: 0 22px 35px;
            color: var(--ps-ink);
            font-family: Arial, Helvetica, sans-serif;
            font-size: 13px;
        }

        .payslip-page a {
            text-decoration: none;
        }

        .ps-toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 18px;
        }

        .ps-toolbar-group {
            display: flex;
            flex-wrap: wrap;
            gap: 9px;
        }

        .ps-button {
            display: inline-flex;
            justify-content: center;
            align-items: center;
            gap: 8px;
            min-height: 39px;
            padding: 10px 15px;
            border: 1px solid #d8dfeb;
            border-radius: 7px;
            background: #fff;
            color: #344054;
            font: inherit;
            font-weight: 700;
            cursor: pointer;
            transition: background .15s ease;
        }

        .ps-button:hover {
            background: #f1f5f9;
        }

        .ps-button-primary {
            background: var(--ps-blue);
            border-color: var(--ps-blue);
            color: #fff;
        }

        .ps-button-primary:hover {
            background: #102e5c;
            color: #fff;
        }

        /* Payslip document */

        .payslip-document {
            overflow: hidden;
            background: #fff;
            border: 1px solid var(--ps-border);
            border-radius: 8px;
            box-shadow: 0 8px 30px rgba(16, 24, 40, .06);
        }

        .ps-company-header {
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto;
            gap: 20px;
            align-items: center;
            padding: 27px 30px 23px;
            border-bottom: 3px solid var(--ps-blue);
        }

        .ps-brand {
            display: flex;
            align-items: center;
            gap: 14px;
            min-width: 0;
        }

        .ps-brand-mark {
            display: flex;
            width: 54px;
            height: 54px;
            flex: 0 0 54px;
            align-items: center;
            justify-content: center;
            border-radius: 10px;
            background: var(--ps-blue);
            color: #fff;
            font-size: 22px;
            font-weight: 800;
            letter-spacing: -1px;
        }

        .ps-company-name {
            margin: 0;
            color: var(--ps-blue);
            font-size: 25px;
            font-weight: 800;
            letter-spacing: -.6px;
            overflow-wrap: anywhere;
        }

        .ps-company-subtitle {
            margin: 5px 0 0;
            color: var(--ps-muted);
            font-size: 11px;
            letter-spacing: 1.1px;
            text-transform: uppercase;
        }

        .ps-company-address {
            max-width: 310px;
            margin: 7px 0 0;
            color: var(--ps-muted);
            font-size: 11px;
            line-height: 1.6;
        }

        .ps-document-meta {
            min-width: 185px;
            text-align: right;
        }

        .ps-document-label {
            margin: 0 0 7px;
            color: var(--ps-muted);
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 1.4px;
            text-transform: uppercase;
        }

        .ps-period {
            margin: 0;
            color: var(--ps-ink);
            font-size: 17px;
            font-weight: 800;
        }

        .ps-payroll-number {
            margin-top: 7px;
            color: var(--ps-muted);
            font-size: 11px;
            overflow-wrap: anywhere;
        }

        .ps-document-body {
            padding: 25px 30px 27px;
        }

        .ps-section {
            margin-bottom: 24px;
        }

        .ps-section-heading {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            margin: 0 0 12px;
            padding-bottom: 9px;
            border-bottom: 1px solid var(--ps-border);
            color: var(--ps-blue);
            font-size: 12px;
            font-weight: 800;
            letter-spacing: .65px;
            text-transform: uppercase;
        }

        .ps-status {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 5px 9px;
            border: 1px solid #e5e7eb;
            border-radius: 20px;
            background: #f8fafc;
            color: #475467;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: .2px;
            text-transform: uppercase;
        }

        .ps-status-paid,
        .ps-status-completed {
            border-color: #b7e4cc;
            background: #ecfdf3;
            color: #067647;
        }

        .ps-status-pending,
        .ps-status-processing {
            border-color: #f4d58d;
            background: #fffaeb;
            color: #93370d;
        }

        .ps-status-failed,
        .ps-status-rejected,
        .ps-status-cancelled {
            border-color: #fecdca;
            background: #fef3f2;
            color: #b42318;
        }

        .ps-employee-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            border-top: 1px solid var(--ps-border);
            border-left: 1px solid var(--ps-border);
        }

        .ps-info-item {
            display: grid;
            grid-template-columns: minmax(105px, .85fr) minmax(0, 1.15fr);
            gap: 10px;
            min-height: 43px;
            align-items: center;
            padding: 10px 12px;
            border-right: 1px solid var(--ps-border);
            border-bottom: 1px solid var(--ps-border);
        }

        .ps-info-label {
            color: var(--ps-muted);
            font-size: 11px;
            line-height: 1.5;
        }

        .ps-info-value {
            color: var(--ps-ink);
            font-size: 11px;
            font-weight: 700;
            text-align: right;
            overflow-wrap: anywhere;
        }

        .ps-salary-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 18px;
            align-items: start;
        }

        .ps-salary-panel {
            min-width: 0;
            border: 1px solid var(--ps-border);
            border-radius: 5px;
            overflow: hidden;
        }

        .ps-salary-panel-title {
            margin: 0;
            padding: 12px 14px;
            background: var(--ps-blue);
            color: #fff;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: .6px;
            text-transform: uppercase;
        }

        .ps-salary-table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }

        .ps-salary-table th,
        .ps-salary-table td {
            padding: 10px 12px;
            border-bottom: 1px solid #e9edf3;
            font-size: 11px;
            line-height: 1.5;
            overflow-wrap: anywhere;
        }

        .ps-salary-table th {
            background: #f5f7fa;
            color: #475467;
            font-size: 10px;
            font-weight: 800;
            text-align: left;
        }

        .ps-salary-table th:last-child,
        .ps-salary-table td:last-child {
            width: 38%;
            text-align: right;
            font-variant-numeric: tabular-nums;
        }

        .ps-salary-table tbody tr:last-child td {
            border-bottom: 0;
        }

        .ps-salary-table .ps-total-row td {
            border-top: 1px solid #cfd7e3;
            background: #f5f7fa;
            color: var(--ps-ink);
            font-weight: 800;
        }

        .ps-money {
            white-space: nowrap;
        }

        .ps-net-pay {
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto;
            align-items: center;
            gap: 20px;
            margin-top: 20px;
            padding: 19px 22px;
            border: 1px solid #c8d9f2;
            border-left: 5px solid var(--ps-blue);
            border-radius: 5px;
            background: #f0f5fc;
        }

        .ps-net-label {
            margin: 0;
            color: var(--ps-blue);
            font-size: 11px;
            font-weight: 800;
            letter-spacing: .8px;
            text-transform: uppercase;
        }

        .ps-net-caption {
            margin: 6px 0 0;
            color: var(--ps-muted);
            font-size: 10px;
        }

        .ps-net-amount {
            color: var(--ps-blue);
            font-size: 25px;
            font-weight: 800;
            text-align: right;
            font-variant-numeric: tabular-nums;
        }

        .ps-payment-details {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 12px;
            margin-top: 15px;
        }

        .ps-payment-item {
            padding: 12px;
            border: 1px solid var(--ps-border);
            border-radius: 5px;
        }

        .ps-payment-label {
            display: block;
            margin-bottom: 6px;
            color: var(--ps-muted);
            font-size: 10px;
        }

        .ps-payment-value {
            display: block;
            color: var(--ps-ink);
            font-size: 12px;
            font-weight: 800;
            overflow-wrap: anywhere;
        }

        .ps-footer {
            display: flex;
            justify-content: space-between;
            gap: 20px;
            align-items: flex-end;
            margin-top: 30px;
            padding-top: 20px;
            border-top: 1px solid var(--ps-border);
        }

        .ps-footer-note {
            max-width: 420px;
            margin: 0;
            color: var(--ps-muted);
            font-size: 10px;
            line-height: 1.7;
        }

        .ps-signature {
            min-width: 165px;
            text-align: center;
        }

        .ps-signature-space {
            height: 35px;
            margin-bottom: 7px;
            border-bottom: 1px solid #98a2b3;
        }

        .ps-signature-label {
            color: #344054;
            font-size: 10px;
            font-weight: 700;
        }

        .ps-document-end {
            padding: 11px 20px;
            border-top: 1px solid var(--ps-border);
            background: #f8fafc;
            color: var(--ps-muted);
            font-size: 9px;
            text-align: center;
        }

        .ps-alert {
            margin-bottom: 15px;
            padding: 12px 15px;
            border: 1px solid #fecdca;
            border-radius: 7px;
            background: #fef3f2;
            color: #b42318;
        }

        @media (max-width: 720px) {
            .payslip-page {
                margin-top: 16px;
                padding: 0 12px 25px;
            }

            .ps-company-header {
                grid-template-columns: 1fr;
                padding: 20px;
            }

            .ps-document-meta {
                text-align: left;
            }

            .ps-document-body {
                padding: 20px;
            }

            .ps-employee-grid,
            .ps-salary-grid {
                grid-template-columns: 1fr;
            }

            .ps-payment-details {
                grid-template-columns: 1fr;
            }

            .ps-footer {
                align-items: stretch;
                flex-direction: column;
            }

            .ps-signature {
                align-self: flex-end;
                width: 200px;
            }

            .ps-net-amount {
                font-size: 20px;
            }
        }

        @media (max-width: 420px) {
            .ps-brand-mark {
                width: 44px;
                height: 44px;
                flex-basis: 44px;
                font-size: 18px;
            }

            .ps-company-name {
                font-size: 21px;
            }

            .ps-document-body {
                padding: 14px;
            }

            .ps-info-item {
                grid-template-columns: minmax(95px, .8fr) minmax(0, 1.2fr);
                gap: 7px;
                padding: 9px;
            }

            .ps-net-pay {
                padding: 15px;
            }

            .ps-net-amount {
                font-size: 17px;
            }
        }

        @page {
            size: A4 portrait;
            margin: 10mm;
        }

        @media print {
            html,
            body {
                margin: 0 !important;
                padding: 0 !important;
                background: #fff !important;
                color: #172033 !important;
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }

            /* Hide page navigation and application chrome. */
            .no-print,
            nav,
            aside,
            .sidebar,
            .navbar,
            .public-navbar,
            footer:not(.ps-footer) {
                display: none !important;
            }

            .payslip-page {
                width: 100%;
                max-width: none;
                margin: 0 !important;
                padding: 0 !important;
                font-size: 10px;
            }

            .payslip-document {
                overflow: visible;
                border: 1px solid #cbd5e1;
                border-radius: 0;
                box-shadow: none;
            }

            .ps-company-header {
                padding: 15px 17px;
            }

            .ps-brand-mark {
                width: 42px;
                height: 42px;
                flex-basis: 42px;
                font-size: 17px;
            }

            .ps-company-name {
                font-size: 21px;
            }

            .ps-document-body {
                padding: 16px 17px;
            }

            .ps-section {
                margin-bottom: 16px;
            }

            .ps-info-item {
                min-height: 33px;
                padding: 6px 8px;
            }

            .ps-info-label,
            .ps-info-value,
            .ps-salary-table th,
            .ps-salary-table td {
                font-size: 9px;
            }

            .ps-salary-grid {
                gap: 10px;
            }

            .ps-salary-table th,
            .ps-salary-table td {
                padding: 7px 8px;
            }

            .ps-net-pay {
                margin-top: 13px;
                padding: 13px 15px;
            }

            .ps-net-amount {
                font-size: 20px;
            }

            .ps-payment-details {
                gap: 8px;
                margin-top: 10px;
            }

            .ps-payment-item {
                padding: 8px;
            }

            .ps-footer {
                margin-top: 20px;
                padding-top: 12px;
            }

            .ps-signature-space {
                height: 28px;
            }

            .ps-section,
            .ps-employee-grid,
            .ps-salary-panel,
            .ps-net-pay,
            .ps-payment-details,
            .ps-footer {
                break-inside: avoid;
                page-break-inside: avoid;
            }

            a {
                color: inherit !important;
            }
        }
    </style>
</head>

<body>

    <%- include('../partials/navbar') %>

    <%
        const employee = payslip?.employee || {};
        const payroll = payslip?.payroll || {};

        const employeeName =
            payslip?.employeeName ||
            [employee.firstName, employee.lastName]
                .filter(Boolean)
                .join(" ") ||
            employee.name ||
            "—";

        const employeeCode =
            payslip?.employeeCode ||
            employee.employeeId ||
            employee.employeeCode ||
            "—";

        const payrollMonth = Number(payslip?.payrollMonth || 0);
        const payrollYear = payslip?.payrollYear || "";

        const monthNames = [
            "January", "February", "March", "April",
            "May", "June", "July", "August",
            "September", "October", "November", "December"
        ];

        const periodLabel =
            payrollMonth >= 1 && payrollMonth <= 12
                ? monthNames[payrollMonth - 1] + (payrollYear ? " " + payrollYear : "")
                : (payrollYear ? String(payrollYear) : "Payroll Period");

        const rawStatus = String(
            payslip?.paymentStatus ||
            payslip?.status ||
            payroll?.status ||
            "PENDING"
        ).trim().toUpperCase();

        const statusClass = rawStatus.toLowerCase().replace(/[^a-z0-9_-]/g, "");

        const formatMoney = (value) => {
            const amount = Number(value ?? 0);
            return (Number.isFinite(amount) ? amount : 0).toLocaleString(
                "en-IN",
                {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                }
            );
        };

        const formatDate = (value) => {
            if (!value) return "Not recorded";

            const date = new Date(value);

            return Number.isNaN(date.getTime())
                ? "Not recorded"
                : date.toLocaleDateString("en-IN", {
                    day: "2-digit",
                    month: "short",
                    year: "numeric",
                    timeZone: "Asia/Kolkata"
                });
        };

        const totalGross = Number(payslip?.grossSalary ?? 0) || 0;
        const totalDeductions = Number(payslip?.totalDeductions ?? 0) || 0;
        const netSalary = Number(
            payslip?.netSalary ??
            (totalGross - totalDeductions)
        ) || 0;

        const earnings = [
            ["Basic Salary", payslip?.basicSalary],
            ["House Rent Allowance (HRA)", payslip?.hra],
            ["Conveyance Allowance", payslip?.conveyanceAllowance],
            ["Medical Allowance", payslip?.medicalAllowance],
            ["Special Allowance", payslip?.specialAllowance],
            ["Other Allowance", payslip?.otherAllowance]
        ];

        const deductions = [
            ["Provident Fund (PF)", payslip?.providentFund],
            ["Professional Tax", payslip?.professionalTax],
            ["Tax Deducted at Source (TDS)", payslip?.tds],
            ["Other Deductions", payslip?.otherDeduction]
        ];

        const companyName =
            (typeof organization !== "undefined" && organization?.name) ||
            "Gyansify";

        const companyAddress =
            (typeof organization !== "undefined" && organization?.address) ||
            "";

        const paymentDate =
            payslip?.paymentDate ||
            payroll?.paymentDate ||
            null;

        const bankName =
            employee.bankName ||
            payslip?.bankName ||
            "";

        const maskedAccount = (value) => {
            const account = String(value || "").replace(/\s/g, "");
            if (!account) return "Not provided";
            if (account.length <= 4) return "••••" + account;
            return "•••• •••• " + account.slice(-4);
        };
    %>

    <main class="payslip-page">

        <div class="ps-toolbar no-print">
            <a class="ps-button" href="/payroll/payslips">
                ← Back to Payslips
            </a>

            <div class="ps-toolbar-group">
                <button
                    type="button"
                    class="ps-button ps-button-primary"
                    onclick="window.print()"
                >
                    ⤓ Print / Save PDF
                </button>
            </div>
        </div>

        <% if (typeof error !== "undefined" && error) { %>
            <div class="ps-alert no-print" role="alert">
                <%= error %>
            </div>
        <% } %>

        <article class="payslip-document">

            <!-- COMPANY HEADER -->
            <header class="ps-company-header">
                <div class="ps-brand">
                    <div class="ps-brand-mark" aria-hidden="true">G</div>

                    <div>
                        <h1 class="ps-company-name"><%= companyName %></h1>
                        <p class="ps-company-subtitle">
                            Human Resources &amp; Payroll
                        </p>

                        <% if (companyAddress) { %>
                            <p class="ps-company-address">
                                <%= companyAddress %>
                            </p>
                        <% } %>
                    </div>
                </div>

                <div class="ps-document-meta">
                    <p class="ps-document-label">Salary Statement</p>
                    <p class="ps-period"><%= periodLabel %></p>

                    <div class="ps-payroll-number">
                        Reference:
                        <strong><%= payroll.payrollNumber || payslip._id || "—" %></strong>
                    </div>

                    <div style="margin-top: 9px;">
                        <span class="ps-status ps-status-<%= statusClass %>">
                            <%= rawStatus.replace(/_/g, " ") %>
                        </span>
                    </div>
                </div>
            </header>

            <div class="ps-document-body">

                <!-- EMPLOYEE DETAILS -->
                <section class="ps-section">
                    <h2 class="ps-section-heading">
                        Employee Information
                    </h2>

                    <div class="ps-employee-grid">

                        <div class="ps-info-item">
                            <span class="ps-info-label">Employee Name</span>
                            <span class="ps-info-value"><%= employeeName %></span>
                        </div>

                        <div class="ps-info-item">
                            <span class="ps-info-label">Employee Code</span>
                            <span class="ps-info-value"><%= employeeCode %></span>
                        </div>

                        <div class="ps-info-item">
                            <span class="ps-info-label">Email Address</span>
                            <span class="ps-info-value">
                                <%= payslip.email || employee.email || "—" %>
                            </span>
                        </div>

                        <div class="ps-info-item">
                            <span class="ps-info-label">Department</span>
                            <span class="ps-info-value">
                                <%= employee.department?.name ||
                                    payslip.departmentName ||
                                    (typeof employee.department === "string" ? employee.department : "—") %>
                            </span>
                        </div>

                        <div class="ps-info-item">
                            <span class="ps-info-label">Designation</span>
                            <span class="ps-info-value">
                                <%= employee.designation?.name ||
                                    payslip.designation ||
                                    (typeof employee.designation === "string" ? employee.designation : "—") %>
                            </span>
                        </div>

                        <div class="ps-info-item">
                            <span class="ps-info-label">Date of Joining</span>
                            <span class="ps-info-value">
                                <%= formatDate(employee.dateOfJoining || employee.joiningDate) %>
                            </span>
                        </div>

                        <div class="ps-info-item">
                            <span class="ps-info-label">Pay Period</span>
                            <span class="ps-info-value"><%= periodLabel %></span>
                        </div>

                        <div class="ps-info-item">
                            <span class="ps-info-label">Payment Date</span>
                            <span class="ps-info-value"><%= formatDate(paymentDate) %></span>
                        </div>

                    </div>
                </section>

                <!-- EARNINGS AND DEDUCTIONS -->
                <section class="ps-section">
                    <h2 class="ps-section-heading">
                        Salary Breakdown
                    </h2>

                    <div class="ps-salary-grid">

                        <section class="ps-salary-panel">
                            <h3 class="ps-salary-panel-title">Earnings</h3>

                            <table class="ps-salary-table">
                                <thead>
                                    <tr>
                                        <th scope="col">Particulars</th>
                                        <th scope="col">Amount (₹)</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    <% earnings.forEach(([label, value]) => { %>
                                        <tr>
                                            <td><%= label %></td>
                                            <td class="ps-money">
                                                <%= formatMoney(value) %>
                                            </td>
                                        </tr>
                                    <% }); %>

                                    <tr class="ps-total-row">
                                        <td>Total Earnings</td>
                                        <td class="ps-money">
                                            <%= formatMoney(totalGross) %>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </section>

                        <section class="ps-salary-panel">
                            <h3 class="ps-salary-panel-title">Deductions</h3>

                            <table class="ps-salary-table">
                                <thead>
                                    <tr>
                                        <th scope="col">Particulars</th>
                                        <th scope="col">Amount (₹)</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    <% deductions.forEach(([label, value]) => { %>
                                        <tr>
                                            <td><%= label %></td>
                                            <td class="ps-money">
                                                <%= formatMoney(value) %>
                                            </td>
                                        </tr>
                                    <% }); %>

                                    <tr class="ps-total-row">
                                        <td>Total Deductions</td>
                                        <td class="ps-money">
                                            <%= formatMoney(totalDeductions) %>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </section>

                    </div>

                    <div class="ps-net-pay">
                        <div>
                            <p class="ps-net-label">Net Salary Payable</p>
                            <p class="ps-net-caption">
                                Total earnings minus total deductions
                            </p>
                        </div>

                        <div class="ps-net-amount">
                            ₹<%= formatMoney(netSalary) %>
                        </div>
                    </div>
                </section>

                <!-- PAYMENT DETAILS -->
                <section class="ps-section">
                    <h2 class="ps-section-heading">
                        Payment Information
                    </h2>

                    <div class="ps-payment-details">
                        <div class="ps-payment-item">
                            <span class="ps-payment-label">Payment Status</span>
                            <span class="ps-payment-value">
                                <%= rawStatus.replace(/_/g, " ") %>
                            </span>
                        </div>

                        <div class="ps-payment-item">
                            <span class="ps-payment-label">Payment Date</span>
                            <span class="ps-payment-value">
                                <%= formatDate(paymentDate) %>
                            </span>
                        </div>

                        <div class="ps-payment-item">
                            <span class="ps-payment-label">Bank Account</span>
                            <span class="ps-payment-value">
                                <%= maskedAccount(employee.bankAccountNumber || payslip.bankAccountNumber) %>
                            </span>
                        </div>
                    </div>
                </section>

                <!-- SIGNATURE AREA -->
                <footer class="ps-footer">
                    <p class="ps-footer-note">
                        This salary statement is generated by Gyansify HRMS.
                        Please contact the HR or Payroll team if any information
                        appears incorrect.
                        <br>
                        <strong>Confidential:</strong> This document contains
                        personal payroll information.
                    </p>

                    <div class="ps-signature">
                        <div class="ps-signature-space"></div>
                        <div class="ps-signature-label">
                            Authorized Signatory
                        </div>
                    </div>
                </footer>

            </div>

            <div class="ps-document-end">
                Generated from Gyansify HRMS · <%= periodLabel %>
            </div>

        </article>
    </main>

</body>
</html>
