<%
    /*
    ============================================================
    GYANSIFY HRMS - ASSETS
    views/assets/index.ejs
    ============================================================
    */

    const currentUser =
        typeof user !== "undefined" && user
            ? user
            : {};

    const assetStats =
        typeof stats !== "undefined" && stats
            ? stats
            : {
                totalAssets: 0,
                availableAssets: 0,
                assignedAssets: 0,
                maintenanceAssets: 0
            };

    const assetList =
        typeof assets !== "undefined" && Array.isArray(assets)
            ? assets
            : [];
%>


<!-- ============================================================
     PAGE HEADER
============================================================ -->

<div class="page-container">

    <div class="page-header">

        <div>
            <h1>Assets</h1>

            <p>
                Manage company assets, inventory and employee assignments.
            </p>
        </div>


        <div class="page-header-actions">

            <a
                href="/assets/create"
                class="btn-primary"
            >
                + Add Asset
            </a>

        </div>

    </div>


    <!-- ========================================================
         STATISTICS
    ========================================================= -->

    <div class="stats-grid">


        <!-- TOTAL ASSETS -->

        <div class="stat-card">

            <div class="stat-title">
                Total Assets
            </div>

            <div class="stat-value">

                <%= assetStats.totalAssets || 0 %>

            </div>

            <div class="stat-description">
                All company assets
            </div>

        </div>


        <!-- AVAILABLE -->

        <div class="stat-card">

            <div class="stat-title">
                Available
            </div>

            <div class="stat-value">

                <%= assetStats.availableAssets || 0 %>

            </div>

            <div class="stat-description">
                Ready for assignment
            </div>

        </div>


        <!-- ASSIGNED -->

        <div class="stat-card">

            <div class="stat-title">
                Assigned
            </div>

            <div class="stat-value">

                <%= assetStats.assignedAssets || 0 %>

            </div>

            <div class="stat-description">
                Currently assigned
            </div>

        </div>


        <!-- MAINTENANCE -->

        <div class="stat-card">

            <div class="stat-title">
                Maintenance
            </div>

            <div class="stat-value">

                <%= assetStats.maintenanceAssets || 0 %>

            </div>

            <div class="stat-description">
                Under maintenance
            </div>

        </div>

    </div>



    <!-- ========================================================
         ASSET INVENTORY
    ========================================================= -->

    <div class="card">


        <!-- CARD HEADER -->

        <div class="card-header">

            <div>

                <h2>
                    Asset Inventory
                </h2>

                <p>
                    View and manage all company assets.
                </p>

            </div>


            <div>

                <a
                    href="/assets/create"
                    class="btn-primary"
                >
                    + Add Asset
                </a>

            </div>

        </div>



        <!-- ====================================================
             SEARCH / FILTER BAR
        ==================================================== -->

        <div class="asset-filter-bar">

            <form
                method="GET"
                action="/assets"
                class="asset-filter-form"
            >

                <!-- SEARCH -->

                <div class="form-group">

                    <label for="search">
                        Search
                    </label>

                    <input
                        type="text"
                        id="search"
                        name="search"
                        value="<%= typeof search !== 'undefined' ? search : '' %>"
                        placeholder="Search asset..."
                    >

                </div>


                <!-- STATUS -->

                <div class="form-group">

                    <label for="status">
                        Status
                    </label>

                    <select
                        id="status"
                        name="status"
                    >

                        <option value="">
                            All Status
                        </option>

                        <option
                            value="AVAILABLE"
                            <%= typeof selectedStatus !== "undefined" && selectedStatus === "AVAILABLE" ? "selected" : "" %>
                        >
                            Available
                        </option>

                        <option
                            value="ASSIGNED"
                            <%= typeof selectedStatus !== "undefined" && selectedStatus === "ASSIGNED" ? "selected" : "" %>
                        >
                            Assigned
                        </option>

                        <option
                            value="MAINTENANCE"
                            <%= typeof selectedStatus !== "undefined" && selectedStatus === "MAINTENANCE" ? "selected" : "" %>
                        >
                            Maintenance
                        </option>

                        <option
                            value="LOST"
                            <%= typeof selectedStatus !== "undefined" && selectedStatus === "LOST" ? "selected" : "" %>
                        >
                            Lost
                        </option>

                        <option
                            value="RETIRED"
                            <%= typeof selectedStatus !== "undefined" && selectedStatus === "RETIRED" ? "selected" : "" %>
                        >
                            Retired
                        </option>

                    </select>

                </div>


                <!-- CATEGORY -->

                <div class="form-group">

                    <label for="category">
                        Category
                    </label>

                    <select
                        id="category"
                        name="category"
                    >

                        <option value="">
                            All Categories
                        </option>

                        <option
                            value="Laptop"
                            <%= typeof selectedCategory !== "undefined" && selectedCategory === "Laptop" ? "selected" : "" %>
                        >
                            Laptop
                        </option>

                        <option
                            value="Desktop"
                            <%= typeof selectedCategory !== "undefined" && selectedCategory === "Desktop" ? "selected" : "" %>
                        >
                            Desktop
                        </option>

                        <option
                            value="Monitor"
                            <%= typeof selectedCategory !== "undefined" && selectedCategory === "Monitor" ? "selected" : "" %>
                        >
                            Monitor
                        </option>

                        <option
                            value="Mobile"
                            <%= typeof selectedCategory !== "undefined" && selectedCategory === "Mobile" ? "selected" : "" %>
                        >
                            Mobile
                        </option>

                        <option
                            value="Tablet"
                            <%= typeof selectedCategory !== "undefined" && selectedCategory === "Tablet" ? "selected" : "" %>
                        >
                            Tablet
                        </option>

                        <option
                            value="Other"
                            <%= typeof selectedCategory !== "undefined" && selectedCategory === "Other" ? "selected" : "" %>
                        >
                            Other
                        </option>

                    </select>

                </div>


                <!-- SEARCH BUTTON -->

                <div class="form-group filter-button-group">

                    <button
                        type="submit"
                        class="btn-primary"
                    >
                        Search
                    </button>

                </div>


                <!-- RESET -->

                <div class="form-group filter-button-group">

                    <a
                        href="/assets"
                        class="btn-secondary"
                    >
                        Reset
                    </a>

                </div>

            </form>

        </div>



        <!-- ====================================================
             TABLE
        ==================================================== -->

        <div class="table-responsive">

            <table class="data-table">


                <!-- TABLE HEAD -->

                <thead>

                    <tr>

                        <th>
                            Asset ID
                        </th>

                        <th>
                            Asset Name
                        </th>

                        <th>
                            Category
                        </th>

                        <th>
                            Brand / Model
                        </th>

                        <th>
                            Assigned To
                        </th>

                        <th>
                            Status
                        </th>

                        <th>
                            Condition
                        </th>

                        <th>
                            Location
                        </th>

                        <th>
                            Actions
                        </th>

                    </tr>

                </thead>



                <!-- TABLE BODY -->

                <tbody>


                    <% if (assetList.length === 0) { %>


                        <!-- EMPTY STATE -->

                        <tr>

                            <td
                                colspan="9"
                                class="text-center"
                            >

                                <div class="empty-state">

                                    <div class="empty-state-icon">
                                        📦
                                    </div>

                                    <h3>
                                        No Assets Found
                                    </h3>

                                    <p>
                                        No company assets are available yet.
                                    </p>

                                    <a
                                        href="/assets/create"
                                        class="btn-primary"
                                    >
                                        + Add First Asset
                                    </a>

                                </div>

                            </td>

                        </tr>


                    <% } else { %>


                        <% assetList.forEach(asset => { %>


                            <tr>


                                <!-- ASSET ID -->

                                <td>

                                    <strong>
                                        <%= asset.assetId || "-" %>
                                    </strong>

                                </td>



                                <!-- NAME -->

                                <td>

                                    <div class="asset-name">

                                        <strong>
                                            <%= asset.name || "-" %>
                                        </strong>

                                    </div>

                                </td>



                                <!-- CATEGORY -->

                                <td>

                                    <%= asset.category || "-" %>

                                </td>



                                <!-- BRAND / MODEL -->

                                <td>

                                    <% if (asset.brand) { %>

                                        <%= asset.brand %>

                                    <% } else { %>

                                        -

                                    <% } %>


                                    <% if (asset.model) { %>

                                        <div class="text-muted">

                                            <%= asset.model %>

                                        </div>

                                    <% } %>

                                </td>



                                <!-- ASSIGNED TO -->

                                <td>


                                    <% if (asset.assignedTo) { %>


                                        <div>

                                            <strong>

                                                <%= asset.assignedTo.firstName || "" %>

                                                <%= asset.assignedTo.lastName || "" %>

                                            </strong>

                                        </div>


                                        <% if (asset.assignedTo.employeeId) { %>

                                            <div class="text-muted">

                                                <%= asset.assignedTo.employeeId %>

                                            </div>

                                        <% } %>


                                    <% } else { %>


                                        <span class="text-muted">

                                            Unassigned

                                        </span>


                                    <% } %>


                                </td>



                                <!-- STATUS -->

                                <td>


                                    <% if (asset.status === "AVAILABLE") { %>

                                        <span class="status-badge status-available">
                                            Available
                                        </span>


                                    <% } else if (asset.status === "ASSIGNED") { %>

                                        <span class="status-badge status-assigned">
                                            Assigned
                                        </span>


                                    <% } else if (asset.status === "MAINTENANCE") { %>

                                        <span class="status-badge status-maintenance">
                                            Maintenance
                                        </span>


                                    <% } else if (asset.status === "LOST") { %>

                                        <span class="status-badge status-lost">
                                            Lost
                                        </span>


                                    <% } else if (asset.status === "RETIRED") { %>

                                        <span class="status-badge status-retired">
                                            Retired
                                        </span>


                                    <% } else { %>

                                        <span class="status-badge">

                                            <%= asset.status || "-" %>

                                        </span>

                                    <% } %>


                                </td>



                                <!-- CONDITION -->

                                <td>

                                    <% if (asset.condition === "NEW") { %>

                                        New

                                    <% } else if (asset.condition === "GOOD") { %>

                                        Good

                                    <% } else if (asset.condition === "FAIR") { %>

                                        Fair

                                    <% } else if (asset.condition === "DAMAGED") { %>

                                        Damaged

                                    <% } else { %>

                                        <%= asset.condition || "-" %>

                                    <% } %>

                                </td>



                                <!-- LOCATION -->

                                <td>

                                    <%= asset.location || "-" %>

                                </td>



                                <!-- ACTIONS -->

                                <td>

                                    <div class="table-actions">


                                        <a
                                            href="/assets/<%= asset._id %>"
                                            class="btn-small"
                                        >
                                            View
                                        </a>


                                        <a
                                            href="/assets/<%= asset._id %>/edit"
                                            class="btn-small"
                                        >
                                            Edit
                                        </a>


                                    </div>

                                </td>


                            </tr>


                        <% }) %>


                    <% } %>


                </tbody>

            </table>

        </div>



        <!-- ====================================================
             FOOTER
        ==================================================== -->

        <div class="card-footer">

            <div class="asset-count">

                Showing
                <strong>
                    <%= assetList.length %>
                </strong>
                asset(s)

            </div>

        </div>


    </div>

</div>



<!-- ============================================================
     PAGE-SPECIFIC CSS
============================================================ -->

<style>

    .page-container {
        width: 100%;
    }


    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 25px;
    }


    .page-header h1 {
        margin: 0 0 6px;
    }


    .page-header p {
        margin: 0;
        opacity: 0.7;
    }


    .page-header-actions {
        display: flex;
        gap: 10px;
    }


    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 25px;
    }


    .stat-card {
        padding: 22px;
        border-radius: 12px;
        background: var(--card-bg, #ffffff);
        border: 1px solid var(--border-color, #e5e7eb);
    }


    .stat-title {
        font-size: 14px;
        opacity: 0.7;
        margin-bottom: 10px;
    }


    .stat-value {
        font-size: 30px;
        font-weight: 700;
        margin-bottom: 5px;
    }


    .stat-description {
        font-size: 12px;
        opacity: 0.6;
    }


    .card {
        background: var(--card-bg, #ffffff);
        border: 1px solid var(--border-color, #e5e7eb);
        border-radius: 12px;
        overflow: hidden;
    }


    .card-header {
        padding: 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        border-bottom: 1px solid var(--border-color, #e5e7eb);
    }


    .card-header h2 {
        margin: 0 0 5px;
    }


    .card-header p {
        margin: 0;
        opacity: 0.65;
        font-size: 14px;
    }


    .asset-filter-bar {
        padding: 20px;
        border-bottom: 1px solid var(--border-color, #e5e7eb);
    }


    .asset-filter-form {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr auto auto;
        gap: 15px;
        align-items: end;
    }


    .form-group {
        display: flex;
        flex-direction: column;
        gap: 7px;
    }


    .form-group label {
        font-size: 13px;
        font-weight: 600;
    }


    .form-group input,
    .form-group select {
        width: 100%;
        min-height: 42px;
        padding: 9px 12px;
        border: 1px solid var(--border-color, #d1d5db);
        border-radius: 8px;
        background: var(--input-bg, #ffffff);
        font-size: 14px;
        box-sizing: border-box;
    }


    .filter-button-group {
        justify-content: flex-end;
    }


    .btn-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 9px 16px;
        border-radius: 8px;
        text-decoration: none;
        border: none;
        cursor: pointer;
        font-weight: 600;
        font-size: 14px;
    }


    .btn-secondary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 9px 16px;
        border-radius: 8px;
        text-decoration: none;
        border: 1px solid var(--border-color, #d1d5db);
        cursor: pointer;
        font-weight: 600;
        font-size: 14px;
    }


    .table-responsive {
        width: 100%;
        overflow-x: auto;
    }


    .data-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 1000px;
    }


    .data-table th {
        text-align: left;
        padding: 14px 16px;
        font-size: 13px;
        font-weight: 700;
        white-space: nowrap;
        border-bottom: 1px solid var(--border-color, #e5e7eb);
    }


    .data-table td {
        padding: 15px 16px;
        font-size: 14px;
        border-bottom: 1px solid var(--border-color, #e5e7eb);
        vertical-align: middle;
    }


    .data-table tbody tr:last-child td {
        border-bottom: none;
    }


    .text-muted {
        font-size: 12px;
        opacity: 0.6;
        margin-top: 3px;
    }


    .text-center {
        text-align: center;
    }


    .status-badge {
        display: inline-flex;
        align-items: center;
        padding: 5px 9px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
        background: #f3f4f6;
    }


    .status-available {
        background: #dcfce7;
    }


    .status-assigned {
        background: #dbeafe;
    }


    .status-maintenance {
        background: #fef3c7;
    }


    .status-lost {
        background: #fee2e2;
    }


    .status-retired {
        background: #e5e7eb;
    }


    .table-actions {
        display: flex;
        gap: 7px;
        white-space: nowrap;
    }


    .btn-small {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 6px 10px;
        border: 1px solid var(--border-color, #d1d5db);
        border-radius: 6px;
        text-decoration: none;
        font-size: 12px;
        font-weight: 600;
    }


    .empty-state {
        padding: 50px 20px;
        text-align: center;
    }


    .empty-state-icon {
        font-size: 40px;
        margin-bottom: 10px;
    }


    .empty-state h3 {
        margin: 0 0 8px;
    }


    .empty-state p {
        margin: 0 0 20px;
        opacity: 0.65;
    }


    .card-footer {
        padding: 15px 20px;
        border-top: 1px solid var(--border-color, #e5e7eb);
    }


    .asset-count {
        font-size: 13px;
        opacity: 0.7;
    }


    @media (max-width: 1100px) {

        .stats-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .asset-filter-form {
            grid-template-columns: 1fr 1fr;
        }

    }


    @media (max-width: 700px) {

        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .stats-grid {
            grid-template-columns: 1fr;
        }

        .asset-filter-form {
            grid-template-columns: 1fr;
        }

        .card-header {
            flex-direction: column;
            align-items: flex-start;
        }

    }

</style>