<%
    /*
    ============================================================
    GYANSIFY HRMS - EDIT ASSET
    views/assets/edit.ejs
    ============================================================
    */

    const currentUser =
        typeof user !== "undefined" && user
            ? user
            : {};

    const employeeList =
        typeof employees !== "undefined" && Array.isArray(employees)
            ? employees
            : [];

    const assetData =
        typeof asset !== "undefined" && asset
            ? asset
            : {};

    const assetIdValue =
        assetData.assetId || "";

    const purchaseDateValue =
        assetData.purchaseDate
            ? new Date(assetData.purchaseDate)
                .toISOString()
                .split("T")[0]
            : "";

    const assignedDateValue =
        assetData.assignedDate
            ? new Date(assetData.assignedDate)
                .toISOString()
                .split("T")[0]
            : "";
%>


<!-- ============================================================
     PAGE CONTAINER
============================================================ -->

<div class="page-container">


    <!-- ========================================================
         PAGE HEADER
    ========================================================= -->

    <div class="page-header">

        <div>

            <div class="breadcrumb">

                <a href="/assets">
                    Assets
                </a>

                <span>
                    /
                </span>

                <span>
                    Edit Asset
                </span>

            </div>


            <h1>
                Edit Asset
            </h1>

            <p>
                Update asset information, assignment and status.
            </p>

        </div>


        <div class="page-header-actions">

            <a
                href="/assets/<%= assetData._id %>"
                class="btn-secondary"
            >
                View Asset
            </a>


            <a
                href="/assets"
                class="btn-secondary"
            >
                ← Back to Assets
            </a>

        </div>

    </div>



    <!-- ========================================================
         ERROR MESSAGE
    ========================================================= -->

    <% if (typeof error !== "undefined" && error) { %>

        <div class="alert-error">

            <div class="alert-icon">
                ⚠
            </div>

            <div>

                <strong>
                    Unable to update asset
                </strong>

                <p>
                    <%= error %>
                </p>

            </div>

        </div>

    <% } %>



    <!-- ========================================================
         ASSET ID INFORMATION
    ========================================================= -->

    <div class="asset-info-banner">

        <div class="asset-info-item">

            <span class="asset-info-label">
                Asset ID
            </span>

            <strong>
                <%= assetData.assetId || "-" %>
            </strong>

        </div>


        <div class="asset-info-item">

            <span class="asset-info-label">
                Created
            </span>

            <strong>

                <% if (assetData.createdAt) { %>

                    <%= new Date(assetData.createdAt).toLocaleDateString("en-IN") %>

                <% } else { %>

                    -

                <% } %>

            </strong>

        </div>


        <div class="asset-info-item">

            <span class="asset-info-label">
                Last Updated
            </span>

            <strong>

                <% if (assetData.updatedAt) { %>

                    <%= new Date(assetData.updatedAt).toLocaleDateString("en-IN") %>

                <% } else { %>

                    -

                <% } %>

            </strong>

        </div>

    </div>



    <!-- ========================================================
         MAIN CARD
    ========================================================= -->

    <div class="card">


        <!-- ====================================================
             CARD HEADER
        ==================================================== -->

        <div class="card-header">

            <div>

                <h2>
                    Asset Information
                </h2>

                <p>
                    Modify the details of this company asset.
                </p>

            </div>

        </div>



        <!-- ====================================================
             FORM
        ==================================================== -->

        <form
            action="/assets/<%= assetData._id %>/edit"
            method="POST"
            id="editAssetForm"
        >


            <!-- =================================================
                 BASIC INFORMATION
            ================================================== -->

            <div class="form-section">

                <div class="section-heading">

                    <div class="section-number">
                        1
                    </div>

                    <div>

                        <h3>
                            Basic Information
                        </h3>

                        <p>
                            Basic identification details of the asset.
                        </p>

                    </div>

                </div>


                <div class="form-grid">


                    <!-- ASSET ID -->

                    <div class="form-group">

                        <label for="assetId">

                            Asset ID

                        </label>

                        <input
                            type="text"
                            id="assetId"
                            name="assetId"
                            value="<%= assetIdValue %>"
                            readonly
                        >

                        <small>
                            Asset ID cannot be changed after creation.
                        </small>

                    </div>



                    <!-- ASSET NAME -->

                    <div class="form-group">

                        <label for="name">

                            Asset Name

                            <span class="required">
                                *
                            </span>

                        </label>

                        <input
                            type="text"
                            id="name"
                            name="name"
                            value="<%= assetData.name || '' %>"
                            placeholder="Example: Dell Latitude Laptop"
                            required
                        >

                    </div>



                    <!-- CATEGORY -->

                    <div class="form-group">

                        <label for="category">

                            Category

                            <span class="required">
                                *
                            </span>

                        </label>

                        <select
                            id="category"
                            name="category"
                            required
                        >

                            <option value="">
                                Select Category
                            </option>


                            <option
                                value="Laptop"
                                <%= assetData.category === "Laptop" ? "selected" : "" %>
                            >
                                Laptop
                            </option>


                            <option
                                value="Desktop"
                                <%= assetData.category === "Desktop" ? "selected" : "" %>
                            >
                                Desktop
                            </option>


                            <option
                                value="Monitor"
                                <%= assetData.category === "Monitor" ? "selected" : "" %>
                            >
                                Monitor
                            </option>


                            <option
                                value="Mobile"
                                <%= assetData.category === "Mobile" ? "selected" : "" %>
                            >
                                Mobile
                            </option>


                            <option
                                value="Tablet"
                                <%= assetData.category === "Tablet" ? "selected" : "" %>
                            >
                                Tablet
                            </option>


                            <option
                                value="Printer"
                                <%= assetData.category === "Printer" ? "selected" : "" %>
                            >
                                Printer
                            </option>


                            <option
                                value="Furniture"
                                <%= assetData.category === "Furniture" ? "selected" : "" %>
                            >
                                Furniture
                            </option>


                            <option
                                value="Other"
                                <%= assetData.category === "Other" ? "selected" : "" %>
                            >
                                Other
                            </option>

                        </select>

                    </div>



                    <!-- BRAND -->

                    <div class="form-group">

                        <label for="brand">
                            Brand
                        </label>

                        <input
                            type="text"
                            id="brand"
                            name="brand"
                            value="<%= assetData.brand || '' %>"
                            placeholder="Example: Dell"
                        >

                    </div>



                    <!-- MODEL -->

                    <div class="form-group">

                        <label for="model">
                            Model
                        </label>

                        <input
                            type="text"
                            id="model"
                            name="model"
                            value="<%= assetData.model || '' %>"
                            placeholder="Example: Latitude 5440"
                        >

                    </div>



                    <!-- SERIAL NUMBER -->

                    <div class="form-group">

                        <label for="serialNumber">
                            Serial Number
                        </label>

                        <input
                            type="text"
                            id="serialNumber"
                            name="serialNumber"
                            value="<%= assetData.serialNumber || '' %>"
                            placeholder="Enter serial number"
                        >

                    </div>

                </div>

            </div>



            <!-- =================================================
                 PURCHASE INFORMATION
            ================================================== -->

            <div class="form-section">

                <div class="section-heading">

                    <div class="section-number">
                        2
                    </div>

                    <div>

                        <h3>
                            Purchase Information
                        </h3>

                        <p>
                            Purchase and financial information.
                        </p>

                    </div>

                </div>


                <div class="form-grid">


                    <!-- PURCHASE DATE -->

                    <div class="form-group">

                        <label for="purchaseDate">
                            Purchase Date
                        </label>

                        <input
                            type="date"
                            id="purchaseDate"
                            name="purchaseDate"
                            value="<%= purchaseDateValue %>"
                        >

                    </div>



                    <!-- PURCHASE PRICE -->

                    <div class="form-group">

                        <label for="purchasePrice">
                            Purchase Price
                        </label>

                        <div class="input-with-prefix">

                            <span>
                                ₹
                            </span>

                            <input
                                type="number"
                                id="purchasePrice"
                                name="purchasePrice"
                                value="<%= assetData.purchasePrice || '' %>"
                                placeholder="0.00"
                                min="0"
                                step="0.01"
                            >

                        </div>

                    </div>

                </div>

            </div>



            <!-- =================================================
                 ASSIGNMENT
            ================================================== -->

            <div class="form-section">

                <div class="section-heading">

                    <div class="section-number">
                        3
                    </div>

                    <div>

                        <h3>
                            Assignment
                        </h3>

                        <p>
                            Assign this asset to an employee.
                        </p>

                    </div>

                </div>


                <div class="form-grid">


                    <!-- EMPLOYEE -->

                    <div class="form-group">

                        <label for="assignedTo">
                            Assigned To
                        </label>

                        <select
                            id="assignedTo"
                            name="assignedTo"
                        >

                            <option value="">
                                Not Assigned
                            </option>


                            <% employeeList.forEach(employee => { %>

                                <option
                                    value="<%= employee._id %>"
                                    <%= assetData.assignedTo &&
                                        String(
                                            assetData.assignedTo._id ||
                                            assetData.assignedTo
                                        ) === String(employee._id)
                                            ? "selected"
                                            : "" %>
                                >

                                    <%= employee.firstName || "" %>

                                    <%= employee.lastName || "" %>


                                    <% if (employee.employeeId) { %>

                                        —
                                        <%= employee.employeeId %>

                                    <% } %>

                                </option>

                            <% }) %>

                        </select>

                        <small>
                            Selecting an employee will mark the asset as Assigned.
                        </small>

                    </div>



                    <!-- ASSIGNED DATE -->

                    <div class="form-group">

                        <label for="assignedDate">
                            Assigned Date
                        </label>

                        <input
                            type="date"
                            id="assignedDate"
                            name="assignedDate"
                            value="<%= assignedDateValue %>"
                        >

                    </div>

                </div>

            </div>



            <!-- =================================================
                 STATUS & CONDITION
            ================================================== -->

            <div class="form-section">

                <div class="section-heading">

                    <div class="section-number">
                        4
                    </div>

                    <div>

                        <h3>
                            Status & Condition
                        </h3>

                        <p>
                            Update the current operational state of the asset.
                        </p>

                    </div>

                </div>


                <div class="form-grid">


                    <!-- CONDITION -->

                    <div class="form-group">

                        <label for="condition">
                            Condition
                        </label>

                        <select
                            id="condition"
                            name="condition"
                        >

                            <option
                                value="NEW"
                                <%= assetData.condition === "NEW" ? "selected" : "" %>
                            >
                                New
                            </option>


                            <option
                                value="GOOD"
                                <%= assetData.condition === "GOOD" ? "selected" : "" %>
                            >
                                Good
                            </option>


                            <option
                                value="FAIR"
                                <%= assetData.condition === "FAIR" ? "selected" : "" %>
                            >
                                Fair
                            </option>


                            <option
                                value="DAMAGED"
                                <%= assetData.condition === "DAMAGED" ? "selected" : "" %>
                            >
                                Damaged
                            </option>

                        </select>

                    </div>



                    <!-- STATUS -->

                    <div class="form-group">

                        <label for="status">
                            Status
                        </label>

                        <select
                            id="status"
                            name="status"
                        >

                            <option
                                value="AVAILABLE"
                                <%= assetData.status === "AVAILABLE" ? "selected" : "" %>
                            >
                                Available
                            </option>


                            <option
                                value="ASSIGNED"
                                <%= assetData.status === "ASSIGNED" ? "selected" : "" %>
                            >
                                Assigned
                            </option>


                            <option
                                value="MAINTENANCE"
                                <%= assetData.status === "MAINTENANCE" ? "selected" : "" %>
                                >
                                Maintenance
                            </option>


                            <option
                                value="LOST"
                                <%= assetData.status === "LOST" ? "selected" : "" %>
                            >
                                Lost
                            </option>


                            <option
                                value="RETIRED"
                                <%= assetData.status === "RETIRED" ? "selected" : "" %>
                            >
                                Retired
                            </option>

                        </select>

                    </div>



                    <!-- LOCATION -->

                    <div class="form-group">

                        <label for="location">
                            Location
                        </label>

                        <input
                            type="text"
                            id="location"
                            name="location"
                            value="<%= assetData.location || '' %>"
                            placeholder="Example: IT Department"
                        >

                    </div>

                </div>

            </div>



            <!-- =================================================
                 DESCRIPTION
            ================================================== -->

            <div class="form-section">

                <div class="section-heading">

                    <div class="section-number">
                        5
                    </div>

                    <div>

                        <h3>
                            Additional Information
                        </h3>

                        <p>
                            Add notes or additional information about this asset.
                        </p>

                    </div>

                </div>


                <div class="form-group">

                    <label for="description">
                        Description
                    </label>

                    <textarea
                        id="description"
                        name="description"
                        rows="5"
                        placeholder="Enter additional information..."
                    ><%= assetData.description || "" %></textarea>

                </div>

            </div>



            <!-- =================================================
                 CURRENT ASSIGNMENT INFORMATION
            ================================================== -->

            <% if (assetData.assignedTo) { %>

                <div class="current-assignment">

                    <div class="current-assignment-icon">
                        👤
                    </div>

                    <div>

                        <strong>
                            Currently Assigned
                        </strong>

                        <p>

                            <% if (assetData.assignedTo.firstName) { %>

                                <%= assetData.assignedTo.firstName %>

                                <%= assetData.assignedTo.lastName || "" %>

                            <% } else { %>

                                Employee assigned

                            <% } %>

                        </p>

                    </div>

                </div>

            <% } %>



            <!-- =================================================
                 FORM ACTIONS
            ================================================== -->

            <div class="form-actions">


                <a
                    href="/assets/<%= assetData._id %>"
                    class="btn-secondary"
                >
                    Cancel
                </a>


                <button
                    type="submit"
                    class="btn-primary"
                    id="saveAssetButton"
                >
                    Save Changes
                </button>

            </div>


        </form>

    </div>



    <!-- ========================================================
         RETIRE ASSET
    ========================================================= -->

    <% if (assetData.status !== "RETIRED") { %>

        <div class="danger-zone">

            <div>

                <h3>
                    Retire Asset
                </h3>

                <p>
                    Retiring an asset will remove it from active inventory.
                    The asset will not be permanently deleted.
                </p>

            </div>


            <form
                action="/assets/<%= assetData._id %>/delete"
                method="POST"
                onsubmit="return confirmRetireAsset();"
            >

                <button
                    type="submit"
                    class="btn-danger"
                >
                    Retire Asset
                </button>

            </form>

        </div>

    <% } %>


</div>



<!-- ============================================================
     PAGE-SPECIFIC CSS
============================================================ -->

<style>

    .page-container {
        width: 100%;
    }


    /* ========================================================
       HEADER
    ======================================================== */

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 20px;
        margin-bottom: 25px;
    }


    .page-header h1 {
        margin: 8px 0 6px;
    }


    .page-header p {
        margin: 0;
        opacity: 0.7;
    }


    .page-header-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }


    .breadcrumb {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        opacity: 0.65;
    }


    .breadcrumb a {
        text-decoration: none;
    }



    /* ========================================================
       CARD
    ======================================================== */

    .card {
        background: var(--card-bg, #ffffff);
        border: 1px solid var(--border-color, #e5e7eb);
        border-radius: 12px;
        overflow: hidden;
    }


    .card-header {
        padding: 22px 25px;
        border-bottom: 1px solid var(--border-color, #e5e7eb);
    }


    .card-header h2 {
        margin: 0 0 5px;
    }


    .card-header p {
        margin: 0;
        opacity: 0.65;
        font-size: 14px;
    }



    /* ========================================================
       ASSET INFO BANNER
    ======================================================== */

    .asset-info-banner {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1px;
        margin-bottom: 20px;
        background: var(--border-color, #e5e7eb);
        border: 1px solid var(--border-color, #e5e7eb);
        border-radius: 12px;
        overflow: hidden;
    }


    .asset-info-item {
        background: var(--card-bg, #ffffff);
        padding: 16px 20px;
        display: flex;
        flex-direction: column;
        gap: 5px;
    }


    .asset-info-label {
        font-size: 12px;
        opacity: 0.6;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }



    /* ========================================================
       FORM SECTIONS
    ======================================================== */

    .form-section {
        padding: 25px;
        border-bottom: 1px solid var(--border-color, #e5e7eb);
    }


    .section-heading {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 22px;
    }


    .section-number {
        width: 30px;
        height: 30px;
        min-width: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #f3f4f6;
        font-weight: 700;
        font-size: 13px;
    }


    .section-heading h3 {
        margin: 2px 0 5px;
        font-size: 17px;
    }


    .section-heading p {
        margin: 0;
        font-size: 13px;
        opacity: 0.6;
    }


    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }


    .form-group {
        display: flex;
        flex-direction: column;
        gap: 7px;
    }


    .form-group label {
        font-size: 13px;
        font-weight: 600;
    }


    .required {
        color: #dc2626;
    }


    .form-group input,
    .form-group select,
    .form-group textarea {
        width: 100%;
        box-sizing: border-box;
        padding: 11px 13px;
        border: 1px solid var(--border-color, #d1d5db);
        border-radius: 8px;
        background: var(--input-bg, #ffffff);
        font-size: 14px;
        font-family: inherit;
    }


    .form-group textarea {
        resize: vertical;
        min-height: 120px;
    }


    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
        outline: none;
        border-color: #2563eb;
    }


    .form-group input[readonly] {
        background: #f9fafb;
        cursor: not-allowed;
    }


    .form-group small {
        font-size: 12px;
        opacity: 0.6;
    }


    .input-with-prefix {
        display: flex;
        align-items: stretch;
    }


    .input-with-prefix > span {
        display: flex;
        align-items: center;
        padding: 0 12px;
        border: 1px solid var(--border-color, #d1d5db);
        border-right: none;
        border-radius: 8px 0 0 8px;
        background: #f9fafb;
        font-weight: 600;
    }


    .input-with-prefix input {
        border-radius: 0 8px 8px 0;
    }



    /* ========================================================
       CURRENT ASSIGNMENT
    ======================================================== */

    .current-assignment {
        margin: 20px 25px 0;
        padding: 15px;
        border: 1px solid var(--border-color, #e5e7eb);
        border-radius: 10px;
        display: flex;
        align-items: center;
        gap: 12px;
        background: #f9fafb;
    }


    .current-assignment-icon {
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #ffffff;
        border: 1px solid var(--border-color, #e5e7eb);
    }


    .current-assignment p {
        margin: 4px 0 0;
        font-size: 13px;
        opacity: 0.65;
    }



    /* ========================================================
       BUTTONS
    ======================================================== */

    .btn-primary,
    .btn-secondary,
    .btn-danger {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 9px 17px;
        border-radius: 8px;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        box-sizing: border-box;
    }


    .btn-primary {
        border: none;
    }


    .btn-secondary {
        border: 1px solid var(--border-color, #d1d5db);
        background: transparent;
    }


    .btn-danger {
        border: 1px solid #fecaca;
        background: #fee2e2;
        color: #991b1b;
    }


    .btn-danger:hover {
        background: #fecaca;
    }



    /* ========================================================
       FORM ACTIONS
    ======================================================== */

    .form-actions {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 10px;
        padding: 20px 25px;
    }



    /* ========================================================
       ERROR
    ======================================================== */

    .alert-error {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 20px;
        padding: 15px 17px;
        border-radius: 9px;
        background: #fee2e2;
        border: 1px solid #fecaca;
        color: #991b1b;
    }


    .alert-error p {
        margin: 5px 0 0;
        font-size: 13px;
    }


    .alert-icon {
        font-size: 18px;
    }



    /* ========================================================
       DANGER ZONE
    ======================================================== */

    .danger-zone {
        margin-top: 20px;
        padding: 20px;
        border: 1px solid #fecaca;
        border-radius: 12px;
        background: #fff7f7;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
    }


    .danger-zone h3 {
        margin: 0 0 6px;
        color: #991b1b;
    }


    .danger-zone p {
        margin: 0;
        font-size: 13px;
        color: #7f1d1d;
        opacity: 0.8;
    }



    /* ========================================================
       RESPONSIVE
    ======================================================== */

    @media (max-width: 800px) {

        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }


        .asset-info-banner {
            grid-template-columns: 1fr;
        }


        .form-grid {
            grid-template-columns: 1fr;
        }


        .page-header-actions {
            width: 100%;
        }


        .page-header-actions a {
            flex: 1;
        }


        .danger-zone {
            flex-direction: column;
            align-items: flex-start;
        }

    }


    @media (max-width: 550px) {

        .form-actions {
            flex-direction: column-reverse;
        }


        .form-actions a,
        .form-actions button {
            width: 100%;
        }


        .page-header-actions {
            flex-direction: column;
        }


        .page-header-actions a {
            width: 100%;
        }

    }

</style>



<!-- ============================================================
     JAVASCRIPT
============================================================ -->

<script>

    function confirmRetireAsset() {

        return confirm(
            "Are you sure you want to retire this asset?\n\n" +
            "The asset will be marked as RETIRED and removed from active inventory."
        );

    }


    document
        .getElementById("editAssetForm")
        ?.addEventListener("submit", function () {

            const button =
                document.getElementById("saveAssetButton");

            if (button) {

                button.disabled = true;

                button.textContent =
                    "Saving Changes...";

            }

        });


    /*
    ============================================================
    ASSIGNMENT LOGIC
    ============================================================
    */

    const assignedTo =
        document.getElementById("assignedTo");

    const status =
        document.getElementById("status");


    if (assignedTo && status) {

        assignedTo.addEventListener(
            "change",
            function () {

                if (this.value) {

                    status.value = "ASSIGNED";

                } else {

                    if (
                        status.value === "ASSIGNED"
                    ) {

                        status.value = "AVAILABLE";

                    }

                }

            }
        );

    }

</script>