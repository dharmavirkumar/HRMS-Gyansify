<%
const currentUser =
    typeof user !== "undefined" && user
        ? user
        : {};
%>

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        <%= typeof title !== "undefined" ? title : "Training" %>
        | Gyansify HRMS
    </title>

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family:
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                Arial,
                sans-serif;
            background: #f5f7fb;
            color: #1f2937;
        }

        .page {
            padding: 32px;
            max-width: 1400px;
            margin: 0 auto;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }

        .title-section h1 {
            margin: 0 0 8px;
            font-size: 30px;
            font-weight: 700;
        }

        .title-section p {
            margin: 0;
            color: #6b7280;
            font-size: 15px;
        }

        .add-btn {
            display: inline-block;
            padding: 12px 20px;
            background: #111827;
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
        }

        .add-btn:hover {
            background: #000;
        }

        .stats {
            display: grid;
            grid-template-columns:
                repeat(4, minmax(0, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .stat-card {
            background: white;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            padding: 22px;
        }

        .stat-label {
            font-size: 13px;
            color: #6b7280;
            margin-bottom: 10px;
        }

        .stat-value {
            font-size: 28px;
            font-weight: 700;
        }

        .content-card {
            background: white;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            overflow: hidden;
        }

        .content-header {
            padding: 22px;
            border-bottom: 1px solid #e5e7eb;
        }

        .content-header h2 {
            margin: 0 0 6px;
            font-size: 20px;
        }

        .content-header p {
            margin: 0;
            color: #6b7280;
            font-size: 14px;
        }

        .empty {
            padding: 70px 20px;
            text-align: center;
        }

        .empty-icon {
            font-size: 48px;
            margin-bottom: 15px;
        }

        .empty h3 {
            margin: 0 0 8px;
            font-size: 20px;
        }

        .empty p {
            margin: 0;
            color: #6b7280;
        }

        @media (max-width: 900px) {

            .stats {
                grid-template-columns:
                    repeat(2, minmax(0, 1fr));
            }

        }

        @media (max-width: 600px) {

            .page {
                padding: 20px;
            }

            .header {
                flex-direction: column;
                align-items: flex-start;
                gap: 20px;
            }

            .stats {
                grid-template-columns: 1fr;
            }

        }

    </style>

</head>

<body>

<div class="page">


    <!-- ================================================= -->
    <!-- PAGE HEADER -->
    <!-- ================================================= -->

    <div class="header">

        <div class="title-section">

            <h1>
                Training & Development
            </h1>

            <p>
                Manage employee training programs,
                courses and development activities.
            </p>

        </div>

        <a
            href="/training/create"
            class="add-btn"
        >
            + Add Training
        </a>

    </div>


    <!-- ================================================= -->
    <!-- STATISTICS -->
    <!-- ================================================= -->

    <div class="stats">

        <div class="stat-card">

            <div class="stat-label">
                Total Programs
            </div>

            <div class="stat-value">
                0
            </div>

        </div>


        <div class="stat-card">

            <div class="stat-label">
                Active Training
            </div>

            <div class="stat-value">
                0
            </div>

        </div>


        <div class="stat-card">

            <div class="stat-label">
                Employees Enrolled
            </div>

            <div class="stat-value">
                0
            </div>

        </div>


        <div class="stat-card">

            <div class="stat-label">
                Completed
            </div>

            <div class="stat-value">
                0
            </div>

        </div>

    </div>


    <!-- ================================================= -->
    <!-- TRAINING CONTENT -->
    <!-- ================================================= -->

    <div class="content-card">

        <div class="content-header">

            <h2>
                Training Programs
            </h2>

            <p>
                Create and manage employee
                learning and development programs.
            </p>

        </div>


        <div class="empty">

            <div class="empty-icon">
                🎓
            </div>

            <h3>
                No Training Programs Yet
            </h3>

            <p>
                Start by creating your first
                employee training program.
            </p>

        </div>

    </div>


</div>

</body>

</html>