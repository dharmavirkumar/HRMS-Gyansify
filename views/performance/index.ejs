<%
const currentUser =
    typeof user !== "undefined" && user
        ? user
        : {};
%>

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Performance | Gyansify HRMS
    </title>

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #f5f7fb;
            color: #1f2937;
            font-family:
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                Arial,
                sans-serif;
        }

        .page {
            max-width: 1400px;
            margin: 0 auto;
            padding: 32px;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }

        h1 {
            margin: 0 0 7px;
            font-size: 30px;
        }

        .subtitle {
            margin: 0;
            color: #6b7280;
            font-size: 14px;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            padding: 11px 18px;
            border-radius: 8px;
            text-decoration: none;
            font-size: 14px;
            font-weight: 600;
        }

        .btn-primary {
            background: #111827;
            color: #fff;
        }

        .stats {
            display: grid;
            grid-template-columns:
                repeat(4, minmax(0, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .stat {
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            padding: 22px;
        }

        .stat-label {
            color: #6b7280;
            font-size: 13px;
            margin-bottom: 10px;
        }

        .stat-value {
            font-size: 28px;
            font-weight: 700;
        }

        .card {
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            overflow: hidden;
        }

        .card-header {
            padding: 22px;
            border-bottom: 1px solid #e5e7eb;
        }

        .card-header h2 {
            margin: 0 0 5px;
            font-size: 19px;
        }

        .card-header p {
            margin: 0;
            color: #6b7280;
            font-size: 13px;
        }

        .empty {
            padding: 70px 20px;
            text-align: center;
        }

        .empty-icon {
            font-size: 48px;
            margin-bottom: 15px;
        }

        .empty h3 {
            margin: 0 0 8px;
            font-size: 20px;
        }

        .empty p {
            margin: 0;
            color: #6b7280;
        }

        @media (max-width: 900px) {

            .stats {
                grid-template-columns:
                    repeat(2, 1fr);
            }

        }

        @media (max-width: 600px) {

            .page {
                padding: 20px;
            }

            .header {
                flex-direction: column;
                align-items: flex-start;
                gap: 18px;
            }

            .stats {
                grid-template-columns: 1fr;
            }

        }

    </style>

</head>

<body>

<div class="page">

    <div class="header">

        <div>

            <h1>
                Performance Management
            </h1>

            <p class="subtitle">
                Manage employee goals, reviews,
                ratings and performance development.
            </p>

        </div>

        <a
            href="/performance/create"
            class="btn btn-primary"
        >
            + Create Review
        </a>

    </div>


    <div class="stats">

        <div class="stat">

            <div class="stat-label">
                Total Reviews
            </div>

            <div class="stat-value">
                0
            </div>

        </div>


        <div class="stat">

            <div class="stat-label">
                Pending Reviews
            </div>

            <div class="stat-value">
                0
            </div>

        </div>


        <div class="stat">

            <div class="stat-label">
                Completed Reviews
            </div>

            <div class="stat-value">
                0
            </div>

        </div>


        <div class="stat">

            <div class="stat-label">
                Average Rating
            </div>

            <div class="stat-value">
                0.0
            </div>

        </div>

    </div>


    <div class="card">

        <div class="card-header">

            <h2>
                Performance Reviews
            </h2>

            <p>
                Employee performance evaluations
                and development reviews.
            </p>

        </div>


        <div class="empty">

            <div class="empty-icon">
                📊
            </div>

            <h3>
                No Performance Reviews Yet
            </h3>

            <p>
                Create your first performance review
                to start tracking employee performance.
            </p>

        </div>

    </div>

</div>

</body>

</html>