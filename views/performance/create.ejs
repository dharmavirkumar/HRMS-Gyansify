<%
const currentUser =
    typeof user !== "undefined" && user
        ? user
        : {};

const formDataValue =
    typeof formData !== "undefined" && formData
        ? formData
        : {};

const errorMessage =
    typeof error !== "undefined" && error
        ? error
        : null;

const employeeList =
    typeof employees !== "undefined" && Array.isArray(employees)
        ? employees
        : [];
%>


<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Create Performance Review | Gyansify HRMS
    </title>


    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #f5f7fb;
            color: #1f2937;
            font-family:
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                Arial,
                sans-serif;
        }

        .page {
            max-width: 1200px;
            margin: 0 auto;
            padding: 32px;
        }


        /* =========================================
           HEADER
        ========================================= */

        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 28px;
        }

        .header-left h1 {
            margin: 0 0 7px;
            font-size: 30px;
            font-weight: 700;
            color: #111827;
        }

        .header-left p {
            margin: 0;
            color: #6b7280;
            font-size: 14px;
        }

        .back-btn {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 10px 16px;
            border: 1px solid #d1d5db;
            border-radius: 8px;
            background: #fff;
            color: #374151;
            text-decoration: none;
            font-size: 14px;
            font-weight: 600;
        }

        .back-btn:hover {
            background: #f9fafb;
        }


        /* =========================================
           ERROR
        ========================================= */

        .error-box {
            background: #fef2f2;
            border: 1px solid #fecaca;
            color: #b91c1c;
            padding: 14px 16px;
            border-radius: 8px;
            margin-bottom: 20px;
            font-size: 14px;
        }


        /* =========================================
           FORM CARD
        ========================================= */

        .form-card {
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            overflow: hidden;
        }

        .section {
            padding: 28px;
            border-bottom: 1px solid #e5e7eb;
        }

        .section:last-child {
            border-bottom: none;
        }

        .section-title {
            margin-bottom: 20px;
        }

        .section-title h2 {
            margin: 0 0 5px;
            font-size: 19px;
            font-weight: 700;
            color: #111827;
        }

        .section-title p {
            margin: 0;
            font-size: 13px;
            color: #6b7280;
        }


        /* =========================================
           GRID
        ========================================= */

        .form-grid {
            display: grid;
            grid-template-columns:
                repeat(2, minmax(0, 1fr));
            gap: 20px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
        }

        .full-width {
            grid-column: 1 / -1;
        }


        /* =========================================
           LABEL
        ========================================= */

        label {
            font-size: 13px;
            font-weight: 600;
            color: #374151;
            margin-bottom: 7px;
        }

        .required {
            color: #dc2626;
        }


        /* =========================================
           INPUTS
        ========================================= */

        input,
        select,
        textarea {
            width: 100%;
            border: 1px solid #d1d5db;
            border-radius: 8px;
            padding: 11px 13px;
            font-family: inherit;
            font-size: 14px;
            color: #111827;
            background: #fff;
            outline: none;
        }

        input:focus,
        select:focus,
        textarea:focus {
            border-color: #111827;
            box-shadow:
                0 0 0 3px
                rgba(17, 24, 39, .08);
        }

        textarea {
            min-height: 120px;
            resize: vertical;
        }

        .help-text {
            margin-top: 6px;
            font-size: 12px;
            color: #9ca3af;
        }


        /* =========================================
           EMPLOYEE CARD
        ========================================= */

        .employee-info {
            margin-top: 12px;
            padding: 14px 16px;
            border-radius: 8px;
            background: #f9fafb;
            border: 1px solid #e5e7eb;
            display: none;
        }

        .employee-info strong {
            display: block;
            margin-bottom: 4px;
            color: #111827;
        }

        .employee-info span {
            font-size: 13px;
            color: #6b7280;
        }


        /* =========================================
           ACTIONS
        ========================================= */

        .form-actions {
            display: flex;
            justify-content: flex-end;
            gap: 12px;
            padding: 22px 28px;
            background: #fafafa;
            border-top: 1px solid #e5e7eb;
        }

        .btn {
            border: none;
            border-radius: 8px;
            padding: 11px 20px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .btn-secondary {
            background: #fff;
            border: 1px solid #d1d5db;
            color: #374151;
        }

        .btn-primary {
            background: #111827;
            color: #fff;
        }

        .btn-primary:hover {
            background: #000;
        }


        /* =========================================
           RESPONSIVE
        ========================================= */

        @media (max-width: 768px) {

            .page {
                padding: 20px;
            }

            .page-header {
                flex-direction: column;
                align-items: flex-start;
                gap: 18px;
            }

            .form-grid {
                grid-template-columns: 1fr;
            }

            .full-width {
                grid-column: auto;
            }

            .section {
                padding: 20px;
            }

            .form-actions {
                padding: 18px 20px;
                flex-direction: column-reverse;
            }

            .btn {
                width: 100%;
            }

        }

    </style>

</head>


<body>

<div class="page">


    <!-- =========================================
         PAGE HEADER
    ========================================= -->

    <div class="page-header">

        <div class="header-left">

            <h1>
                Create Performance Review
            </h1>

            <p>
                Create and configure an employee
                performance evaluation.
            </p>

        </div>


        <a
            href="/performance"
            class="back-btn"
        >
            ← Back to Performance
        </a>

    </div>


    <!-- =========================================
         ERROR
    ========================================= -->

    <% if (errorMessage) { %>

        <div class="error-box">
            <%= errorMessage %>
        </div>

    <% } %>


    <!-- =========================================
         FORM
    ========================================= -->

    <form
        action="/performance/create"
        method="POST"
        id="performanceForm"
    >


        <div class="form-card">


            <!-- =====================================
                 EMPLOYEE & REVIEW
            ===================================== -->

            <div class="section">

                <div class="section-title">

                    <h2>
                        Employee & Review Information
                    </h2>

                    <p>
                        Select the employee and define
                        the performance review cycle.
                    </p>

                </div>


                <div class="form-grid">


                    <!-- Employee -->

                    <div class="form-group">

                        <label for="employee">
                            Employee
                            <span class="required">*</span>
                        </label>

                        <select
                            id="employee"
                            name="employee"
                            required
                        >

                            <option value="">
                                Select Employee
                            </option>

                            <% employeeList.forEach(function(employee) { %>

                                <option
                                    value="<%= employee._id %>"
                                    data-name="<%= (employee.firstName || '') + ' ' + (employee.lastName || '') %>"
                                    data-id="<%= employee.employeeId || '' %>"
                                    data-designation="<%= employee.designation || '' %>"
                                    <%= String(formDataValue.employee || "") === String(employee._id) ? "selected" : "" %>
                                >

                                    <%= employee.firstName || "" %>
                                    <%= employee.lastName || "" %>

                                    <% if (employee.employeeId) { %>
                                        — <%= employee.employeeId %>
                                    <% } %>

                                </option>

                            <% }); %>

                        </select>

                        <div
                            class="employee-info"
                            id="employeeInfo"
                        >

                            <strong id="employeeName"></strong>

                            <span id="employeeDetails"></span>

                        </div>

                    </div>


                    <!-- Review Type -->

                    <div class="form-group">

                        <label for="reviewType">
                            Review Type
                            <span class="required">*</span>
                        </label>

                        <select
                            id="reviewType"
                            name="reviewType"
                            required
                        >

                            <option value="">
                                Select Review Type
                            </option>

                            <option
                                value="ANNUAL"
                                <%= formDataValue.reviewType === "ANNUAL" ? "selected" : "" %>
                            >
                                Annual Review
                            </option>

                            <option
                                value="HALF_YEARLY"
                                <%= formDataValue.reviewType === "HALF_YEARLY" ? "selected" : "" %>
                            >
                                Half-Yearly Review
                            </option>

                            <option
                                value="QUARTERLY"
                                <%= formDataValue.reviewType === "QUARTERLY" ? "selected" : "" %>
                            >
                                Quarterly Review
                            </option>

                            <option
                                value="PROBATION"
                                <%= formDataValue.reviewType === "PROBATION" ? "selected" : "" %>
                            >
                                Probation Review
                            </option>

                            <option
                                value="PROJECT"
                                <%= formDataValue.reviewType === "PROJECT" ? "selected" : "" %>
                            >
                                Project Review
                            </option>

                            <option
                                value="OTHER"
                                <%= formDataValue.reviewType === "OTHER" ? "selected" : "" %>
                            >
                                Other
                            </option>

                        </select>

                    </div>


                    <!-- Review Period -->

                    <div class="form-group">

                        <label for="periodStart">
                            Review Period Start
                            <span class="required">*</span>
                        </label>

                        <input
                            type="date"
                            id="periodStart"
                            name="periodStart"
                            value="<%= formDataValue.periodStart || "" %>"
                            required
                        >

                    </div>


                    <div class="form-group">

                        <label for="periodEnd">
                            Review Period End
                            <span class="required">*</span>
                        </label>

                        <input
                            type="date"
                            id="periodEnd"
                            name="periodEnd"
                            value="<%= formDataValue.periodEnd || "" %>"
                            required
                        >

                    </div>


                    <!-- Review Date -->

                    <div class="form-group">

                        <label for="reviewDate">
                            Review Date
                        </label>

                        <input
                            type="date"
                            id="reviewDate"
                            name="reviewDate"
                            value="<%= formDataValue.reviewDate || "" %>"
                        >

                    </div>


                    <!-- Reviewer -->

                    <div class="form-group">

                        <label for="reviewer">
                            Reviewer / Manager
                        </label>

                        <input
                            type="text"
                            id="reviewer"
                            name="reviewer"
                            placeholder="Reviewer name"
                            value="<%= formDataValue.reviewer || currentUser.name || "" %>"
                        >

                    </div>

                </div>

            </div>


            <!-- =====================================
                 GOALS & OBJECTIVES
            ===================================== -->

            <div class="section">

                <div class="section-title">

                    <h2>
                        Goals & Objectives
                    </h2>

                    <p>
                        Define the employee's key goals
                        and expected outcomes.
                    </p>

                </div>


                <div class="form-grid">


                    <div class="form-group full-width">

                        <label for="goals">
                            Goals
                        </label>

                        <textarea
                            id="goals"
                            name="goals"
                            placeholder="Enter key goals, targets and responsibilities..."
                        ><%= formDataValue.goals || "" %></textarea>

                    </div>


                    <div class="form-group full-width">

                        <label for="achievements">
                            Key Achievements
                        </label>

                        <textarea
                            id="achievements"
                            name="achievements"
                            placeholder="Describe major achievements and contributions..."
                        ><%= formDataValue.achievements || "" %></textarea>

                    </div>

                </div>

            </div>


            <!-- =====================================
                 PERFORMANCE ASSESSMENT
            ===================================== -->

            <div class="section">

                <div class="section-title">

                    <h2>
                        Performance Assessment
                    </h2>

                    <p>
                        Record the employee's performance
                        against key competencies.
                    </p>

                </div>


                <div class="form-grid">


                    <!-- Overall Rating -->

                    <div class="form-group">

                        <label for="rating">
                            Overall Rating
                        </label>

                        <select
                            id="rating"
                            name="rating"
                        >

                            <option value="">
                                Not Rated
                            </option>

                            <option
                                value="1"
                                <%= String(formDataValue.rating || "") === "1" ? "selected" : "" %>
                            >
                                1 — Needs Significant Improvement
                            </option>

                            <option
                                value="2"
                                <%= String(formDataValue.rating || "") === "2" ? "selected" : "" %>
                            >
                                2 — Needs Improvement
                            </option>

                            <option
                                value="3"
                                <%= String(formDataValue.rating || "") === "3" ? "selected" : "" %>
                            >
                                3 — Meets Expectations
                            </option>

                            <option
                                value="4"
                                <%= String(formDataValue.rating || "") === "4" ? "selected" : "" %>
                            >
                                4 — Exceeds Expectations
                            </option>

                            <option
                                value="5"
                                <%= String(formDataValue.rating || "") === "5" ? "selected" : "" %>
                            >
                                5 — Outstanding
                            </option>

                        </select>

                    </div>


                    <!-- Status -->

                    <div class="form-group">

                        <label for="status">
                            Review Status
                        </label>

                        <select
                            id="status"
                            name="status"
                        >

                            <option
                                value="DRAFT"
                                <%= !formDataValue.status || formDataValue.status === "DRAFT" ? "selected" : "" %>
                            >
                                Draft
                            </option>

                            <option
                                value="PENDING"
                                <%= formDataValue.status === "PENDING" ? "selected" : "" %>
                            >
                                Pending Review
                            </option>

                            <option
                                value="COMPLETED"
                                <%= formDataValue.status === "COMPLETED" ? "selected" : "" %>
                            >
                                Completed
                            </option>

                            <option
                                value="CANCELLED"
                                <%= formDataValue.status === "CANCELLED" ? "selected" : "" %>
                                >
                                Cancelled
                            </option>

                        </select>

                    </div>


                    <!-- Strengths -->

                    <div class="form-group full-width">

                        <label for="strengths">
                            Strengths
                        </label>

                        <textarea
                            id="strengths"
                            name="strengths"
                            placeholder="Describe the employee's key strengths..."
                        ><%= formDataValue.strengths || "" %></textarea>

                    </div>


                    <!-- Improvement -->

                    <div class="form-group full-width">

                        <label for="improvements">
                            Areas for Improvement
                        </label>

                        <textarea
                            id="improvements"
                            name="improvements"
                            placeholder="Identify areas where improvement is required..."
                        ><%= formDataValue.improvements || "" %></textarea>

                    </div>


                    <!-- Feedback -->

                    <div class="form-group full-width">

                        <label for="feedback">
                            Manager Feedback
                        </label>

                        <textarea
                            id="feedback"
                            name="feedback"
                            placeholder="Enter detailed manager feedback..."
                        ><%= formDataValue.feedback || "" %></textarea>

                    </div>

                </div>

            </div>


            <!-- =====================================
                 DEVELOPMENT PLAN
            ===================================== -->

            <div class="section">

                <div class="section-title">

                    <h2>
                        Development Plan
                    </h2>

                    <p>
                        Define future development,
                        training and career objectives.
                    </p>

                </div>


                <div class="form-grid">


                    <div class="form-group full-width">

                        <label for="developmentPlan">
                            Development Plan
                        </label>

                        <textarea
                            id="developmentPlan"
                            name="developmentPlan"
                            placeholder="Enter development goals, training requirements and career objectives..."
                        ><%= formDataValue.developmentPlan || "" %></textarea>

                    </div>


                    <div class="form-group full-width">

                        <label for="nextGoals">
                            Next Review Goals
                        </label>

                        <textarea
                            id="nextGoals"
                            name="nextGoals"
                            placeholder="Enter goals for the next performance cycle..."
                        ><%= formDataValue.nextGoals || "" %></textarea>

                    </div>

                </div>

            </div>


            <!-- =====================================
                 ACTIONS
            ===================================== -->

            <div class="form-actions">

                <a
                    href="/performance"
                    class="btn btn-secondary"
                >
                    Cancel
                </a>


                <button
                    type="submit"
                    class="btn btn-primary"
                    id="submitBtn"
                >
                    Create Review
                </button>

            </div>


        </div>

    </form>

</div>


<script>


// =========================================
// EMPLOYEE INFORMATION
// =========================================

const employeeSelect =
    document.getElementById("employee");

const employeeInfo =
    document.getElementById("employeeInfo");

const employeeName =
    document.getElementById("employeeName");

const employeeDetails =
    document.getElementById("employeeDetails");


function updateEmployeeInfo() {

    const option =
        employeeSelect.options[
            employeeSelect.selectedIndex
        ];

    if (
        !option ||
        !option.value
    ) {

        employeeInfo.style.display = "none";

        return;
    }


    const name =
        option.dataset.name || "Employee";

    const employeeId =
        option.dataset.id || "";

    const designation =
        option.dataset.designation || "";


    employeeName.textContent =
        name;


    const details = [];

    if (employeeId) {
        details.push(employeeId);
    }

    if (designation) {
        details.push(designation);
    }


    employeeDetails.textContent =
        details.join(" • ");


    employeeInfo.style.display =
        "block";
}


employeeSelect.addEventListener(
    "change",
    updateEmployeeInfo
);


updateEmployeeInfo();


// =========================================
// DATE VALIDATION
// =========================================

const periodStart =
    document.getElementById("periodStart");

const periodEnd =
    document.getElementById("periodEnd");


periodStart.addEventListener(
    "change",
    function () {

        periodEnd.min =
            this.value;

        if (
            periodEnd.value &&
            periodEnd.value < this.value
        ) {

            periodEnd.value =
                this.value;

        }

    }
);


// =========================================
// SUBMIT BUTTON
// =========================================

document
    .getElementById("performanceForm")
    .addEventListener(
        "submit",
        function () {

            const button =
                document.getElementById(
                    "submitBtn"
                );

            button.disabled = true;

            button.textContent =
                "Creating...";

        }
    );

</script>


</body>

</html>