<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        <%= typeof title !== "undefined" ? title : "Edit Employee - Gyansify HRMS" %>
    </title>

    <style>

        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            padding: 0;
            min-height: 100%;
            font-family:
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                Roboto,
                Arial,
                sans-serif;
            background: #f8fafc;
            color: #111827;
        }

        body {
            min-height: 100vh;
        }

        a {
            text-decoration: none;
        }

        button,
        input,
        select,
        textarea {
            font-family: inherit;
        }


        /* =====================================================
           APP
        ===================================================== */

        .app {
            display: flex;
            min-height: 100vh;
        }


        /* =====================================================
           SIDEBAR
        ===================================================== */

        .sidebar {
            width: 235px;
            min-width: 235px;
            min-height: 100vh;
            background: #ffffff;
            border-right: 1px solid #e5e7eb;
            padding: 20px 14px;
            position: sticky;
            top: 0;
            height: 100vh;
            overflow-y: auto;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 4px 8px 24px;
        }

        .brand-logo {
            width: 34px;
            height: 34px;
            border-radius: 9px;
            background: #111827;
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 15px;
            font-weight: 700;
        }

        .brand-name {
            font-size: 14px;
            font-weight: 700;
            color: #111827;
        }

        .brand-subtitle {
            margin-top: 1px;
            font-size: 8px;
            color: #9ca3af;
            font-weight: 600;
            letter-spacing: .5px;
        }

        .menu-title {
            padding: 0 10px;
            margin: 3px 0 9px;
            font-size: 8px;
            color: #9ca3af;
            font-weight: 700;
            letter-spacing: .8px;
        }

        .sidebar-menu {
            display: flex;
            flex-direction: column;
            gap: 3px;
        }

        .menu-item {
            display: flex;
            align-items: center;
            gap: 10px;
            min-height: 38px;
            padding: 0 11px;
            border-radius: 7px;
            color: #6b7280;
            font-size: 10px;
            font-weight: 600;
            transition: .15s ease;
        }

        .menu-item span {
            width: 18px;
            text-align: center;
            font-size: 13px;
        }

        .menu-item:hover {
            background: #f3f4f6;
            color: #111827;
        }

        .menu-item.active {
            background: #111827;
            color: #ffffff;
        }

        .sidebar-bottom {
            margin-top: 30px;
            padding: 12px 8px 0;
            border-top: 1px solid #f0f0f0;
        }

        .logout {
            display: flex;
            align-items: center;
            gap: 9px;
            color: #6b7280;
            font-size: 10px;
            font-weight: 600;
            padding: 9px 10px;
            border-radius: 7px;
        }

        .logout:hover {
            background: #fef2f2;
            color: #dc2626;
        }


        /* =====================================================
           MAIN
        ===================================================== */

        .main {
            flex: 1;
            min-width: 0;
        }

        .header {
            height: 58px;
            padding: 0 30px;
            display: flex;
            align-items: center;
            background: #ffffff;
            border-bottom: 1px solid #e5e7eb;
        }

        .page-title {
            font-size: 12px;
            font-weight: 600;
            color: #111827;
        }


        /* =====================================================
           PAGE
        ===================================================== */

        .form-page {
            padding: 30px;
            max-width: 1450px;
            margin: 0 auto;
        }

        .form-card {
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            padding: 28px;
        }

        .form-heading {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 25px;
        }

        .form-heading h1 {
            margin: 0;
            font-size: 22px;
            font-weight: 600;
            color: #111827;
        }

        .form-heading p {
            margin: 6px 0 0;
            color: #9ca3af;
            font-size: 11px;
            line-height: 1.5;
        }

        .heading-back {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 34px;
            padding: 8px 12px;
            border: 1px solid #d1d5db;
            border-radius: 7px;
            color: #374151;
            background: #ffffff;
            font-size: 9px;
            font-weight: 600;
            white-space: nowrap;
        }

        .heading-back:hover {
            background: #f9fafb;
        }


        /* =====================================================
           EMPLOYEE SUMMARY
        ===================================================== */

        .employee-summary {
            display: flex;
            align-items: center;
            gap: 14px;
            background: #f9fafb;
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            padding: 14px 16px;
            margin-bottom: 25px;
        }

        .summary-avatar {
            width: 48px;
            height: 48px;
            min-width: 48px;
            border-radius: 10px;
            background: #111827;
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            font-weight: 700;
        }

        .summary-name {
            font-size: 14px;
            font-weight: 700;
            color: #111827;
        }

        .summary-meta {
            margin-top: 4px;
            color: #6b7280;
            font-size: 10px;
        }

        .summary-status {
            margin-left: auto;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            padding: 5px 8px;
            border-radius: 5px;
            font-size: 8px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .status-active {
            background: #dcfce7;
            color: #166534;
        }

        .status-inactive {
            background: #f3f4f6;
            color: #6b7280;
        }

        .status-exited {
            background: #fee2e2;
            color: #991b1b;
        }


        /* =====================================================
           ALERTS
        ===================================================== */

        .error-box,
        .success-box {
            padding: 12px 14px;
            border-radius: 7px;
            font-size: 11px;
            margin-bottom: 20px;
        }

        .error-box {
            background: #fef2f2;
            color: #b91c1c;
            border: 1px solid #fecaca;
        }

        .success-box {
            background: #ecfdf5;
            color: #047857;
            border: 1px solid #a7f3d0;
        }


        /* =====================================================
           FORM SECTION
        ===================================================== */

        .form-section {
            margin-top: 30px;
        }

        .form-section:first-of-type {
            margin-top: 0;
        }

        .section-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
            padding-bottom: 12px;
            border-bottom: 1px solid #eeeeee;
            margin-bottom: 18px;
        }

        .section-header h3 {
            margin: 0;
            font-size: 13px;
            font-weight: 600;
            color: #111827;
        }

        .section-description {
            font-size: 9px;
            color: #9ca3af;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 18px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 7px;
            min-width: 0;
        }

        .full {
            grid-column: 1 / -1;
        }

        label {
            font-size: 10px;
            color: #4b5563;
            font-weight: 600;
        }

        .required {
            color: #dc2626;
        }

        input,
        select,
        textarea {
            width: 100%;
            border: 1px solid #dfe3e8;
            border-radius: 7px;
            padding: 10px;
            font-size: 11px;
            outline: none;
            background: #ffffff;
            color: #111827;
            transition: .15s ease;
        }

        input,
        select {
            height: 38px;
        }

        input::placeholder,
        textarea::placeholder {
            color: #b6bcc5;
        }

        input:hover,
        select:hover,
        textarea:hover {
            border-color: #c7ccd3;
        }

        input:focus,
        select:focus,
        textarea:focus {
            border-color: #111827;
            box-shadow: 0 0 0 2px rgba(17, 24, 39, .05);
        }

        textarea {
            min-height: 95px;
            resize: vertical;
            line-height: 1.5;
        }

        .help-text {
            color: #9ca3af;
            font-size: 9px;
            line-height: 1.4;
        }


        /* =====================================================
           READ ONLY
        ===================================================== */

        .readonly-field {
            background: #f9fafb;
            color: #6b7280;
        }


        /* =====================================================
           ACTIONS
        ===================================================== */

        .form-actions {
            margin-top: 35px;
            padding-top: 20px;
            border-top: 1px solid #eeeeee;
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 9px;
        }

        .actions-left {
            margin-right: auto;
        }

        .cancel-button,
        .primary-button,
        .danger-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 36px;
            padding: 9px 16px;
            border-radius: 7px;
            font-size: 10px;
            font-weight: 600;
            cursor: pointer;
            transition: .15s ease;
        }

        .cancel-button {
            border: 1px solid #d1d5db;
            color: #374151;
            background: #ffffff;
        }

        .cancel-button:hover {
            background: #f9fafb;
        }

        .primary-button {
            border: 1px solid #111827;
            background: #111827;
            color: #ffffff;
        }

        .primary-button:hover {
            background: #1f2937;
        }

        .danger-button {
            border: 1px solid #fecaca;
            background: #ffffff;
            color: #dc2626;
        }

        .danger-button:hover {
            background: #fef2f2;
        }


        /* =====================================================
           FOOTER NOTE
        ===================================================== */

        .form-footer-note {
            margin-top: 15px;
            text-align: right;
            color: #9ca3af;
            font-size: 8px;
        }


        /* =====================================================
           RESPONSIVE
        ===================================================== */

        @media (max-width: 1100px) {

            .form-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .sidebar {
                width: 210px;
                min-width: 210px;
            }

        }


        @media (max-width: 750px) {

            .app {
                display: block;
            }

            .sidebar {
                position: static;
                width: 100%;
                min-width: 0;
                height: auto;
                min-height: auto;
                border-right: 0;
                border-bottom: 1px solid #e5e7eb;
            }

            .sidebar-menu {
                display: grid;
                grid-template-columns: repeat(2, 1fr);
            }

            .sidebar-bottom {
                margin-top: 15px;
            }

            .header {
                padding: 0 20px;
            }

            .form-page {
                padding: 20px;
            }

            .form-card {
                padding: 20px;
            }

            .form-heading {
                flex-direction: column;
            }

            .heading-back {
                width: 100%;
            }

            .summary-status {
                margin-left: 0;
            }

            .employee-summary {
                align-items: flex-start;
                flex-wrap: wrap;
            }

            .form-grid {
                grid-template-columns: 1fr;
            }

            .full {
                grid-column: auto;
            }

            .form-actions {
                flex-wrap: wrap;
            }

            .actions-left {
                width: 100%;
                margin-right: 0;
                order: 3;
            }

            .actions-left .danger-button {
                width: 100%;
            }

            .cancel-button,
            .primary-button {
                flex: 1;
            }

            .form-footer-note {
                text-align: left;
            }

        }


        @media (max-width: 450px) {

            .sidebar-menu {
                grid-template-columns: 1fr;
            }

            .form-page {
                padding: 14px;
            }

            .form-card {
                padding: 16px;
            }

            .employee-summary {
                padding: 12px;
            }

            .summary-avatar {
                width: 42px;
                height: 42px;
                min-width: 42px;
            }

            .form-actions {
                flex-direction: column;
                align-items: stretch;
            }

            .cancel-button,
            .primary-button {
                width: 100%;
                flex: none;
            }

        }


        /* =====================================================
           PRINT
        ===================================================== */

        @media print {

            .sidebar,
            .header,
            .heading-back,
            .form-actions {
                display: none !important;
            }

            .form-page {
                padding: 0;
            }

            .form-card {
                border: 0;
                padding: 0;
            }

        }

    </style>

</head>


<body>

<%
    /*
     * =========================================================
     * SAFE LOCALS
     * =========================================================
     */

    const currentEmployee =
        locals &&
        locals.employee
            ? locals.employee
            : {};

    const departmentsData =
        Array.isArray(locals?.departments)
            ? locals.departments
            : [];

    const designationsData =
        Array.isArray(locals?.designations)
            ? locals.designations
            : [];

    const branchesData =
        Array.isArray(locals?.branches)
            ? locals.branches
            : [];

    const locationsData =
        Array.isArray(locals?.locations)
            ? locals.locations
            : [];

    const errorMessage =
        locals?.error || "";

    const successMessage =
        locals?.success || "";


    /*
     * =========================================================
     * HELPERS
     * =========================================================
     */

    const getId = (value) => {

        if (!value) {
            return "";
        }

        if (
            typeof value === "object" &&
            value._id
        ) {
            return String(value._id);
        }

        return String(value);

    };


    const getObjectName = (value) => {

        if (!value) {
            return "";
        }

        if (typeof value === "object") {

            return (
                value.name ||
                value.title ||
                value.fullName ||
                (
                    `${value.firstName || ""} ${value.lastName || ""}`
                ).trim() ||
                ""
            );

        }

        return "";

    };


    const formatDateInput = (value) => {

        if (!value) {
            return "";
        }

        const date =
            new Date(value);

        if (
            Number.isNaN(
                date.getTime()
            )
        ) {
            return "";
        }

        return date
            .toISOString()
            .slice(0, 10);

    };


    const employeeFirstName =
        currentEmployee?.firstName || "";

    const employeeLastName =
        currentEmployee?.lastName || "";

    const employeeFullName =
        `${employeeFirstName} ${employeeLastName}`.trim()
        || "Employee";


    const employeeInitial =
        employeeFullName
            .charAt(0)
            .toUpperCase()
        || "E";


    const employeeStatus =
        String(
            currentEmployee?.status ||
            "Active"
        )
            .trim()
            .toUpperCase();


    const statusClass =
        employeeStatus === "ACTIVE"
            ? "status-active"
            : employeeStatus === "EXITED"
                ? "status-exited"
                : "status-inactive";


    const statusLabel =
        employeeStatus || "ACTIVE";


    const departmentId =
        getId(currentEmployee?.department);

    const designationId =
        getId(currentEmployee?.designation);

    const branchId =
        getId(currentEmployee?.branch);

    const locationId =
        getId(currentEmployee?.location);


    const reportingManagerValue =
        getObjectName(
            currentEmployee?.reportingManager
        )
        ||
        (
            typeof currentEmployee?.reportingManager === "string"
                ? currentEmployee.reportingManager
                : ""
        );


    const salaryData =
        currentEmployee?.salary &&
        typeof currentEmployee.salary === "object"
            ? currentEmployee.salary
            : {};


    const basicSalary =
        salaryData?.basic ??
        currentEmployee?.basicSalary ??
        "";


    const annualCTC =
        salaryData?.annualCTC ??
        currentEmployee?.annualCTC ??
        "";


    const bankData =
        currentEmployee?.bankDetails &&
        typeof currentEmployee.bankDetails === "object"
            ? currentEmployee.bankDetails
            : {};


    const emergencyData =
        currentEmployee?.emergencyContact &&
        typeof currentEmployee.emergencyContact === "object"
            ? currentEmployee.emergencyContact
            : {};

%>


<div class="app">


    <!-- =====================================================
         SIDEBAR
    ====================================================== -->

    <aside class="sidebar">


        <div class="brand">

            <div class="brand-logo">
                G
            </div>

            <div>

                <div class="brand-name">
                    Gyansify
                </div>

                <div class="brand-subtitle">
                    HRMS
                </div>

            </div>

        </div>


        <div class="menu-title">
            MAIN
        </div>


        <nav class="sidebar-menu">


            <a
                href="/dashboard"
                class="menu-item"
            >
                <span>▦</span>
                Dashboard
            </a>


            <a
                href="/employees"
                class="menu-item active"
            >
                <span>👥</span>
                Employees
            </a>


            <a
                href="/attendance"
                class="menu-item"
            >
                <span>◷</span>
                Attendance
            </a>


            <a
                href="/leave"
                class="menu-item"
            >
                <span>▣</span>
                Leave
            </a>


            <a
                href="/payroll"
                class="menu-item"
            >
                <span>₹</span>
                Payroll
            </a>


            <a
                href="/organization"
                class="menu-item"
            >
                <span>⚙</span>
                Organization
            </a>


            <a
                href="/recruitment"
                class="menu-item"
            >
                <span>◫</span>
                Recruitment
            </a>


            <a
                href="/reports"
                class="menu-item"
            >
                <span>▤</span>
                Reports
            </a>


            <a
                href="/settings"
                class="menu-item"
            >
                <span>⚙</span>
                Settings
            </a>


        </nav>


        <div class="sidebar-bottom">

            <a
                href="/logout"
                class="logout"
            >
                ↪ Logout
            </a>

        </div>


    </aside>


    <!-- =====================================================
         MAIN
    ====================================================== -->

    <main class="main">


        <header class="header">

            <span class="page-title">
                Edit Employee
            </span>

        </header>


        <section class="form-page">


            <div class="form-card">


                <!-- =================================================
                     HEADING
                ================================================== -->

                <div class="form-heading">


                    <div>

                        <h1>
                            Edit Employee
                        </h1>

                        <p>
                            Update employee personal,
                            organizational and employment information.
                        </p>

                    </div>


                    <a
                        href="/employees/<%= currentEmployee?._id || '' %>"
                        class="heading-back"
                    >
                        ← Back to Profile
                    </a>


                </div>


                <!-- =================================================
                     EMPLOYEE SUMMARY
                ================================================== -->

                <div class="employee-summary">


                    <div class="summary-avatar">

                        <%= employeeInitial %>

                    </div>


                    <div>

                        <div class="summary-name">

                            <%= employeeFullName %>

                        </div>


                        <div class="summary-meta">

                            Employee ID:
                            <strong>
                                <%= currentEmployee?.employeeId || "-" %>
                            </strong>


                            <% if (currentEmployee?.email) { %>

                                &nbsp; • &nbsp;

                                <%= currentEmployee.email %>

                            <% } %>


                            <% if (getObjectName(currentEmployee?.designation)) { %>

                                &nbsp; • &nbsp;

                                <%= getObjectName(currentEmployee.designation) %>

                            <% } %>


                        </div>


                    </div>


                    <div class="summary-status">

                        <span
                            class="status-badge <%= statusClass %>"
                        >
                            <%= statusLabel %>
                        </span>

                    </div>


                </div>


                <!-- =================================================
                     ERROR
                ================================================== -->

                <% if (errorMessage) { %>

                    <div class="error-box">
                        <%= errorMessage %>
                    </div>

                <% } %>


                <!-- =================================================
                     SUCCESS
                ================================================== -->

                <% if (successMessage) { %>

                    <div class="success-box">
                        <%= successMessage %>
                    </div>

                <% } %>


                <!-- =================================================
                     UPDATE FORM
                ================================================== -->

                <form
                    action="/employees/<%= currentEmployee?._id || '' %>/edit"
                    method="POST"
                    id="employeeEditForm"
                >


                    <!-- =================================================
                         PERSONAL INFORMATION
                    ================================================== -->

                    <div class="form-section">


                        <div class="section-header">

                            <h3>
                                Personal Information
                            </h3>

                            <span class="section-description">
                                Basic employee information
                            </span>

                        </div>


                        <div class="form-grid">


                            <!-- FIRST NAME -->

                            <div class="form-group">

                                <label for="firstName">
                                    First Name
                                    <span class="required">*</span>
                                </label>

                                <input
                                    id="firstName"
                                    type="text"
                                    name="firstName"
                                    value="<%= employeeFirstName %>"
                                    autocomplete="given-name"
                                    required
                                >

                            </div>


                            <!-- LAST NAME -->

                            <div class="form-group">

                                <label for="lastName">
                                    Last Name
                                </label>

                                <input
                                    id="lastName"
                                    type="text"
                                    name="lastName"
                                    value="<%= employeeLastName %>"
                                    autocomplete="family-name"
                                >

                            </div>


                            <!-- GENDER -->

                            <div class="form-group">

                                <label for="gender">
                                    Gender
                                </label>

                                <select
                                    id="gender"
                                    name="gender"
                                >

                                    <option value="">
                                        Select Gender
                                    </option>

                                    <option
                                        value="Male"
                                        <%= String(currentEmployee?.gender || "").toLowerCase() === "male" ? "selected" : "" %>
                                    >
                                        Male
                                    </option>

                                    <option
                                        value="Female"
                                        <%= String(currentEmployee?.gender || "").toLowerCase() === "female" ? "selected" : "" %>
                                    >
                                        Female
                                    </option>

                                    <option
                                        value="Other"
                                        <%= String(currentEmployee?.gender || "").toLowerCase() === "other" ? "selected" : "" %>
                                    >
                                        Other
                                    </option>

                                </select>

                            </div>


                            <!-- DOB -->

                            <div class="form-group">

                                <label for="dateOfBirth">
                                    Date of Birth
                                </label>

                                <input
                                    id="dateOfBirth"
                                    type="date"
                                    name="dateOfBirth"
                                    value="<%= formatDateInput(currentEmployee?.dateOfBirth) %>"
                                >

                            </div>


                            <!-- PHONE -->

                            <div class="form-group">

                                <label for="phone">
                                    Phone
                                </label>

                                <input
                                    id="phone"
                                    type="tel"
                                    name="phone"
                                    value="<%= currentEmployee?.phone || '' %>"
                                    maxlength="20"
                                    autocomplete="tel"
                                >

                            </div>


                            <!-- EMAIL -->

                            <div class="form-group">

                                <label for="email">
                                    Email
                                    <span class="required">*</span>
                                </label>

                                <input
                                    id="email"
                                    type="email"
                                    name="email"
                                    value="<%= currentEmployee?.email || '' %>"
                                    autocomplete="email"
                                    required
                                >

                            </div>


                        </div>


                    </div>


                    <!-- =================================================
                         ORGANIZATION
                    ================================================== -->

                    <div class="form-section">


                        <div class="section-header">

                            <h3>
                                Organization
                            </h3>

                            <span class="section-description">
                                Organizational placement
                            </span>

                        </div>


                        <div class="form-grid">


                            <!-- DEPARTMENT -->

                            <div class="form-group">

                                <label for="department">
                                    Department
                                </label>

                                <select
                                    id="department"
                                    name="department"
                                >

                                    <option value="">
                                        Select Department
                                    </option>


                                    <% departmentsData.forEach(department => { %>

                                        <%
                                            const itemId =
                                                getId(department);

                                            const itemName =
                                                department?.name ||
                                                department?.departmentName ||
                                                department?.title ||
                                                "Department";
                                        %>


                                        <option
                                            value="<%= itemId %>"
                                            <%= departmentId === itemId ? "selected" : "" %>
                                        >
                                            <%= itemName %>

                                            <% if (department?.code) { %>
                                                - <%= department.code %>
                                            <% } %>

                                        </option>


                                    <% }) %>


                                </select>

                            </div>


                            <!-- DESIGNATION -->

                            <div class="form-group">

                                <label for="designation">
                                    Designation
                                </label>

                                <select
                                    id="designation"
                                    name="designation"
                                >

                                    <option value="">
                                        Select Designation
                                    </option>


                                    <% designationsData.forEach(designation => { %>

                                        <%
                                            const itemId =
                                                getId(designation);

                                            const itemName =
                                                designation?.name ||
                                                designation?.designationName ||
                                                designation?.title ||
                                                "Designation";
                                        %>


                                        <option
                                            value="<%= itemId %>"
                                            <%= designationId === itemId ? "selected" : "" %>
                                        >
                                            <%= itemName %>

                                            <% if (designation?.code) { %>
                                                - <%= designation.code %>
                                            <% } %>

                                        </option>


                                    <% }) %>


                                </select>

                            </div>


                            <!-- BRANCH -->

                            <div class="form-group">

                                <label for="branch">
                                    Branch
                                </label>

                                <select
                                    id="branch"
                                    name="branch"
                                >

                                    <option value="">
                                        Select Branch
                                    </option>


                                    <% branchesData.forEach(branch => { %>

                                        <%
                                            const itemId =
                                                getId(branch);

                                            const itemName =
                                                branch?.name ||
                                                branch?.branchName ||
                                                "Branch";
                                        %>


                                        <option
                                            value="<%= itemId %>"
                                            <%= branchId === itemId ? "selected" : "" %>
                                        >
                                            <%= itemName %>

                                            <% if (branch?.city) { %>
                                                - <%= branch.city %>
                                            <% } %>

                                        </option>


                                    <% }) %>


                                </select>

                            </div>


                            <!-- LOCATION -->

                            <div class="form-group">

                                <label for="location">
                                    Work Location
                                </label>

                                <select
                                    id="location"
                                    name="location"
                                >

                                    <option value="">
                                        Select Location
                                    </option>


                                    <% locationsData.forEach(location => { %>

                                        <%
                                            const itemId =
                                                getId(location);

                                            const itemName =
                                                location?.name ||
                                                location?.locationName ||
                                                "Location";
                                        %>


                                        <option
                                            value="<%= itemId %>"
                                            <%= locationId === itemId ? "selected" : "" %>
                                        >
                                            <%= itemName %>

                                            <% if (location?.city) { %>
                                                - <%= location.city %>
                                            <% } %>

                                        </option>


                                    <% }) %>


                                </select>

                            </div>


                        </div>


                    </div>


                    <!-- =================================================
                         EMPLOYMENT INFORMATION
                    ================================================== -->

                    <div class="form-section">


                        <div class="section-header">

                            <h3>
                                Employment Information
                            </h3>

                            <span class="section-description">
                                Job and employment details
                            </span>

                        </div>


                        <div class="form-grid">


                            <!-- EMPLOYEE ID -->

                            <div class="form-group">

                                <label for="employeeId">
                                    Employee ID
                                    <span class="required">*</span>
                                </label>

                                <input
                                    id="employeeId"
                                    type="text"
                                    name="employeeId"
                                    value="<%= currentEmployee?.employeeId || '' %>"
                                    placeholder="GYS-EMP-0001"
                                    required
                                >

                                <span class="help-text">
                                    Employee ID must be unique within the organization.
                                </span>

                            </div>


                            <!-- JOINING DATE -->

                            <div class="form-group">

                                <label for="joiningDate">
                                    Joining Date
                                </label>

                                <input
                                    id="joiningDate"
                                    type="date"
                                    name="joiningDate"
                                    value="<%= formatDateInput(currentEmployee?.joiningDate) %>"
                                >

                            </div>


                            <!-- EMPLOYMENT TYPE -->

                            <div class="form-group">

                                <label for="employmentType">
                                    Employment Type
                                </label>

                                <select
                                    id="employmentType"
                                    name="employmentType"
                                >

                                    <%
                                        const employmentType =
                                            String(
                                                currentEmployee?.employmentType || ""
                                            ).toLowerCase();
                                    %>


                                    <option
                                        value="Permanent"
                                        <%= employmentType === "permanent" ? "selected" : "" %>
                                    >
                                        Permanent
                                    </option>


                                    <option
                                        value="Probation"
                                        <%= employmentType === "probation" ? "selected" : "" %>
                                    >
                                        Probation
                                    </option>


                                    <option
                                        value="Contract"
                                        <%= employmentType === "contract" ? "selected" : "" %>
                                    >
                                        Contract
                                    </option>


                                    <option
                                        value="Intern"
                                        <%= employmentType === "intern" ? "selected" : "" %>
                                    >
                                        Intern
                                    </option>


                                    <option
                                        value="Part Time"
                                        <%= employmentType === "part time" ? "selected" : "" %>
                                    >
                                        Part Time
                                    </option>


                                    <option
                                        value="Full Time"
                                        <%= employmentType === "full time" ? "selected" : "" %>
                                    >
                                        Full Time
                                    </option>


                                </select>

                            </div>


                            <!-- REPORTING MANAGER -->

                            <div class="form-group">

                                <label for="reportingManager">
                                    Reporting Manager
                                </label>

                                <input
                                    id="reportingManager"
                                    type="text"
                                    name="reportingManager"
                                    value="<%= reportingManagerValue %>"
                                    placeholder="Manager name"
                                >

                                <span class="help-text">
                                    Enter the employee's immediate reporting manager.
                                </span>

                            </div>


                            <!-- STATUS -->

                            <div class="form-group">

                                <label for="status">
                                    Employee Status
                                </label>

                                <select
                                    id="status"
                                    name="status"
                                >

                                    <option
                                        value="Active"
                                        <%= employeeStatus === "ACTIVE" ? "selected" : "" %>
                                    >
                                        Active
                                    </option>


                                    <option
                                        value="Inactive"
                                        <%= employeeStatus === "INACTIVE" ? "selected" : "" %>
                                    >
                                        Inactive
                                    </option>


                                    <option
                                        value="Exited"
                                        <%= employeeStatus === "EXITED" ? "selected" : "" %>
                                    >
                                        Exited
                                    </option>


                                </select>

                            </div>


                        </div>


                    </div>


                    <!-- =================================================
                         SALARY INFORMATION
                    ================================================== -->

                    <div class="form-section">


                        <div class="section-header">

                            <h3>
                                Compensation
                            </h3>

                            <span class="section-description">
                                Salary and compensation details
                            </span>

                        </div>


                        <div class="form-grid">


                            <!-- BASIC SALARY -->

                            <div class="form-group">

                                <label for="basicSalary">
                                    Basic Salary
                                </label>

                                <input
                                    id="basicSalary"
                                    type="number"
                                    name="basicSalary"
                                    value="<%= basicSalary %>"
                                    min="0"
                                    step="0.01"
                                    placeholder="0"
                                >

                                <span class="help-text">
                                    Monthly basic salary in INR.
                                </span>

                            </div>


                            <!-- ANNUAL CTC -->

                            <div class="form-group">

                                <label for="annualCTC">
                                    Annual CTC
                                </label>

                                <input
                                    id="annualCTC"
                                    type="number"
                                    name="annualCTC"
                                    value="<%= annualCTC %>"
                                    min="0"
                                    step="0.01"
                                    placeholder="0"
                                >

                                <span class="help-text">
                                    Annual cost to company in INR.
                                </span>

                            </div>


                            <!-- CURRENCY -->

                            <div class="form-group">

                                <label for="currency">
                                    Currency
                                </label>

                                <select
                                    id="currency"
                                    name="currency"
                                >

                                    <option
                                        value="INR"
                                        <%= String(salaryData?.currency || "INR").toUpperCase() === "INR" ? "selected" : "" %>
                                    >
                                        INR - Indian Rupee
                                    </option>

                                    <option
                                        value="USD"
                                        <%= String(salaryData?.currency || "").toUpperCase() === "USD" ? "selected" : "" %>
                                    >
                                        USD - US Dollar
                                    </option>

                                    <option
                                        value="EUR"
                                        <%= String(salaryData?.currency || "").toUpperCase() === "EUR" ? "selected" : "" %>
                                    >
                                        EUR - Euro
                                    </option>

                                </select>

                            </div>


                        </div>


                    </div>


                    <!-- =================================================
                         BANK INFORMATION
                    ================================================== -->

                    <div class="form-section">


                        <div class="section-header">

                            <h3>
                                Bank Information
                            </h3>

                            <span class="section-description">
                                Payroll payment information
                            </span>

                        </div>


                        <div class="form-grid">


                            <!-- BANK NAME -->

                            <div class="form-group">

                                <label for="bankName">
                                    Bank Name
                                </label>

                                <input
                                    id="bankName"
                                    type="text"
                                    name="bankName"
                                    value="<%= bankData?.bankName || '' %>"
                                    placeholder="Bank name"
                                >

                            </div>


                            <!-- ACCOUNT NUMBER -->

                            <div class="form-group">

                                <label for="accountNumber">
                                    Account Number
                                </label>

                                <input
                                    id="accountNumber"
                                    type="text"
                                    name="accountNumber"
                                    value="<%= bankData?.accountNumber || '' %>"
                                    placeholder="Account number"
                                >

                            </div>


                            <!-- IFSC -->

                            <div class="form-group">

                                <label for="ifscCode">
                                    IFSC Code
                                </label>

                                <input
                                    id="ifscCode"
                                    type="text"
                                    name="ifscCode"
                                    value="<%= bankData?.ifscCode || '' %>"
                                    placeholder="IFSC0000000"
                                >

                            </div>


                        </div>


                    </div>


                    <!-- =================================================
                         EMERGENCY CONTACT
                    ================================================== -->

                    <div class="form-section">


                        <div class="section-header">

                            <h3>
                                Emergency Contact
                            </h3>

                            <span class="section-description">
                                Emergency contact information
                            </span>

                        </div>


                        <div class="form-grid">


                            <!-- NAME -->

                            <div class="form-group">

                                <label for="emergencyContactName">
                                    Contact Name
                                </label>

                                <input
                                    id="emergencyContactName"
                                    type="text"
                                    name="emergencyContactName"
                                    value="<%= emergencyData?.name || emergencyData?.contactName || '' %>"
                                    placeholder="Contact person"
                                >

                            </div>


                            <!-- RELATION -->

                            <div class="form-group">

                                <label for="emergencyContactRelation">
                                    Relationship
                                </label>

                                <input
                                    id="emergencyContactRelation"
                                    type="text"
                                    name="emergencyContactRelation"
                                    value="<%= emergencyData?.relationship || emergencyData?.relation || '' %>"
                                    placeholder="Father, Mother, Spouse, etc."
                                >

                            </div>


                            <!-- PHONE -->

                            <div class="form-group">

                                <label for="emergencyContactPhone">
                                    Contact Phone
                                </label>

                                <input
                                    id="emergencyContactPhone"
                                    type="tel"
                                    name="emergencyContactPhone"
                                    value="<%= emergencyData?.phone || emergencyData?.contactPhone || '' %>"
                                    placeholder="+91"
                                >

                            </div>


                        </div>


                    </div>


                    <!-- =================================================
                         ADDRESS
                    ================================================== -->

                    <div class="form-section">


                        <div class="section-header">

                            <h3>
                                Contact & Address
                            </h3>

                            <span class="section-description">
                                Residential information
                            </span>

                        </div>


                        <div class="form-grid">


                            <div class="form-group full">

                                <label for="address">
                                    Address
                                </label>

                                <textarea
                                    id="address"
                                    name="address"
                                    placeholder="Employee residential address"
                                ><%= currentEmployee?.address || "" %></textarea>

                            </div>


                        </div>


                    </div>


                    <!-- =================================================
                         ACTIONS
                    ================================================== -->

                    <div class="form-actions">


                        <div class="actions-left">


                            <button
                                type="button"
                                class="danger-button"
                                onclick="confirmExitEmployee()"
                            >
                                Exit Employee
                            </button>


                        </div>


                        <a
                            href="/employees/<%= currentEmployee?._id || '' %>"
                            class="cancel-button"
                        >
                            Cancel
                        </a>


                        <button
                            type="submit"
                            class="primary-button"
                        >
                            Save Changes
                        </button>


                    </div>


                </form>


                <!-- =================================================
                     EXIT EMPLOYEE FORM
                ================================================== -->

                <form
                    id="exitEmployeeForm"
                    action="/employees/<%= currentEmployee?._id || '' %>/delete"
                    method="POST"
                    style="display:none;"
                >
                </form>


                <div class="form-footer-note">

                    Gyansify HRMS · Employee Management

                </div>


            </div>


        </section>


    </main>


</div>


<script>

    function confirmExitEmployee() {

        const employeeName =
            <%- JSON.stringify(employeeFullName) %>;


        const confirmed =
            window.confirm(

                "Are you sure you want to exit " +
                employeeName +
                "?\n\n" +

                "The employee should be marked as exited " +
                "instead of permanently deleting the employee record.\n\n" +

                "Historical attendance, leave and payroll records " +
                "should remain preserved."

            );


        if (!confirmed) {
            return;
        }


        const form =
            document.getElementById(
                "exitEmployeeForm"
            );


        if (form) {

            form.submit();

        }

    }


    /*
     * Prevent accidental double submission.
     */

    const employeeForm =
        document.getElementById(
            "employeeEditForm"
        );


    if (employeeForm) {

        employeeForm.addEventListener(
            "submit",
            function () {

                const submitButton =
                    employeeForm.querySelector(
                        'button[type="submit"]'
                    );


                if (submitButton) {

                    submitButton.disabled =
                        true;

                    submitButton.textContent =
                        "Saving...";

                }

            }
        );

    }

</script>


</body>

</html>