    }

    .employee-page .ep-search {
        grid-column: span 2;
    }
}

@media (max-width: 700px) {
    .employee-page .ep-header {
        flex-direction: column;
    }

    .employee-page .ep-header-actions {
        width: 100%;
    }

    .employee-page .ep-header-actions .ep-btn {
        flex: 1;
    }

    .employee-page .ep-stats {
        gap: 10px;
    }

    .employee-page .ep-stat {
        padding: 13px;
        gap: 10px;
    }

    .employee-page .ep-stat-icon {
        width: 38px;
        height: 38px;
    }

    .employee-page .ep-stat-value {
        font-size: 23px;
    }

    .employee-page .ep-filters {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        padding: 14px;
    }

    .employee-page .ep-search {
        grid-column: 1 / -1;
    }

    .employee-page .ep-reset {
        min-height: 38px;
    }

    .employee-page .ep-panel-head,
    .employee-page .ep-footer {
        padding: 16px;
    }

    .employee-page .ep-footer {
        align-items: flex-start;
        flex-direction: column;
    }
}

@media (max-width: 380px) {
    .employee-page .ep-stats {
        grid-template-columns: 1fr;
    }
}

@media (prefers-reduced-motion: reduce) {
    .employee-page *,
    .employee-page *::before,
    .employee-page *::after {
        transition: none !important;
    }
}
</style>

<div class="employee-page">

    <header class="ep-header">
        <div>
            <div class="ep-eyebrow">Gyansify HRMS / People</div>
            <h1 class="ep-title">Employee Directory</h1>
            <p class="ep-subtitle">
                Manage employee profiles, organizational assignments and employment status.
            </p>
        </div>

        <div class="ep-header-actions">
            <button type="button" class="ep-btn ep-btn-secondary"
                id="epExport">
                Export CSV
            </button>

            <a href="/employees/create" class="ep-btn ep-btn-primary">
                <span aria-hidden="true">＋</span>
                Add Employee
            </a>
        </div>
    </header>

    <section class="ep-stats" aria-label="Employee statistics">

        <article class="ep-stat">
            <div class="ep-stat-icon ep-blue" aria-hidden="true">♙</div>
            <div>
                <div class="ep-stat-label">Total Employees</div>
                <div class="ep-stat-value"><%= employeeList.length %></div>
                <div class="ep-stat-note">Loaded employee records</div>
            </div>
        </article>

        <article class="ep-stat">
            <div class="ep-stat-icon ep-green" aria-hidden="true">✓</div>
            <div>
                <div class="ep-stat-label">Active</div>
                <div class="ep-stat-value"><%= activeCount %></div>
                <div class="ep-stat-note">Active employees</div>
            </div>
        </article>

        <article class="ep-stat">
            <div class="ep-stat-icon ep-amber" aria-hidden="true">◷</div>
            <div>
                <div class="ep-stat-label">On Leave</div>
                <div class="ep-stat-value"><%= onLeaveCount %></div>
                <div class="ep-stat-note">Currently marked on leave</div>
            </div>
        </article>

        <article class="ep-stat">
            <div class="ep-stat-icon ep-gray" aria-hidden="true">↗</div>
            <div>
                <div class="ep-stat-label">Exited</div>
                <div class="ep-stat-value"><%= exitedCount %></div>
                <div class="ep-stat-note">Exited employee records</div>
            </div>
        </article>

    </section>

    <section class="ep-panel">

        <div class="ep-panel-head">
            <div>
                <h2 class="ep-panel-title">All Employees</h2>
                <p class="ep-panel-description">
                    Search and filter your organization's employee directory.
                </p>
            </div>

            <span class="ep-count">
                <span id="epRecordCount"><%= employeeList.length %></span>
                records
            </span>
        </div>

        <div class="ep-filters">

            <label class="ep-search">
                <span aria-hidden="true">⌕</span>
                <span class="ep-sr-only">Search employees</span>
                <input type="search" id="epSearch"
                    placeholder="Search name, email, phone or ID..."
                    autocomplete="off">
            </label>

            <label>
                <span class="ep-sr-only">Department</span>
                <select class="ep-select" id="epDepartment">
                    <option value="">All Departments</option>
                    <% getOptions("department").forEach(option => { %>
                        <option value="<%= option %>"><%= option %></option>
                    <% }); %>
                </select>
            </label>

            <label>
                <span class="ep-sr-only">Designation</span>
                <select class="ep-select" id="epDesignation">
                    <option value="">All Designations</option>
                    <% getOptions("designation").forEach(option => { %>
                        <option value="<%= option %>"><%= option %></option>
                    <% }); %>
                </select>
            </label>

            <label>
                <span class="ep-sr-only">Branch</span>
                <select class="ep-select" id="epBranch">
                    <option value="">All Branches</option>
                    <% getOptions("branch").forEach(option => { %>
                        <option value="<%= option %>"><%= option %></option>
                    <% }); %>
                </select>
            </label>

            <label>
                <span class="ep-sr-only">Employee status</span>
                <select class="ep-select" id="epStatus">
                    <option value="">All Statuses</option>
                    <% statusOptions.forEach(option => { %>
                        <option value="<%= option.toLowerCase() %>">
                            <%= option %>
                        </option>
                    <% }); %>
                </select>
            </label>

            <button type="button" class="ep-reset" id="epReset">
                Reset
            </button>

        </div>

        <div class="ep-table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Employee</th>
                        <th>Employee ID</th>
                        <th>Department</th>
                        <th>Designation</th>
                        <th>Branch</th>
                        <th>Joining Date</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody id="epTableBody">
                    <% employeeList.forEach(employee => {
                        const name = getEmployeeName(employee);
                        const email = safeText(employee.email, "");
                        const phone = safeText(employee.phone, "");
                        const code = safeText(employee.employeeId, "");
                        const department = safeText(employee.department);
                        const designation = safeText(employee.designation);
                        const branch = safeText(employee.branch);
                        const status = normalizeStatus(employee.status);
                    %>

                    <tr class="ep-row"
                        data-name="<%= name %>"
                        data-email="<%= email %>"
                        data-phone="<%= phone %>"
                        data-code="<%= code %>"
                        data-department="<%= department %>"
                        data-designation="<%= designation %>"
                        data-branch="<%= branch %>"
                        data-status="<%= status.toLowerCase() %>">

                        <td>
                            <div class="ep-person">
                                <div class="ep-avatar">
                                    <%= getInitials(employee) %>
                                </div>
                                <div>
                                    <span class="ep-person-name">
                                        <%= name %>
                                    </span>
                                    <span class="ep-person-email">
                                        <%= email || "No email recorded" %>
                                    </span>
                                </div>
                            </div>
                        </td>

                        <td>
                            <span class="ep-code">
                                <%= code || "Not assigned" %>
                            </span>
                        </td>

                        <td>
                            <span class="ep-cell-main"><%= department %></span>
                        </td>

                        <td>
                            <span class="ep-cell-main"><%= designation %></span>
                        </td>

                        <td>
                            <span class="ep-cell-main"><%= branch %></span>
                        </td>

                        <td>
                            <span class="ep-cell-main">
                                <%= formatDate(employee.joiningDate) %>
                            </span>
                        </td>

                        <td>
                            <span class="ep-status ep-status-<%= statusClass(employee.status) %>">
                                <%= status %>
                            </span>
                        </td>

                        <td>
                            <div class="ep-actions">
                                <a class="ep-action"
                                    href="/employees/<%= encodeURIComponent(String(employee._id)) %>">
                                    View
                                </a>

                                <a class="ep-action"
                                    href="/employees/<%= encodeURIComponent(String(employee._id)) %>/edit">
                                    Edit
                                </a>

                                <form class="ep-inline-form"
                                    method="POST"
                                    action="/employees/<%= encodeURIComponent(String(employee._id)) %>/delete"
                                    data-employee-name="<%= name %>"
                                    data-delete-form>
                                    <button type="submit"
                                        class="ep-action ep-action-danger">
                                        Exit
                                    </button>
                                </form>
                            </div>
                        </td>

                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>

        <div class="ep-empty" id="epEmpty" hidden>
            <div class="ep-empty-icon" aria-hidden="true">⌕</div>
            <h3 id="epEmptyTitle">No matching employees</h3>
            <p id="epEmptyMessage">
                Try changing your search or filters.
            </p>

            <button type="button" class="ep-btn ep-btn-secondary"
                id="epEmptyReset">
                Clear filters
            </button>
        </div>

        <footer class="ep-footer" id="epFooter">
            <div class="ep-footer-info" id="epPaginationInfo"
                aria-live="polite">
                Showing employees
            </div>

            <nav class="ep-pagination" id="epPagination"
                aria-label="Employee directory pages">
                <button type="button" class="ep-page-btn" id="epPrevious">
                    Previous
                </button>
                <div class="ep-pagination" id="epPageNumbers"></div>
                <button type="button" class="ep-page-btn" id="epNext">
                    Next
                </button>
            </nav>

            <label class="ep-page-size">
                Rows per page
                <select id="epPageSize">
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </label>
        </footer>

    </section>

</div>

<script>
(function () {
    "use strict";

    const root = document.querySelector(".employee-page");
    if (!root) return;

    const $ = selector => root.querySelector(selector);
    const rows = Array.from(root.querySelectorAll(".ep-row"));

    const search = $("#epSearch");
    const department = $("#epDepartment");
    const designation = $("#epDesignation");
    const branch = $("#epBranch");
    const status = $("#epStatus");
    const pageSize = $("#epPageSize");

    const count = $("#epRecordCount");
    const empty = $("#epEmpty");
    const emptyTitle = $("#epEmptyTitle");
    const emptyMessage = $("#epEmptyMessage");
    const footer = $("#epFooter");
    const info = $("#epPaginationInfo");
    const previous = $("#epPrevious");
    const next = $("#epNext");
    const pageNumbers = $("#epPageNumbers");

    let currentPage = 1;

    const normalize = value =>
        String(value || "").trim().toLocaleLowerCase();

    function getFilteredRows() {
        const query = normalize(search.value);
        const dept = normalize(department.value);
        const role = normalize(designation.value);
        const selectedBranch = normalize(branch.value);
        const selectedStatus = normalize(status.value);

        return rows.filter(row => {
            const dataset = row.dataset;

            const searchMatch = !query || [
                dataset.name,
                dataset.email,
                dataset.phone,
                dataset.code
            ].some(value => normalize(value).includes(query));

            return searchMatch &&
                (!dept || normalize(dataset.department) === dept) &&
                (!role || normalize(dataset.designation) === role) &&
                (!selectedBranch ||
                    normalize(dataset.branch) === selectedBranch) &&
                (!selectedStatus ||
                    normalize(dataset.status) === selectedStatus);
        });
    }

    function makePageButton(label, page, isCurrent) {
        const button = document.createElement("button");

        button.type = "button";
        button.className = "ep-page-btn" +
            (isCurrent ? " current" : "");
        button.textContent = label;

        if (isCurrent) {
            button.setAttribute("aria-current", "page");
        }

        button.addEventListener("click", function () {
            currentPage = page;
            render();
        });

        return button;
    }

    function renderPages(totalPages) {
        pageNumbers.replaceChildren();

        const pages = [...new Set([
            1,
            currentPage - 1,
            currentPage,
            currentPage + 1,
            totalPages
        ])]
            .filter(page => page >= 1 && page <= totalPages)
            .sort((a, b) => a - b);

        let previousPage = 0;

        pages.forEach(page => {
            if (previousPage && page - previousPage > 1) {
                const dots = document.createElement("span");
                dots.textContent = "…";
                dots.setAttribute("aria-hidden", "true");
                pageNumbers.appendChild(dots);
            }

            pageNumbers.appendChild(
                makePageButton(
                    String(page),
                    page,
                    page === currentPage
                )
            );

            previousPage = page;
        });

        previous.disabled = currentPage <= 1;
        next.disabled = currentPage >= totalPages;
    }

    function render() {
        const filtered = getFilteredRows();
        const total = filtered.length;
        const size = Number(pageSize.value) || 10;
        const totalPages = Math.max(1, Math.ceil(total / size));

        currentPage = Math.min(currentPage, totalPages);

        const start = (currentPage - 1) * size;
        const end = Math.min(start + size, total);
        const visibleRows = new Set(filtered.slice(start, end));

        rows.forEach(row => {
            row.hidden = !visibleRows.has(row);
        });

        count.textContent = String(total);

        if (total === 0) {
            empty.hidden = false;
            footer.hidden = true;

            if (rows.length === 0) {
                emptyTitle.textContent = "No employees yet";
                emptyMessage.textContent =
                    "Add your first employee to start building your directory.";
            } else {
                emptyTitle.textContent = "No matching employees";
                emptyMessage.textContent =
                    "Try changing your search or removing some filters.";
            }
        } else {
            empty.hidden = true;
            footer.hidden = false;

            info.textContent =
                "Showing " + (start + 1) + "–" + end +
                " of " + total + " employees";
        }

        renderPages(totalPages);
    }

    function resetFilters() {
        search.value = "";
        department.value = "";
        designation.value = "";
        branch.value = "";
        status.value = "";
        currentPage = 1;
        render();
    }

    search.addEventListener("input", function () {
        currentPage = 1;
        render();
    });

    [
        department,
        designation,
        branch,
        status
    ].forEach(select => {
        select.addEventListener("change", function () {
            currentPage = 1;
            render();
        });
    });

    pageSize.addEventListener("change", function () {
        currentPage = 1;
        render();
    });

    $("#epReset").addEventListener("click", resetFilters);
    $("#epEmptyReset").addEventListener("click", resetFilters);

    previous.addEventListener("click", function () {
        if (currentPage > 1) {
            currentPage--;
            render();
        }
    });

    next.addEventListener("click", function () {
        const totalPages = Math.max(
            1,
            Math.ceil(getFilteredRows().length /
                (Number(pageSize.value) || 10))
        );

        if (currentPage < totalPages) {
            currentPage++;
            render();
        }
    });

    root.querySelectorAll("[data-delete-form]").forEach(form => {
        form.addEventListener("submit", function (event) {
            const name = form.dataset.employeeName || "this employee";

            if (!window.confirm(
                "Are you sure you want to mark " + name +
                " as exited? This action will be submitted to the server."
            )) {
                event.preventDefault();
            }
        });
    });

    $("#epExport").addEventListener("click", function () {
        const filtered = getFilteredRows();

        const csvEscape = value =>
            '"' + String(value ?? "").replace(/"/g, '""') + '"';

        const csvRows = [
            [
                "Employee Name",
                "Email",
                "Employee ID",
                "Department",
                "Designation",
                "Branch",
                "Joining Date",
                "Status"
            ],
            ...filtered.map(row => {
                const cells = [
                    row.dataset.name,
                    row.dataset.email,
                    row.dataset.code,
                    row.dataset.department,
                    row.dataset.designation,
                    row.dataset.branch,
                    row.cells[5]?.innerText.trim(),
                    row.dataset.status
                ];

                return cells;
            })
        ];

        const csv = "\uFEFF" + csvRows
            .map(row => row.map(csvEscape).join(","))
            .join("\r\n");

        const blob = new Blob([csv], {
            type: "text/csv;charset=utf-8;"
        });

        const url = URL.createObjectURL(blob);
        const link = document.createElement("a");

        link.href = url;
        link.download = "gyansify-employees.csv";
        document.body.appendChild(link);
        link.click();
        link.remove();

        URL.revokeObjectURL(url);
    });

    render();
})();
</script>
