
<%
const employeeList = Array.isArray(employees) ? employees : [];

const safeText = (value, fallback = "-") => {
    if (value === null || value === undefined || value === "") {
        return fallback;
    }

    if (typeof value === "object") {
        return value.name ||
            value.title ||
            value.designationName ||
            value.departmentName ||
            value.branchName ||
            value.code ||
            value.label ||
            (value._id ? fallback : String(value)) ||
            fallback;
    }

    return String(value);
};

const getEmployeeName = (employee) =>
    [employee.firstName, employee.lastName]
        .filter(Boolean)
        .join(" ")
        .trim() ||
    employee.name ||
    employee.email ||
    "Employee";

const getInitials = (employee) =>
    getEmployeeName(employee)
        .split(/\s+/)
        .filter(Boolean)
        .slice(0, 2)
        .map(part => part.charAt(0).toUpperCase())
        .join("") || "E";

const statusOptions = [
    "Active",
    "On Leave",
    "Notice Period",
    "Suspended",
    "Exited"
];

const normalizeStatus = status =>
    statusOptions.find(
        item => item.toLowerCase() === String(status || "").trim().toLowerCase()
    ) || "Unknown";

const statusClass = status => ({
    "Active": "active",
    "On Leave": "leave",
    "Notice Period": "notice",
    "Suspended": "suspended",
    "Exited": "exited"
}[normalizeStatus(status)] || "unknown");

const formatDate = value => {
    if (!value) return "-";

    const date = new Date(value);

    if (Number.isNaN(date.getTime())) return "-";

    return new Intl.DateTimeFormat("en-IN", {
        day: "2-digit",
        month: "short",
        year: "numeric",
        timeZone: "Asia/Kolkata"
    }).format(date);
};

const activeCount = employeeList.filter(
    employee => normalizeStatus(employee.status) === "Active"
).length;

const onLeaveCount = employeeList.filter(
    employee => normalizeStatus(employee.status) === "On Leave"
).length;

const exitedCount = employeeList.filter(
    employee => normalizeStatus(employee.status) === "Exited"
).length;

const getOptions = field => [
    ...new Set(
        employeeList
            .map(employee => safeText(employee[field], ""))
            .filter(value => value && value !== "-")
    )
].sort((a, b) => a.localeCompare(b));
%>

<%- include('../partials/navbar') %>

