 <style>
/* =========================================================
   GYANSIFY HRMS — CREATE EMPLOYEE PAGE
   ========================================================= */

.employee-create-page {
    --ec-primary: #4f46e5;
    --ec-primary-dark: #4338ca;
    --ec-text: #172033;
    --ec-muted: #64748b;
    --ec-border: #e2e8f0;
    --ec-bg: #f8fafc;
    --ec-radius: 12px;

    padding: 26px;
    background: var(--ec-bg);
    color: var(--ec-text);
    min-height: 100vh;
    box-sizing: border-box;
}

.employee-create-page *,
.employee-create-page *::before,
.employee-create-page *::after {
    box-sizing: border-box;
}

.employee-create-page .ec-container {
    max-width: 1320px;
    margin: 0 auto;
}

/* Breadcrumb */

.employee-create-page .ec-breadcrumb {
    display: flex;
    align-items: center;
    gap: 9px;
    flex-wrap: wrap;
    margin-bottom: 22px;
    font-size: 12px;
    color: var(--ec-muted);
}

.employee-create-page .ec-breadcrumb a {
    color: var(--ec-muted);
    text-decoration: none;
}

.employee-create-page .ec-breadcrumb a:hover {
    color: var(--ec-primary);
}

.employee-create-page .ec-breadcrumb .ec-current {
    color: var(--ec-text);
    font-weight: 700;
}

/* Header */

.employee-create-page .ec-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 24px;
}

.employee-create-page .ec-title-wrap {
    display: flex;
    align-items: flex-start;
    gap: 15px;
}

.employee-create-page .ec-title-icon {
    width: 52px;
    height: 52px;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    border-radius: 14px;
    background: #eef2ff;
    color: var(--ec-primary);
}

.employee-create-page .ec-title-icon svg {
    width: 25px;
    height: 25px;
}

.employee-create-page .ec-header h1 {
    margin: 0 0 7px;
    font-size: clamp(22px, 2vw, 29px);
    font-weight: 800;
    letter-spacing: -0.7px;
    line-height: 1.25;
}

.employee-create-page .ec-header p {
    margin: 0;
    color: var(--ec-muted);
    font-size: 13px;
    line-height: 1.7;
}

.employee-create-page .ec-header-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 13px;
    border: 1px solid #c7d2fe;
    border-radius: 999px;
    background: #eef2ff;
    color: #4338ca;
    white-space: nowrap;
    font-size: 11px;
    font-weight: 700;
}

.employee-create-page .ec-status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #6366f1;
}

/* Intro panel */

.employee-create-page .ec-intro {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 16px 18px;
    margin-bottom: 22px;
    border: 1px solid #c7d2fe;
    border-radius: var(--ec-radius);
    background: linear-gradient(120deg, #eef2ff, #f8faff);
}

.employee-create-page .ec-intro-icon {
    color: var(--ec-primary);
    flex-shrink: 0;
    font-size: 19px;
}

.employee-create-page .ec-intro strong {
    display: block;
    margin-bottom: 4px;
    font-size: 12px;
}

.employee-create-page .ec-intro p {
    margin: 0;
    color: #64748b;
    font-size: 12px;
    line-height: 1.7;
}

/* Notifications */

.employee-create-page .ec-alert {
    display: flex;
    align-items: flex-start;
    gap: 11px;
    padding: 14px 16px;
    margin-bottom: 20px;
    border-radius: 10px;
    font-size: 12px;
    line-height: 1.7;
    overflow-wrap: anywhere;
}

.employee-create-page .ec-alert svg {
    width: 19px;
    height: 19px;
    flex-shrink: 0;
    margin-top: 1px;
}

.employee-create-page .ec-alert-error {
    color: #991b1b;
    background: #fef2f2;
    border: 1px solid #fecaca;
}

.employee-create-page .ec-alert-success {
    color: #065f46;
    background: #ecfdf5;
    border: 1px solid #a7f3d0;
}

/* Main layout */

.employee-create-page .ec-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 275px;
    align-items: start;
    gap: 22px;
}

.employee-create-page .ec-main {
    min-width: 0;
}

.employee-create-page .ec-card {
    background: #fff;
    border: 1px solid var(--ec-border);
    border-radius: 14px;
    box-shadow: 0 3px 12px rgba(15, 23, 42, 0.025);
}

.employee-create-page .ec-card + .ec-card {
    margin-top: 18px;
}

/* Sections */

.employee-create-page .ec-section {
    padding: 25px;
}

.employee-create-page .ec-section + .ec-section {
    border-top: 1px solid #edf0f5;
}

.employee-create-page .ec-section-heading {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 23px;
}

.employee-create-page .ec-section-icon {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    color: var(--ec-primary);
    background: #eef2ff;
    border-radius: 11px;
}

.employee-create-page .ec-section-icon svg {
    width: 20px;
    height: 20px;
}

.employee-create-page .ec-section-heading h2 {
    margin: 1px 0 5px;
    font-size: 15px;
    font-weight: 800;
    letter-spacing: -0.2px;
}

.employee-create-page .ec-section-heading p {
    margin: 0;
    font-size: 11px;
    line-height: 1.6;
    color: var(--ec-muted);
}

/* Fields */

.employee-create-page .ec-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 21px 18px;
}

.employee-create-page .ec-field {
    display: flex;
    flex-direction: column;
    min-width: 0;
    gap: 8px;
}

.employee-create-page .ec-field-full {
    grid-column: 1 / -1;
}

.employee-create-page .ec-field label {
    color: #334155;
    font-size: 11px;
    font-weight: 700;
}

.employee-create-page .ec-required {
    color: #dc2626;
    margin-left: 3px;
}

.employee-create-page .ec-optional {
    color: #94a3b8;
    font-size: 10px;
    font-weight: 500;
    margin-left: 4px;
}

.employee-create-page .ec-control-wrap {
    position: relative;
}

.employee-create-page .ec-control {
    display: block;
    width: 100%;
    min-height: 43px;
    padding: 11px 12px;
    border: 1px solid #dbe2ea;
    border-radius: 8px;
    outline: none;
    background: #fff;
    color: #172033;
    font-family: inherit;
    font-size: 12px;
    line-height: 1.5;
    transition: border-color .18s ease, box-shadow .18s ease;
}

.employee-create-page select.ec-control {
    cursor: pointer;
    padding-right: 30px;
}

.employee-create-page textarea.ec-control {
    min-height: 105px;
    resize: vertical;
}

.employee-create-page .ec-control::placeholder {
    color: #a0aabc;
    opacity: 1;
}

.employee-create-page .ec-control:hover {
    border-color: #cbd5e1;
}

.employee-create-page .ec-control:focus {
    border-color: var(--ec-primary);
    box-shadow: 0 0 0 3px rgba(79, 70, 229, .10);
}

.employee-create-page .ec-control:disabled {
    background: #f1f5f9;
    color: #94a3b8;
    cursor: not-allowed;
}

.employee-create-page .ec-field-hint {
    margin: -2px 0 0;
    font-size: 10px;
    color: #94a3b8;
    line-height: 1.5;
}

.employee-create-page .ec-control[aria-invalid="true"] {
    border-color: #dc2626;
    background: #fffafa;
}

.employee-create-page .ec-field-error {
    display: none;
    color: #dc2626;
    font-size: 10px;
    line-height: 1.5;
}

.employee-create-page .ec-field-error.is-visible {
    display: block;
}

/* Employee ID field */

.employee-create-page .ec-id-note {
    display: flex;
    align-items: flex-start;
    gap: 7px;
    color: #64748b;
    font-size: 10px;
    line-height: 1.6;
}

.employee-create-page .ec-id-note svg {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    margin-top: 1px;
    color: var(--ec-primary);
}

/* Actions */

.employee-create-page .ec-actions {
    position: sticky;
    bottom: 0;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    margin-top: 18px;
    padding: 16px 20px;
    background: rgba(255, 255, 255, .97);
    border: 1px solid var(--ec-border);
    border-radius: 12px;
    box-shadow: 0 -5px 22px rgba(15, 23, 42, .035);
    backdrop-filter: blur(12px);
}

.employee-create-page .ec-actions-note {
    color: #64748b;
    font-size: 10px;
    line-height: 1.6;
}

.employee-create-page .ec-actions-buttons {
    display: flex;
    align-items: center;
    gap: 10px;
}

.employee-create-page .ec-btn {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    min-height: 41px;
    padding: 10px 17px;
    border-radius: 8px;
    border: 1px solid transparent;
    font-family: inherit;
    font-size: 11px;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    transition: background .18s ease, border-color .18s ease, transform .18s ease;
}

.employee-create-page .ec-btn:focus-visible {
    outline: 3px solid #c7d2fe;
    outline-offset: 2px;
}

.employee-create-page .ec-btn-secondary {
    background: #fff;
    color: #475569;
    border-color: #dbe2ea;
}

.employee-create-page .ec-btn-secondary:hover {
    background: #f8fafc;
    border-color: #cbd5e1;
}

.employee-create-page .ec-btn-primary {
    color: #fff;
    background: var(--ec-primary);
    border-color: var(--ec-primary);
    box-shadow: 0 3px 8px rgba(79, 70, 229, .18);
}

.employee-create-page .ec-btn-primary:hover {
    background: var(--ec-primary-dark);
    border-color: var(--ec-primary-dark);
}

.employee-create-page .ec-btn-primary:disabled {
    opacity: .65;
    cursor: wait;
    box-shadow: none;
}

.employee-create-page .ec-btn svg {
    width: 15px;
    height: 15px;
}

/* Right sidebar */

.employee-create-page .ec-sidebar {
    min-width: 0;
}

.employee-create-page .ec-side-card {
    padding: 20px;
    background: #fff;
    border: 1px solid var(--ec-border);
    border-radius: 13px;
}

.employee-create-page .ec-side-card + .ec-side-card {
    margin-top: 17px;
}

.employee-create-page .ec-side-title {
    margin: 0 0 17px;
    font-size: 13px;
    font-weight: 800;
}

.employee-create-page .ec-progress-top {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 10px;
    color: #475569;
    font-size: 10px;
    font-weight: 700;
}

.employee-create-page .ec-progress-value {
    color: var(--ec-primary);
}

.employee-create-page .ec-progress-track {
    height: 6px;
    overflow: hidden;
    border-radius: 99px;
    background: #e9edf5;
}

.employee-create-page .ec-progress-fill {
    height: 100%;
    width: 0;
    border-radius: inherit;
    background: linear-gradient(90deg, #6366f1, #4f46e5);
    transition: width .2s ease;
}

.employee-create-page .ec-progress-caption {
    margin: 10px 0 0;
    color: #94a3b8;
    font-size: 10px;
    line-height: 1.6;
}

.employee-create-page .ec-checklist {
    display: flex;
    flex-direction: column;
    gap: 15px;
    padding: 0;
    margin: 0;
    list-style: none;
}

.employee-create-page .ec-checklist li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    color: #64748b;
    font-size: 11px;
    line-height: 1.6;
}

.employee-create-page .ec-check-icon {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    color: #94a3b8;
    background: #f1f5f9;
    border-radius: 7px;
    font-size: 11px;
    font-weight: 800;
}

.employee-create-page .ec-checklist li.is-complete {
    color: #166534;
}

.employee-create-page .ec-checklist li.is-complete .ec-check-icon {
    color: #15803d;
    background: #dcfce7;
}

.employee-create-page .ec-checklist strong {
    display: block;
    color: #334155;
    margin-bottom: 2px;
    font-size: 11px;
}

.employee-create-page .ec-checklist li.is-complete strong {
    color: #166534;
}

.employee-create-page .ec-help-card {
    padding: 18px;
    background: #f8fafc;
    border: 1px dashed #cbd5e1;
    border-radius: 12px;
}

.employee-create-page .ec-help-icon {
    width: 33px;
    height: 33px;
    display: grid;
    place-items: center;
    margin-bottom: 12px;
    color: #475569;
    background: #e2e8f0;
    border-radius: 10px;
}

.employee-create-page .ec-help-icon svg {
    width: 17px;
    height: 17px;
}

.employee-create-page .ec-help-card h3 {
    margin: 0 0 7px;
    font-size: 12px;
}

.employee-create-page .ec-help-card p {
    margin: 0;
    color: #64748b;
    font-size: 11px;
    line-height: 1.8;
}

/* Footer */

.employee-create-page .ec-footer {
    padding: 20px 0 4px;
    color: #94a3b8;
    text-align: center;
    font-size: 10px;
    line-height: 1.7;
}

/* Responsive */

@media (min-width: 1500px) {
    .employee-create-page .ec-layout {
        grid-template-columns: minmax(0, 1fr) 300px;
    }
}

@media (max-width: 1100px) {
    .employee-create-page .ec-layout {
        grid-template-columns: minmax(0, 1fr) 240px;
        gap: 16px;
    }

    .employee-create-page .ec-section {
        padding: 21px;
    }
}

@media (max-width: 850px) {
    .employee-create-page {
        padding: 20px;
    }

    .employee-create-page .ec-layout {
        grid-template-columns: minmax(0, 1fr);
    }

    .employee-create-page .ec-sidebar {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        align-items: start;
        gap: 14px;
    }

    .employee-create-page .ec-side-card + .ec-side-card {
        margin-top: 0;
    }

    .employee-create-page .ec-help-card {
        grid-column: 1 / -1;
    }
}

@media (max-width: 560px) {
    .employee-create-page {
        padding: 14px;
    }

    .employee-create-page .ec-header {
        align-items: flex-start;
    }

    .employee-create-page .ec-title-wrap {
        gap: 11px;
    }

    .employee-create-page .ec-title-icon {
        width: 43px;
        height: 43px;
        border-radius: 11px;
    }

    .employee-create-page .ec-header h1 {
        font-size: 21px;
    }

    .employee-create-page .ec-header p {
        font-size: 11px;
    }

    .employee-create-page .ec-header-badge {
        display: none;
    }

    .employee-create-page .ec-intro {
        padding: 13px;
    }

    .employee-create-page .ec-section {
        padding: 18px 14px;
    }

    .employee-create-page .ec-grid {
        grid-template-columns: minmax(0, 1fr);
        gap: 17px;
    }

    .employee-create-page .ec-field-full {
        grid-column: auto;
    }

    .employee-create-page .ec-sidebar {
        grid-template-columns: minmax(0, 1fr);
    }

    .employee-create-page .ec-help-card {
        grid-column: auto;
    }

    .employee-create-page .ec-actions {
        position: static;
        align-items: stretch;
        flex-direction: column;
        padding: 14px;
    }

    .employee-create-page .ec-actions-buttons {
        display: grid;
        grid-template-columns: 1fr 1fr;
    }

    .employee-create-page .ec-btn {
        padding: 10px 9px;
    }

    .employee-create-page .ec-actions-note {
        text-align: center;
    }
}

@media (prefers-reduced-motion: reduce) {
    .employee-create-page *,
    .employee-create-page *::before,
    .employee-create-page *::after {
        transition: none !important;
        scroll-behavior: auto !important;
    }
}
</style>


<section class="employee-create-page">
    <div class="ec-container">

        <!-- BREADCRUMB -->
        <nav class="ec-breadcrumb" aria-label="Breadcrumb">
            <a href="/dashboard">Dashboard</a>
            <span aria-hidden="true">/</span>
            <a href="/employees">Employees</a>
            <span aria-hidden="true">/</span>
            <span class="ec-current">Add Employee</span>
        </nav>

        <!-- HEADER -->
        <header class="ec-header">
            <div class="ec-title-wrap">
                <div class="ec-title-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                        <circle cx="10" cy="7" r="4"/>
                        <path d="M20 8v6M17 11h6"/>
                    </svg>
                </div>
                <div>
                    <h1>Add New Employee</h1>
                    <p>Create a profile and assign the employee to your organization.</p>
                </div>
            </div>

            <div class="ec-header-badge">
                <span class="ec-status-dot"></span>
                Employee Management
            </div>
        </header>

        <!-- INTRO -->
        <div class="ec-intro">
            <span class="ec-intro-icon" aria-hidden="true">ⓘ</span>
            <div>
                <strong>Employee registration</strong>
                <p>Complete the required fields marked with an asterisk. Your information will be validated before the record is created.</p>
            </div>
        </div>

        <!-- ALL SERVER ERRORS -->
        <% if (typeof errors !== "undefined" && Array.isArray(errors) && errors.length) { %>
            <div class="ec-alert ec-alert-error" role="alert" aria-live="assertive">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <circle cx="12" cy="12" r="9"/>
                    <path d="M12 8v5M12 16h.01"/>
                </svg>
                <div>
                    <strong>Please correct the following:</strong>
                    <ul style="margin:6px 0 0;padding-left:18px;">
                        <% errors.forEach(function(message) { %>
                            <li><%= message %></li>
                        <% }) %>
                    </ul>
                </div>
            </div>
        <% } else if (typeof error !== "undefined" && error) { %>
            <div class="ec-alert ec-alert-error" role="alert">
                <strong><%= error %></strong>
            </div>
        <% } %>

        <% if (typeof success !== "undefined" && success) { %>
            <div class="ec-alert ec-alert-success" role="status">
                <strong><%= success %></strong>
            </div>
        <% } %>

        <!-- FORM -->
        <form
            id="employeeCreateForm"
            action="/employees/create"
            method="POST"
            novalidate
        >
            <div class="ec-layout">

                <main class="ec-main">

                    <!-- PERSONAL INFORMATION -->
                    <section class="ec-card ec-section">
                        <div class="ec-section-heading">
                            <div class="ec-section-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                    <circle cx="12" cy="8" r="4"/>
                                    <path d="M4 21v-2a8 8 0 0 1 16 0v2"/>
                                </svg>
                            </div>
                            <div>
                                <h2>Personal Information</h2>
                                <p>Identity and contact details for the employee profile.</p>
                            </div>
                        </div>

                        <div class="ec-grid">
                            <div class="ec-field">
                                <label for="firstName">First Name <span class="ec-required">*</span></label>
                                <input class="ec-control"
                                       type="text"
                                       id="firstName"
                                       name="firstName"
                                       value="<%= formData?.firstName || '' %>"
                                       placeholder="Enter first name"
                                       autocomplete="given-name"
                                       maxlength="100"
                                       required>
                                <span class="ec-field-error">First name is required.</span>
                            </div>

                            <div class="ec-field">
                                <label for="lastName">Last Name <span class="ec-optional">Optional</span></label>
                                <input class="ec-control"
                                       type="text"
                                       id="lastName"
                                       name="lastName"
                                       value="<%= formData?.lastName || '' %>"
                                       placeholder="Enter last name"
                                       autocomplete="family-name"
                                       maxlength="100">
                            </div>

                            <div class="ec-field">
                                <label for="email">Work Email <span class="ec-required">*</span></label>
                                <input class="ec-control"
                                       type="email"
                                       id="email"
                                       name="email"
                                       value="<%= formData?.email || '' %>"
                                       placeholder="employee@company.com"
                                       autocomplete="email"
                                       maxlength="254"
                                       required>
                                <span class="ec-field-error">Enter a valid email address.</span>
                            </div>

                            <div class="ec-field">
                                <label for="phone">Phone Number <span class="ec-optional">Optional</span></label>
                                <input class="ec-control"
                                       type="tel"
                                       id="phone"
                                       name="phone"
                                       value="<%= formData?.phone || '' %>"
                                       placeholder="+91 XXXXX XXXXX"
                                       autocomplete="tel"
                                       maxlength="30">
                                <span class="ec-field-hint">Include the country code if applicable.</span>
                                <span class="ec-field-error">Enter a valid phone number.</span>
                            </div>

                            <div class="ec-field">
                                <label for="gender">Gender <span class="ec-optional">Optional</span></label>
                                <select class="ec-control" id="gender" name="gender">
                                    <option value="">Select gender</option>
                                    <% ["Male", "Female", "Other"].forEach(function(option) { %>
                                        <option value="<%= option %>" <%= formData?.gender === option ? "selected" : "" %>><%= option %></option>
                                    <% }) %>
                                </select>
                            </div>

                            <div class="ec-field">
                                <label for="dateOfBirth">Date of Birth <span class="ec-optional">Optional</span></label>
                                <input class="ec-control"
                                       type="date"
                                       id="dateOfBirth"
                                       name="dateOfBirth"
                                       value="<%= formData?.dateOfBirth || '' %>"
                                       autocomplete="bday">
                                <span class="ec-field-error">Date of birth cannot be in the future.</span>
                            </div>
                        </div>
                    </section>

                    <!-- ORGANIZATION DETAILS -->
                    <section class="ec-card ec-section">
                        <div class="ec-section-heading">
                            <div class="ec-section-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                    <rect x="3" y="7" width="18" height="14" rx="2"/>
                                    <path d="M8 7V4h8v3M8 12h2M14 12h2M8 16h2M14 16h2"/>
                                </svg>
                            </div>
                            <div>
                                <h2>Organization Details</h2>
                                <p>Assign department, designation, branch and work location.</p>
                            </div>
                        </div>

                        <div class="ec-grid">
                            <div class="ec-field">
                                <label for="department">Department <span class="ec-required">*</span></label>
                                <select class="ec-control"
                                        id="department"
                                        name="department"
                                        required>
                                    <option value="">Select department</option>
                                    <% if (typeof departments !== "undefined" && departments?.length) { %>
                                        <% departments.forEach(function(item) { %>
                                            <option value="<%= item._id %>"
                                                <%= String(formData?.department || formData?.departmentId || "") === String(item._id) ? "selected" : "" %>>
                                                <%= item.name %><%= item.code ? " (" + item.code + ")" : "" %>
                                            </option>
                                        <% }) %>
                                    <% } %>
                                </select>
                                <% if (typeof departments === "undefined" || !departments?.length) { %>
                                    <span class="ec-field-hint">No active departments found. Add a department in Organization Setup first.</span>
                                <% } %>
                                <span class="ec-field-error">Please select a department.</span>
                            </div>

                            <div class="ec-field">
                                <label for="designation">Designation <span class="ec-required">*</span></label>
                                <select class="ec-control"
                                        id="designation"
                                        name="designation"
                                        required>
                                    <option value="">Select designation</option>
                                    <% if (typeof designations !== "undefined" && designations?.length) { %>
                                        <% designations.forEach(function(item) { %>
                                            <option value="<%= item._id %>"
                                                <%= String(formData?.designation || formData?.designationId || "") === String(item._id) ? "selected" : "" %>>
                                                <%= item.name %><%= item.code ? " (" + item.code + ")" : "" %>
                                            </option>
                                        <% }) %>
                                    <% } %>
                                </select>
                                <% if (typeof designations === "undefined" || !designations?.length) { %>
                                    <span class="ec-field-hint">No active designations found. Add a designation in Organization Setup first.</span>
                                <% } %>
                                <span class="ec-field-error">Please select a designation.</span>
                            </div>

                            <div class="ec-field">
                                <label for="branch">Branch <span class="ec-required">*</span></label>
                                <select class="ec-control"
                                        id="branch"
                                        name="branch"
                                        required>
                                    <option value="">Select branch</option>
                                    <% if (typeof branches !== "undefined" && branches?.length) { %>
                                        <% branches.forEach(function(item) { %>
                                            <option value="<%= item._id %>"
                                                <%= String(formData?.branch || formData?.branchId || "") === String(item._id) ? "selected" : "" %>>
                                                <%= item.name %><%= item.city ? " - " + item.city : "" %>
                                            </option>
                                        <% }) %>
                                    <% } %>
                                </select>
                                <span class="ec-field-error">Please select a branch.</span>
                            </div>

                            <div class="ec-field">
                                <label for="location">Work Location <span class="ec-required">*</span></label>
                                <select class="ec-control"
                                        id="location"
                                        name="location"
                                        required>
                                    <option value="">Select work location</option>
                                    <% if (typeof locations !== "undefined" && locations?.length) { %>
                                        <% locations.forEach(function(item) { %>
                                            <option value="<%= item._id %>"
                                                <%= String(formData?.location || formData?.locationId || "") === String(item._id) ? "selected" : "" %>>
                                                <%= item.name %><%= item.city ? " - " + item.city : "" %>
                                            </option>
                                        <% }) %>
                                    <% } %>
                                </select>
                                <span class="ec-field-error">Please select a work location.</span>
                            </div>
                        </div>
                    </section>

                    <!-- EMPLOYMENT -->
                    <section class="ec-card ec-section">
                        <div class="ec-section-heading">
                            <div class="ec-section-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                    <rect x="3" y="7" width="18" height="14" rx="2"/>
                                    <path d="M8 7V4h8v3M3 12h18"/>
                                </svg>
                            </div>
                            <div>
                                <h2>Employment Information</h2>
                                <p>Employee ID, joining date, employment type and reporting manager.</p>
                            </div>
                        </div>

                        <div class="ec-grid">
                            <div class="ec-field">
                                <label for="employeeId">Employee ID <span class="ec-required">*</span></label>
                                <input class="ec-control"
                                       type="text"
                                       id="employeeId"
                                       name="employeeId"
                                       value="<%= formData?.employeeId || '' %>"
                                       placeholder="GYS-EMP-0001"
                                       autocomplete="off"
                                       maxlength="50"
                                       pattern="[A-Za-z0-9_-]+"
                                       required>
                                <span class="ec-field-hint">Use a unique ID with letters, numbers, hyphens or underscores.</span>
                                <span class="ec-field-error">Enter a valid employee ID.</span>
                            </div>

                            <div class="ec-field">
                                <label for="joiningDate">Joining Date <span class="ec-optional">Optional</span></label>
                                <input class="ec-control"
                                       type="date"
                                       id="joiningDate"
                                       name="joiningDate"
                                       value="<%= formData?.joiningDate || '' %>">
                                <span class="ec-field-error">Enter a valid joining date.</span>
                            </div>

                            <div class="ec-field">
                                <label for="employmentType">Employment Type</label>
                                <select class="ec-control" id="employmentType" name="employmentType">
                                    <% ["Permanent", "Probation", "Contract", "Intern", "Part Time"].forEach(function(option) { %>
                                        <option value="<%= option %>"
                                            <%= (formData?.employmentType || "Permanent") === option ? "selected" : "" %>>
                                            <%= option %>
                                        </option>
                                    <% }) %>
                                </select>
                            </div>

                            <div class="ec-field">
                                <label for="reportingManager">Reporting Manager <span class="ec-optional">Optional</span></label>
                                <input class="ec-control"
                                       type="text"
                                       id="reportingManager"
                                       name="reportingManager"
                                       value="<%= formData?.reportingManager || '' %>"
                                       placeholder="Enter manager name"
                                       maxlength="120">
                                <span class="ec-field-hint">This field currently stores the manager's name as text.</span>
                            </div>
                        </div>
                    </section>

                    <!-- ADDRESS -->
                    <section class="ec-card ec-section">
                        <div class="ec-section-heading">
                            <div class="ec-section-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                    <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"/>
                                    <circle cx="12" cy="10" r="2.5"/>
                                </svg>
                            </div>
                            <div>
                                <h2>Contact Information</h2>
                                <p>Optional residential address details.</p>
                            </div>
                        </div>

                        <div class="ec-grid">
                            <div class="ec-field ec-field-full">
                                <label for="address">Residential Address <span class="ec-optional">Optional</span></label>
                                <textarea class="ec-control"
                                          id="address"
                                          name="address"
                                          maxlength="2000"
                                          autocomplete="street-address"
                                          placeholder="House number, street, area, city and PIN code"><%= formData?.address || "" %></textarea>
                            </div>
                        </div>
                    </section>

                    <!-- ACTIONS -->
                    <div class="ec-actions">
                        <div class="ec-actions-note">
                            <span class="ec-required">*</span> Required fields must be completed.
                        </div>

                        <div class="ec-actions-buttons">
                            <a href="/employees" class="ec-btn ec-btn-secondary">Cancel</a>
                            <button type="submit" id="employeeSubmitBtn" class="ec-btn ec-btn-primary">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                    <path d="M12 5v14M5 12h14"/>
                                </svg>
                                <span id="employeeSubmitText">Create Employee</span>
                            </button>
                        </div>
                    </div>

                </main>

                <!-- SIDEBAR -->
                <aside class="ec-sidebar">
                    <section class="ec-side-card">
                        <h2 class="ec-side-title">Form Completion</h2>

                        <div class="ec-progress-top">
                            <span>Required information</span>
                            <span class="ec-progress-value" id="ecProgressText">0%</span>
                        </div>

                        <div class="ec-progress-track"
                             id="ecProgressBar"
                             role="progressbar"
                             aria-label="Required field completion"
                             aria-valuemin="0"
                             aria-valuemax="100"
                             aria-valuenow="0">
                            <div class="ec-progress-fill" id="ecProgressFill"></div>
                        </div>

                        <p class="ec-progress-caption" id="ecProgressCaption">
                            Complete all required fields to continue.
                        </p>
                    </section>

                    <section class="ec-side-card">
                        <h2 class="ec-side-title">Creation Checklist</h2>

                        <ul class="ec-checklist">
                            <li id="ecCheckPersonal">
                                <span class="ec-check-icon">1</span>
                                <span><strong>Personal details</strong>Name and valid work email</span>
                            </li>
                            <li id="ecCheckOrganization">
                                <span class="ec-check-icon">2</span>
                                <span><strong>Organization</strong>Department and designation</span>
                            </li>
                            <li id="ecCheckBranch">
                                <span class="ec-check-icon">3</span>
                                <span><strong>Work assignment</strong>Branch and work location</span>
                            </li>
                            <li id="ecCheckEmployment">
                                <span class="ec-check-icon">4</span>
                                <span><strong>Identification</strong>Unique employee ID</span>
                            </li>
                        </ul>
                    </section>

                    <section class="ec-help-card">
                        <div class="ec-help-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <circle cx="12" cy="12" r="9"/>
                                <path d="M9.6 9a2.5 2.5 0 0 1 4.8 1c0 2-2.4 2-2.4 4M12 17h.01"/>
                            </svg>
                        </div>
                        <h3>Before you submit</h3>
                        <p>Check that the employee ID is unique, the email is correct, and all organizational assignments are selected.</p>
                    </section>
                </aside>
            </div>
        </form>

        <footer class="ec-footer">
            Gyansify HRMS · Employee Management
        </footer>
    </div>
</section>

<script>
(function () {
    "use strict";

    const form = document.getElementById("employeeCreateForm");
    if (!form) return;

    const submitButton = document.getElementById("employeeSubmitBtn");
    const submitText = document.getElementById("employeeSubmitText");
    const progressText = document.getElementById("ecProgressText");
    const progressFill = document.getElementById("ecProgressFill");
    const progressBar = document.getElementById("ecProgressBar");
    const progressCaption = document.getElementById("ecProgressCaption");

    const requiredIds = [
        "firstName",
        "email",
        "department",
        "designation",
        "branch",
        "location",
        "employeeId"
    ];

    function field(id) {
        return document.getElementById(id);
    }

    function showError(input, message) {
        input.setAttribute("aria-invalid", "true");

        const wrapper = input.closest(".ec-field");
        const error = wrapper?.querySelector(".ec-field-error");

        if (error) {
            error.textContent = message;
            error.classList.add("is-visible");
        }
    }

    function clearError(input) {
        input.removeAttribute("aria-invalid");

        const wrapper = input.closest(".ec-field");
        const error = wrapper?.querySelector(".ec-field-error");

        if (error) error.classList.remove("is-visible");
    }

    function validate(input) {
        if (!input) return true;

        clearError(input);

        const value = String(input.value || "").trim();

        if (input.required && !value) {
            showError(input, "This field is required.");
            return false;
        }

        if (!value) return true;

        if (input.id === "email") {
            if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)) {
                showError(input, "Enter a valid email address.");
                return false;
            }
        }

        if (input.id === "employeeId") {
            if (!/^[A-Za-z0-9_-]{1,50}$/.test(value)) {
                showError(input, "Use only letters, numbers, hyphens or underscores.");
                return false;
            }
        }

        if (input.id === "phone") {
            const digits = value.replace(/\D/g, "");

            if (!/^[+()\d\s.-]+$/.test(value) || digits.length < 7 || digits.length > 15) {
                showError(input, "Enter a valid phone number.");
                return false;
            }
        }

        if (input.type === "date") {
            const date = new Date(value + "T00:00:00");

            if (Number.isNaN(date.getTime())) {
                showError(input, "Enter a valid date.");
                return false;
            }

            if (input.id === "dateOfBirth") {
                const today = new Date();
                today.setHours(0, 0, 0, 0);

                if (date > today) {
                    showError(input, "Date of birth cannot be in the future.");
                    return false;
                }
            }

            if (input.id === "joiningDate" && field("dateOfBirth").value) {
                if (value < field("dateOfBirth").value) {
                    showError(input, "Joining date cannot be before date of birth.");
                    return false;
                }
            }
        }

        return true;
    }

    function updateCheck(id, complete) {
        const item = field(id);
        if (!item) return;

        item.classList.toggle("is-complete", complete);

        const icon = item.querySelector(".ec-check-icon");
        if (icon) {
            icon.textContent = complete ? "✓" : item.dataset.step;
        }
    }

    function updateProgress() {
        const fields = requiredIds.map(field).filter(Boolean);

        const completed = fields.filter(function (input) {
            return String(input.value || "").trim() !== "";
        }).length;

        const percent = fields.length
            ? Math.round(completed / fields.length * 100)
            : 0;

        progressText.textContent = percent + "%";
        progressFill.style.width = percent + "%";
        progressBar.setAttribute("aria-valuenow", String(percent));

        progressCaption.textContent = completed === fields.length
            ? "All required fields are filled. Review the details before submitting."
            : completed + " of " + fields.length + " required fields completed.";

        updateCheck(
            "ecCheckPersonal",
            Boolean(field("firstName").value.trim()) &&
            validateWithoutMessage(field("email"))
        );

        updateCheck(
            "ecCheckOrganization",
            Boolean(field("department").value) &&
            Boolean(field("designation").value)
        );

        updateCheck(
            "ecCheckBranch",
            Boolean(field("branch").value) &&
            Boolean(field("location").value)
        );

        updateCheck(
            "ecCheckEmployment",
            Boolean(field("employeeId").value.trim())
        );
    }

    function validateWithoutMessage(input) {
        return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(
            String(input.value || "").trim()
        );
    }

    form.querySelectorAll(".ec-check-icon").forEach(function (icon, index) {
        const item = icon.closest("li");

        if (item) {
            item.dataset.step = String(index + 1);
            icon.textContent = String(index + 1);
        }
    });

    form.querySelectorAll(".ec-control").forEach(function (input) {
        input.addEventListener("input", function () {
            if (input.getAttribute("aria-invalid") === "true") {
                validate(input);
            }
            updateProgress();
        });

        input.addEventListener("change", function () {
            if (input.getAttribute("aria-invalid") === "true") {
                validate(input);
            }
            updateProgress();
        });

        input.addEventListener("blur", function () {
            if (input.required || String(input.value || "").trim()) {
                validate(input);
            }
        });
    });

    let submitting = false;

    form.addEventListener("submit", function (event) {
        if (submitting) {
            event.preventDefault();
            return;
        }

        let valid = true;
        let firstInvalid = null;

        form.querySelectorAll(".ec-control").forEach(function (input) {
            if (!validate(input)) {
                valid = false;
                if (!firstInvalid) firstInvalid = input;
            }
        });

        updateProgress();

        if (!valid) {
            event.preventDefault();

            if (firstInvalid) {
                firstInvalid.focus();
                firstInvalid.scrollIntoView({
                    behavior: "smooth",
                    block: "center"
                });
            }

            return;
        }

        submitting = true;
        submitButton.disabled = true;
        submitText.textContent = "Creating Employee...";
    });

    updateProgress();
})();
</script>
