<style>

    .form-page {
        padding: 30px;
    }

    .form-card {
        max-width: 1100px;
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 28px;
    }

    .form-heading {
        margin-bottom: 25px;
    }

    .form-heading h1 {
        font-size: 22px;
        margin: 0;
    }

    .form-heading p {
        color: #9ca3af;
        font-size: 12px;
        margin-top: 5px;
    }

    .form-section {
        margin-top: 30px;
    }

    .form-section h3 {
        font-size: 14px;
        padding-bottom: 12px;
        border-bottom: 1px solid #eee;
        margin-bottom: 18px;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 7px;
    }

    .full {
        grid-column: 1 / -1;
    }

    .form-group label {
        font-size: 11px;
        color: #4b5563;
        font-weight: 600;
    }

    .required {
        color: #dc2626;
    }

    .form-group input,
    .form-group select,
    .form-group textarea {

        width: 100%;
        box-sizing: border-box;

        border: 1px solid #dfe3e8;
        border-radius: 7px;

        padding: 10px;

        font-size: 12px;
        font-family: inherit;

        outline: none;
        background: white;
    }

    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
        border-color: #111827;
    }

    .form-group textarea {
        min-height: 90px;
        resize: vertical;
    }

    .error-box {
        background: #fef2f2;
        color: #b91c1c;
        border: 1px solid #fecaca;
        padding: 12px;
        border-radius: 7px;
        font-size: 12px;
        margin-bottom: 20px;
    }

    .success-box {
        background: #ecfdf5;
        color: #047857;
        border: 1px solid #a7f3d0;
        padding: 12px;
        border-radius: 7px;
        font-size: 12px;
        margin-bottom: 20px;
    }

    .empty-option {
        color: #9ca3af;
    }

    .form-actions {
        margin-top: 30px;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
    }

    .cancel-button {
        padding: 10px 18px;
        border: 1px solid #d1d5db;
        border-radius: 7px;
        color: #374151;
        text-decoration: none;
        font-size: 12px;
        background: white;
    }

    .cancel-button:hover {
        background: #f9fafb;
    }

    .primary-button {
        border: 0;
        padding: 10px 18px;
        border-radius: 7px;
        background: #111827;
        color: white;
        cursor: pointer;
        font-size: 12px;
    }

    .primary-button:hover {
        opacity: 0.9;
    }

    .primary-button:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    @media (max-width: 800px) {

        .form-grid {
            grid-template-columns: 1fr;
        }

        .form-page {
            padding: 20px;
        }

        .form-card {
            padding: 20px;
        }

        .form-actions {
            flex-direction: column-reverse;
        }

        .cancel-button,
        .primary-button {
            width: 100%;
            text-align: center;
            box-sizing: border-box;
        }

    }

</style>


<section class="form-page">

    <div class="form-card">


        <!-- ================================================= -->
        <!-- PAGE HEADING -->
        <!-- ================================================= -->

        <div class="form-heading">

            <h1>
                Add New Employee
            </h1>

            <p>
                Create an employee profile and assign
                organizational and employment details.
            </p>

        </div>


        <!-- ================================================= -->
        <!-- ERROR -->
        <!-- ================================================= -->

        <% if (
            typeof error !== "undefined" &&
            error
        ) { %>

            <div class="error-box">
                <%= error %>
            </div>

        <% } %>


        <!-- ================================================= -->
        <!-- SUCCESS -->
        <!-- ================================================= -->

        <% if (
            typeof success !== "undefined" &&
            success
        ) { %>

            <div class="success-box">
                <%= success %>
            </div>

        <% } %>


        <!-- ================================================= -->
        <!-- FORM -->
        <!-- ================================================= -->

        <form
            action="/employees/create"
            method="POST"
        >


            <!-- ================================================= -->
            <!-- PERSONAL INFORMATION -->
            <!-- ================================================= -->

            <div class="form-section">

                <h3>
                    Personal Information
                </h3>


                <div class="form-grid">


                    <!-- FIRST NAME -->

                    <div class="form-group">

                        <label>
                            First Name
                            <span class="required">*</span>
                        </label>

                        <input
                            type="text"
                            name="firstName"
                            value="<%= formData?.firstName || '' %>"
                            placeholder="First name"
                            autocomplete="given-name"
                            required
                        >

                    </div>


                    <!-- LAST NAME -->

                    <div class="form-group">

                        <label>
                            Last Name
                        </label>

                        <input
                            type="text"
                            name="lastName"
                            value="<%= formData?.lastName || '' %>"
                            placeholder="Last name"
                            autocomplete="family-name"
                        >

                    </div>


                    <!-- GENDER -->

                    <div class="form-group">

                        <label>
                            Gender
                        </label>

                        <select name="gender">

                            <option value="">
                                Select Gender
                            </option>

                            <option
                                value="Male"
                                <%= formData?.gender === "Male"
                                    ? "selected"
                                    : ""
                                %>
                            >
                                Male
                            </option>

                            <option
                                value="Female"
                                <%= formData?.gender === "Female"
                                    ? "selected"
                                    : ""
                                %>
                            >
                                Female
                            </option>

                            <option
                                value="Other"
                                <%= formData?.gender === "Other"
                                    ? "selected"
                                    : ""
                                %>
                            >
                                Other
                            </option>

                        </select>

                    </div>


                    <!-- DATE OF BIRTH -->

                    <div class="form-group">

                        <label>
                            Date of Birth
                        </label>

                        <input
                            type="date"
                            name="dateOfBirth"
                            value="<%= formData?.dateOfBirth || '' %>"
                        >

                    </div>


                    <!-- PHONE -->

                    <div class="form-group">

                        <label>
                            Phone
                        </label>

                        <input
                            type="tel"
                            name="phone"
                            value="<%= formData?.phone || '' %>"
                            placeholder="+91 XXXXX XXXXX"
                            autocomplete="tel"
                        >

                    </div>


                    <!-- EMAIL -->

                    <div class="form-group">

                        <label>
                            Email
                            <span class="required">*</span>
                        </label>

                        <input
                            type="email"
                            name="email"
                            value="<%= formData?.email || '' %>"
                            placeholder="employee@gyansify.com"
                            autocomplete="email"
                            required
                        >

                    </div>


                </div>

            </div>


            <!-- ================================================= -->
            <!-- ORGANIZATION -->
            <!-- ================================================= -->

            <div class="form-section">

                <h3>
                    Organization
                </h3>


                <div class="form-grid">


                    <!-- DEPARTMENT -->

                    <div class="form-group">

                        <label>
                            Department
                            <span class="required">*</span>
                        </label>

                        <select
                            name="department"
                            required
                        >

                            <option value="">
                                Select Department
                            </option>


                            <% if (
                                departments &&
                                departments.length
                            ) { %>

                                <% departments.forEach(
                                    department => {
                                %>

                                    <option
                                        value="<%= department._id %>"
                                        <%= String(
                                            formData?.department || ""
                                        ) === String(
                                            department._id
                                        )
                                            ? "selected"
                                            : ""
                                        %>
                                    >

                                        <%= department.name %>

                                        <% if (
                                            department.code
                                        ) { %>

                                            (<%= department.code %>)

                                        <% } %>

                                    </option>

                                <% }) %>

                            <% } %>

                        </select>

                    </div>


                    <!-- DESIGNATION -->

                    <div class="form-group">

                        <label>
                            Designation
                            <span class="required">*</span>
                        </label>

                        <select
                            name="designation"
                            required
                        >

                            <option value="">
                                Select Designation
                            </option>


                            <% if (
                                designations &&
                                designations.length
                            ) { %>

                                <% designations.forEach(
                                    designation => {
                                %>

                                    <option
                                        value="<%= designation._id %>"
                                        <%= String(
                                            formData?.designation || ""
                                        ) === String(
                                            designation._id
                                        )
                                            ? "selected"
                                            : ""
                                        %>
                                    >

                                        <%= designation.name %>

                                        <% if (
                                            designation.code
                                        ) { %>

                                            (<%= designation.code %>)

                                        <% } %>

                                    </option>

                                <% }) %>

                            <% } %>

                        </select>

                    </div>


                    <!-- BRANCH -->

                    <div class="form-group">

                        <label>
                            Branch
                            <span class="required">*</span>
                        </label>

                        <select
                            name="branch"
                            required
                        >

                            <option value="">
                                Select Branch
                            </option>


                            <% if (
                                branches &&
                                branches.length
                            ) { %>

                                <% branches.forEach(
                                    branch => {
                                %>

                                    <option
                                        value="<%= branch._id %>"
                                        <%= String(
                                            formData?.branch || ""
                                        ) === String(
                                            branch._id
                                        )
                                            ? "selected"
                                            : ""
                                        %>
                                    >

                                        <%= branch.name %>

                                        <% if (
                                            branch.city
                                        ) { %>

                                            - <%= branch.city %>

                                        <% } %>

                                    </option>

                                <% }) %>

                            <% } %>

                        </select>

                    </div>


                    <!-- WORK LOCATION -->

                    <div class="form-group">

                        <label>
                            Work Location
                            <span class="required">*</span>
                        </label>

                        <select
                            name="location"
                            required
                        >

                            <option value="">
                                Select Location
                            </option>


                            <% if (
                                locations &&
                                locations.length
                            ) { %>

                                <% locations.forEach(
                                    location => {
                                %>

                                    <option
                                        value="<%= location._id %>"
                                        <%= String(
                                            formData?.location || ""
                                        ) === String(
                                            location._id
                                        )
                                            ? "selected"
                                            : ""
                                        %>
                                    >

                                        <%= location.name %>

                                        <% if (
                                            location.city
                                        ) { %>

                                            - <%= location.city %>

                                        <% } %>

                                    </option>

                                <% }) %>

                            <% } %>

                        </select>

                    </div>


                </div>

            </div>


            <!-- ================================================= -->
            <!-- EMPLOYMENT -->
            <!-- ================================================= -->

            <div class="form-section">

                <h3>
                    Employment Information
                </h3>


                <div class="form-grid">


                    <!-- EMPLOYEE ID -->

                    <div class="form-group">

                        <label>
                            Employee ID
                            <span class="required">*</span>
                        </label>

                        <input
                            type="text"
                            name="employeeId"
                            placeholder="GYS-EMP-0001"
                            value="<%= formData?.employeeId || '' %>"
                            required
                        >

                    </div>


                    <!-- JOINING DATE -->

                    <div class="form-group">

                        <label>
                            Joining Date
                        </label>

                        <input
                            type="date"
                            name="joiningDate"
                            value="<%= formData?.joiningDate || '' %>"
                        >

                    </div>


                    <!-- EMPLOYMENT TYPE -->

                    <div class="form-group">

                        <label>
                            Employment Type
                        </label>

                        <select name="employmentType">

                            <option
                                value="Permanent"
                                <%= (
                                    formData?.employmentType ||
                                    "Permanent"
                                ) === "Permanent"
                                    ? "selected"
                                    : ""
                                %>
                            >
                                Permanent
                            </option>

                            <option
                                value="Probation"
                                <%= formData?.employmentType === "Probation"
                                    ? "selected"
                                    : ""
                                %>
                            >
                                Probation
                            </option>

                            <option
                                value="Contract"
                                <%= formData?.employmentType === "Contract"
                                    ? "selected"
                                    : ""
                                %>
                            >
                                Contract
                            </option>

                            <option
                                value="Intern"
                                <%= formData?.employmentType === "Intern"
                                    ? "selected"
                                    : ""
                                %>
                            >
                                Intern
                            </option>

                            <option
                                value="Part Time"
                                <%= formData?.employmentType === "Part Time"
                                    ? "selected"
                                    : ""
                                %>
                            >
                                Part Time
                            </option>

                        </select>

                    </div>


                    <!-- REPORTING MANAGER -->

                    <div class="form-group">

                        <label>
                            Reporting Manager
                        </label>

                        <input
                            type="text"
                            name="reportingManager"
                            value="<%= formData?.reportingManager || '' %>"
                            placeholder="Manager name"
                        >

                    </div>


                </div>

            </div>


            <!-- ================================================= -->
            <!-- CONTACT -->
            <!-- ================================================= -->

            <div class="form-section">

                <h3>
                    Contact Information
                </h3>


                <div class="form-grid">

                    <div class="form-group full">

                        <label>
                            Address
                        </label>

                        <textarea
                            name="address"
                            placeholder="Employee address"
                        ><%= formData?.address || "" %></textarea>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- ACTIONS -->
            <!-- ================================================= -->

            <div class="form-actions">

                <a
                    href="/employees"
                    class="cancel-button"
                >
                    Cancel
                </a>


                <button
                    type="submit"
                    class="primary-button"
                >
                    Create Employee
                </button>

            </div>


        </form>


    </div>

</section>