%>

<style>
    .reports-page,
    .reports-page * {
        box-sizing: border-box;
    }

    .reports-page {
        --rp-primary: #4f46e5;
        --rp-primary-dark: #4338ca;
        --rp-primary-soft: #eef2ff;
        --rp-text: #111827;
        --rp-muted: #64748b;
        --rp-subtle: #94a3b8;
        --rp-border: #e5e7eb;
        --rp-surface: #ffffff;
        --rp-background: #f8fafc;

        width: 100%;
        max-width: 1650px;
        margin: 0 auto;
        padding: 28px 30px 42px;
        color: var(--rp-text);
    }

    .reports-page button,
    .reports-page input,
    .reports-page select {
        font: inherit;
    }

    .reports-page button {
        -webkit-tap-highlight-color: transparent;
    }

    .rp-heading {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 26px;
    }

    .rp-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 12px;
        color: var(--rp-primary);
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1.5px;
        text-transform: uppercase;
    }

    .rp-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #10b981;
        box-shadow: 0 0 0 4px #d1fae5;
    }

    .rp-heading h1 {
        margin: 0;
        font-size: clamp(27px, 3vw, 36px);
        font-weight: 800;
        line-height: 1.2;
        letter-spacing: -1.3px;
    }

    .rp-heading p {
        max-width: 650px;
        margin: 11px 0 0;
        color: var(--rp-muted);
        font-size: 13px;
        line-height: 1.8;
    }

    .rp-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .rp-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        min-height: 43px;
        padding: 0 15px;
        border: 1px solid var(--rp-border);
        border-radius: 10px;
        background: #fff;
        color: #374151;
        font-size: 12px;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
        transition: background .18s, border-color .18s;
    }

    .rp-btn:hover {
        border-color: #c7d2fe;
        background: #f8faff;
    }

    .rp-btn-primary {
        border-color: var(--rp-primary);
        background: var(--rp-primary);
        color: #fff;
    }

    .rp-btn-primary:hover {
        border-color: var(--rp-primary-dark);
        background: var(--rp-primary-dark);
        color: #fff;
    }

    .rp-btn:focus-visible,
    .rp-search input:focus-visible,
    .rp-filter:focus-visible,
    .rp-open:focus-visible {
        outline: 3px solid #c7d2fe;
        outline-offset: 3px;
    }

    .rp-stats {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 15px;
        margin-bottom: 28px;
    }

    .rp-stat {
        min-width: 0;
        padding: 19px;
        border: 1px solid var(--rp-border);
        border-radius: 15px;
        background: #fff;
        box-shadow: 0 3px 12px rgb(15 23 42 / 3%);
        transition: transform .2s, box-shadow .2s;
    }

    .rp-stat:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 25px rgb(15 23 42 / 6%);
    }

    .rp-stat-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
    }

    .rp-stat-label {
        color: var(--rp-muted);
        font-size: 10px;
        font-weight: 800;
        letter-spacing: .7px;
        text-transform: uppercase;
    }

    .rp-stat-icon,
    .rp-card-icon {
        display: grid;
        flex: 0 0 auto;
        place-items: center;
    }

    .rp-stat-icon {
        width: 39px;
        height: 39px;
        border-radius: 12px;
        font-size: 18px;
    }

    .rp-stat-value {
        margin-top: 15px;
        font-size: clamp(25px, 2vw, 31px);
        font-weight: 800;
        line-height: 1.2;
        letter-spacing: -1px;
        overflow-wrap: anywhere;
        font-variant-numeric: tabular-nums;
    }

    .rp-stat-caption {
        margin-top: 7px;
        color: var(--rp-subtle);
        font-size: 11px;
        line-height: 1.6;
    }

    .rp-blue { background: #eff6ff; color: #2563eb; }
    .rp-green { background: #ecfdf5; color: #059669; }
    .rp-orange { background: #fff7ed; color: #ea580c; }
    .rp-purple { background: #f5f3ff; color: #7c3aed; }
    .rp-rose { background: #fff1f2; color: #e11d48; }
    .rp-cyan { background: #ecfeff; color: #0891b2; }

    .rp-library {
        padding: 23px;
        border: 1px solid var(--rp-border);
        border-radius: 18px;
        background: #fff;
        box-shadow: 0 4px 16px rgb(15 23 42 / 2.5%);
    }

    .rp-library-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 20px;
    }

    .rp-library-header h2 {
        margin: 0;
        font-size: 19px;
        font-weight: 800;
        letter-spacing: -.5px;
    }

    .rp-library-header p {
        margin: 7px 0 0;
        color: var(--rp-muted);
        font-size: 12px;
        line-height: 1.7;
    }

    .rp-tools {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
    }

    .rp-search {
        display: flex;
        align-items: center;
        gap: 10px;
        width: 250px;
        min-height: 43px;
        padding: 0 13px;
        border: 1px solid var(--rp-border);
        border-radius: 10px;
        background: #fff;
    }

    .rp-search:focus-within {
        border-color: #a5b4fc;
        box-shadow: 0 0 0 3px rgb(99 102 241 / 8%);
    }

    .rp-search-icon {
        color: var(--rp-subtle);
        font-size: 19px;
    }

    .rp-search input {
        width: 100%;
        min-width: 0;
        padding: 0;
        border: 0;
        outline: none;
        background: transparent;
        color: var(--rp-text);
        font-size: 12px;
    }

    .rp-filter {
        width: 170px;
        min-height: 43px;
        padding: 0 12px;
        border: 1px solid var(--rp-border);
        border-radius: 10px;
        background: #fff;
        color: #374151;
        font-size: 12px;
        cursor: pointer;
    }

    .rp-results-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 24px;
        padding-bottom: 16px;
        border-bottom: 1px solid #f1f5f9;
    }

    .rp-results {
        margin: 0;
        color: var(--rp-muted);
        font-size: 11px;
    }

    .rp-results strong {
        color: var(--rp-text);
    }

    .rp-clear {
        padding: 5px 0;
        border: 0;
        background: transparent;
        color: var(--rp-primary);
        font-size: 11px;
        font-weight: 700;
        cursor: pointer;
    }

    .rp-clear:hover {
        color: var(--rp-primary-dark);
        text-decoration: underline;
    }

    .rp-section {
        margin-bottom: 30px;
    }

    .rp-section:last-child {
        margin-bottom: 0;
    }

    .rp-section[hidden],
    .rp-card[hidden] {
        display: none !important;
    }

    .rp-section-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 14px;
    }

    .rp-section-heading h3 {
        margin: 0;
        font-size: 15px;
        font-weight: 800;
    }

    .rp-section-heading p {
        margin: 5px 0 0;
        color: var(--rp-subtle);
        font-size: 11px;
        line-height: 1.6;
    }

    .rp-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 31px;
        height: 28px;
        padding: 0 9px;
        border-radius: 8px;
        background: var(--rp-primary-soft);
        color: var(--rp-primary);
        font-size: 11px;
        font-weight: 800;
    }

    .rp-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 15px;
    }

    .rp-card {
        display: flex;
        min-width: 0;
        flex-direction: column;
        padding: 21px;
        border: 1px solid var(--rp-border);
        border-radius: 15px;
        background: #fff;
        transition: transform .2s, border-color .2s, box-shadow .2s;
    }

    .rp-card:hover {
        transform: translateY(-2px);
        border-color: #c7d2fe;
        box-shadow: 0 12px 26px rgb(15 23 42 / 5%);
    }

    .rp-card-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
    }

    .rp-card-icon {
        width: 46px;
        height: 46px;
        border-radius: 13px;
        font-size: 21px;
    }

    .rp-category {
        padding: 6px 8px;
        border: 1px solid #e5e7eb;
        border-radius: 7px;
        background: #f9fafb;
        color: #64748b;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: .4px;
    }

    .rp-card h4 {
        margin: 17px 0 0;
        font-size: 15px;
        font-weight: 800;
        line-height: 1.45;
    }

    .rp-card-description {
        flex: 1;
        margin: 9px 0 20px;
        color: var(--rp-muted);
        font-size: 12px;
        line-height: 1.8;
    }

    .rp-card-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding-top: 14px;
        border-top: 1px solid #f1f5f9;
    }

    .rp-card-type {
        color: var(--rp-subtle);
        font-size: 10px;
        line-height: 1.5;
    }

    .rp-open {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--rp-primary);
        font-size: 11px;
        font-weight: 800;
        text-decoration: none;
        white-space: nowrap;
    }

    .rp-open:hover {
        color: var(--rp-primary-dark);
    }

    .rp-empty {
        display: none;
        padding: 45px 20px;
        border: 1px dashed #cbd5e1;
        border-radius: 14px;
        background: #f8fafc;
        text-align: center;
    }

    .rp-empty.visible {
        display: block;
    }

    .rp-empty-icon {
        display: grid;
        width: 54px;
        height: 54px;
        margin: 0 auto 14px;
        place-items: center;
        border-radius: 16px;
        background: #eef2ff;
        color: var(--rp-primary);
        font-size: 25px;
    }

    .rp-empty h3 {
        margin: 0;
        font-size: 15px;
    }

    .rp-empty p {
        margin: 8px 0 0;
        color: var(--rp-muted);
        font-size: 12px;
        line-height: 1.7;
    }

    .rp-empty .rp-btn {
        margin-top: 17px;
    }

    .rp-note {
        display: flex;
        align-items: flex-start;
        gap: 13px;
        margin-top: 23px;
        padding: 17px 19px;
        border: 1px solid #dbeafe;
        border-radius: 12px;
        background: #f8fbff;
        color: #475569;
        font-size: 11px;
        line-height: 1.8;
    }

    .rp-note-icon {
        display: grid;
        width: 30px;
        height: 30px;
        flex: 0 0 30px;
        place-items: center;
        border-radius: 9px;
        background: #e0e7ff;
        color: var(--rp-primary);
        font-size: 16px;
    }

    .rp-note strong {
        color: #1e40af;
    }

    .rp-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        margin-top: 25px;
        padding-top: 18px;
        border-top: 1px solid var(--rp-border);
        color: var(--rp-subtle);
        font-size: 10px;
    }

    @media (max-width: 1250px) {
        .rp-stats {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .rp-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 900px) {
        .reports-page {
            padding: 22px 20px 34px;
        }

        .rp-heading {
            flex-direction: column;
        }

        .rp-library-header {
            align-items: stretch;
            flex-direction: column;
        }

        .rp-tools {
            width: 100%;
        }

        .rp-search {
            flex: 1;
            width: auto;
        }
    }

    @media (max-width: 600px) {
        .reports-page {
            padding: 18px 13px 28px;
        }

        .rp-heading h1 {
            font-size: 27px;
        }

        .rp-actions {
            width: 100%;
        }

        .rp-actions .rp-btn {
            flex: 1;
            padding: 0 9px;
        }

        .rp-stats {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 10px;
            margin-bottom: 22px;
        }

        .rp-stat {
            padding: 14px;
        }

        .rp-stat-label {
            font-size: 9px;
        }

        .rp-stat-icon {
            width: 34px;
            height: 34px;
            border-radius: 10px;
            font-size: 16px;
        }

        .rp-stat-value {
            margin-top: 12px;
            font-size: 25px;
        }

        .rp-library {
            padding: 15px;
        }

        .rp-tools {
            align-items: stretch;
            flex-direction: column;
        }

        .rp-search,
        .rp-filter {
            width: 100%;
            min-height: 43px;
        }

        .rp-grid {
            grid-template-columns: 1fr;
        }

        .rp-card {
            padding: 18px;
        }

        .rp-footer {
            align-items: flex-start;
            flex-direction: column;
            gap: 7px;
        }
    }

    @media (max-width: 360px) {
        .rp-stats {
            grid-template-columns: 1fr;
        }

        .rp-actions {
            flex-direction: column;
        }
    }

    @media print {
        .reports-page {
            max-width: none;
            padding: 0;
        }

        .rp-actions,
        .rp-tools,
        .rp-open,
        .rp-note,
        .rp-clear {
            display: none !important;
        }

        .rp-library {
            padding: 0;
            border: 0;
            box-shadow: none;
        }

        .rp-stats {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .rp-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .rp-stat,
        .rp-card {
            break-inside: avoid;
            box-shadow: none;
        }

        .rp-card:hover,
        .rp-stat:hover {
            transform: none;
        }

        .rp-section[hidden],
        .rp-card[hidden] {
            display: none !important;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .reports-page *,
        .reports-page *::before,
        .reports-page *::after {
            scroll-behavior: auto !important;
            transition: none !important;
            animation: none !important;
        }
    }
</style>

<section class="reports-page">

    <header class="rp-heading">
        <div>
            <div class="rp-eyebrow">
                <span class="rp-dot" aria-hidden="true"></span>
                HR Intelligence
            </div>

            <h1>Reports &amp; Analytics</h1>

            <p>
                Explore workforce information, monitor HR operations and
                access reports across your organization from one place.
            </p>
        </div>

        <div class="rp-actions">
            <button type="button" class="rp-btn" id="rpPrint">
                <span aria-hidden="true">⎙</span>
                Print page
            </button>

            <button type="button" class="rp-btn rp-btn-primary" id="rpExport">
                <span aria-hidden="true">↓</span>
                Export summary
            </button>
        </div>
    </header>

    <section class="rp-stats" aria-label="HR report summary">
        <% metricCards.forEach((metric) => { %>
            <article class="rp-stat">
                <div class="rp-stat-top">
                    <span class="rp-stat-label">
                        <%= metric.label %>
                    </span>

                    <span
                        class="rp-stat-icon rp-<%= metric.color %>"
                        aria-hidden="true"
                    ><%= metric.icon %></span>
                </div>

                <div
                    class="rp-stat-value"
                    data-metric="<%= metric.key %>"
                ><%= formatNumber(reportStats[metric.key]) %></div>

                <div class="rp-stat-caption">
                    <%= metric.caption %>
                </div>
            </article>
        <% }); %>
    </section>

    <section class="rp-library" aria-labelledby="rpLibraryTitle">
        <div class="rp-library-header">
            <div>
                <h2 id="rpLibraryTitle">Report library</h2>
                <p>Find and open the report you need.</p>
            </div>

            <div class="rp-tools">
                <label class="rp-search">
                    <span class="rp-search-icon" aria-hidden="true">⌕</span>

                    <input
                        type="search"
                        id="rpSearch"
                        placeholder="Search reports..."
                        autocomplete="off"
                        aria-label="Search reports"
                    >
                </label>

                <select
                    id="rpFilter"
                    class="rp-filter"
                    aria-label="Filter reports by category"
                >
                    <option value="all">All categories</option>
                    <% allReports.forEach((report) => { %>
                        <option value="<%= report.category %>">
                            <%= report.title.replace(" Report", "") %>
                        </option>
                    <% }); %>
                </select>
            </div>
        </div>

        <div class="rp-results-row">
            <p class="rp-results" id="rpResults" aria-live="polite">
                Showing <strong><%= allReports.length %></strong> reports
            </p>

            <button type="button" class="rp-clear" id="rpClear">
                Clear filters
            </button>
        </div>

        <div id="rpReportLibrary">
            <% reportGroups.forEach((group, groupIndex) => { %>
                <section
                    class="rp-section"
                    data-report-group="<%= groupIndex %>"
                >
                    <div class="rp-section-heading">
                        <div>
                            <h3><%= group.title %></h3>
                            <p><%= group.subtitle %></p>
                        </div>

                        <span class="rp-count" data-group-count>
                            <%= group.reports.length %>
                        </span>
                    </div>

                    <div class="rp-grid">
                        <% group.reports.forEach((report) => { %>
                            <article
                                class="rp-card"
                                data-category="<%= report.category %>"
                                data-search="<%= (report.title + ' ' + report.description + ' ' + report.badge + ' ' + report.type).toLowerCase() %>"
                            >
                                <div class="rp-card-top">
                                    <div
                                        class="rp-card-icon rp-<%= report.color %>"
                                        aria-hidden="true"
                                    ><%= report.icon %></div>

                                    <span class="rp-category">
                                        <%= report.badge %>
                                    </span>
                                </div>

                                <h4><%= report.title %></h4>

                                <p class="rp-card-description">
                                    <%= report.description %>
                                </p>

                                <div class="rp-card-footer">
                                    <span class="rp-card-type">
                                        <%= report.type %>
                                    </span>

                                    <a class="rp-open" href="<%= report.url %>">
                                        Open report <span aria-hidden="true">→</span>
                                    </a>
                                </div>
                            </article>
                        <% }); %>
                    </div>
                </section>
            <% }); %>
        </div>

        <div class="rp-empty" id="rpEmpty" role="status">
            <div class="rp-empty-icon" aria-hidden="true">⌕</div>
            <h3>No reports found</h3>
            <p>Try another keyword or choose a different category.</p>

            <button type="button" class="rp-btn" id="rpClearEmpty">
                Clear filters
            </button>
        </div>
    </section>

    <aside class="rp-note">
        <span class="rp-note-icon" aria-hidden="true">ⓘ</span>

        <div>
            <strong>Reporting information</strong><br>
            Summary metrics are supplied by the reports controller.
            Each detailed report must have a working backend route and
            organization-scoped database query. Sensitive payroll and
            employee information should only be available to authorized roles.
        </div>
    </aside>

    <footer class="rp-footer">
        <span>Gyansify HRMS · Reports &amp; Analytics</span>
        <span>Internal workforce reporting</span>
    </footer>

</section>

<script>
(function () {
    "use strict";

    const root = document.querySelector(".reports-page");
    if (!root) return;

    const searchInput = root.querySelector("#rpSearch");
    const filterSelect = root.querySelector("#rpFilter");
    const cards = Array.from(root.querySelectorAll(".rp-card"));
    const groups = Array.from(root.querySelectorAll("[data-report-group]"));
    const emptyState = root.querySelector("#rpEmpty");
    const resultsLabel = root.querySelector("#rpResults");

    const clearButton = root.querySelector("#rpClear");
    const clearEmptyButton = root.querySelector("#rpClearEmpty");

    function filterReports() {
        const query = searchInput.value.trim().toLowerCase();
        const category = filterSelect.value;

        let visibleCount = 0;

        cards.forEach(function (card) {
            const searchableText = card.dataset.search || "";
            const cardCategory = card.dataset.category || "";

            const matchesSearch =
                !query || searchableText.includes(query);

            const matchesCategory =
                category === "all" || cardCategory === category;

            const visible = matchesSearch && matchesCategory;

            card.hidden = !visible;

            if (visible) visibleCount++;
        });

        groups.forEach(function (group) {
            const visibleCards = group.querySelectorAll(
                ".rp-card:not([hidden])"
            );

            group.hidden = visibleCards.length === 0;

            const countElement = group.querySelector("[data-group-count]");

            if (countElement) {
                countElement.textContent = String(visibleCards.length);
            }
        });

        emptyState.classList.toggle("visible", visibleCount === 0);

        resultsLabel.textContent =
            "Showing " + visibleCount + " of " + cards.length + " reports";
    }

    function clearFilters() {
        searchInput.value = "";
        filterSelect.value = "all";
        filterReports();
        searchInput.focus();
    }

    searchInput.addEventListener("input", filterReports);
    filterSelect.addEventListener("change", filterReports);
    clearButton.addEventListener("click", clearFilters);
    clearEmptyButton.addEventListener("click", clearFilters);

    root.querySelector("#rpPrint").addEventListener("click", function () {
        window.print();
    });

    root.querySelector("#rpExport").addEventListener("click", function () {
        const rows = [
            ["Metric", "Value"]
        ];

        root.querySelectorAll("[data-metric]").forEach(function (element) {
            rows.push([
                element.closest(".rp-stat")
                    .querySelector(".rp-stat-label")
                    .textContent.trim(),
                element.textContent.trim()
            ]);
        });

        function escapeCSV(value) {
            return '"' + String(value).replace(/"/g, '""') + '"';
        }

        const csv = rows.map(function (row) {
            return row.map(escapeCSV).join(",");
        }).join("\r\n");

        const blob = new Blob(["\uFEFF" + csv], {
            type: "text/csv;charset=utf-8;"
        });

        const objectUrl = URL.createObjectURL(blob);
        const link = document.createElement("a");

        link.href = objectUrl;
        link.download = "gyansify-hrms-report-summary.csv";

        document.body.appendChild(link);
        link.click();
        link.remove();

        window.setTimeout(function () {
            URL.revokeObjectURL(objectUrl);
        }, 1000);
    });

    filterReports();
})();
</script>
