                    description: "Review employee evaluations, performance ratings and development trends.",
                    url: "/reports/performance",
                    type: "Performance"
                }
            ]
        },
        {
            title: "People Development & Resources",
            subtitle: "Learning, employee growth and company resources",
            reports: [
                {
                    title: "Training Report",
                    category: "training",
                    badge: "LEARNING",
                    icon: "🎓",
                    color: "green",
                    description: "Monitor training participation, completion and learning programs.",
                    url: "/reports/training",
                    type: "Learning & development"
                },
                {
                    title: "Asset Report",
                    category: "assets",
                    badge: "ASSETS",
                    icon: "▣",
