
<%
    const reportStats =
        typeof stats !== "undefined" && stats && typeof stats === "object"
            ? stats
            : {};

    const safeNumber = (value) => {
        const number = Number(value);
        return Number.isFinite(number) && number >= 0
            ? Math.floor(number)
            : 0;
    };

    const formatNumber = (value) =>
        safeNumber(value).toLocaleString("en-IN");

    const reportGroups = [
        {
            title: "HR Operations",
            subtitle: "Core workforce information and daily operations",
            reports: [
                {
                    title: "Employee Report",
                    category: "employees",
