                    category: "recruitment",
                    badge: "HIRING",
                    icon: "◫",
                    color: "cyan",
                    description: "Track job openings, applications, interviews and offer progress.",
                    url: "/reports/recruitment",
                    type: "Talent acquisition"
                },
                {
                    title: "Performance Report",
                    category: "performance",
                    badge: "PERFORMANCE",
                    icon: "★",
