
<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Settings - Gyansify HRMS
    </title>

    <link
        rel="stylesheet"
        href="/css/dashboard.css"
    >

    <style>

        .settings-page {

            padding: 30px;

            max-width: 1100px;

        }


        .page-heading {

            margin-bottom: 25px;

        }


        .page-heading h1 {

            margin: 0;

            font-size: 22px;

            font-weight: 600;

            color: #111827;

        }


        .page-heading p {

            margin-top: 6px;

            font-size: 11px;

            color: #9ca3af;

        }


        .settings-grid {

            display: grid;

            grid-template-columns:
                220px 1fr;

            gap: 20px;

        }


        .settings-menu {

            background: white;

            border:
                1px solid #e5e7eb;

            border-radius: 10px;

            padding: 8px;

            height: fit-content;

        }


        .settings-menu button {

            width: 100%;

            border: none;

            background: transparent;

            text-align: left;

            padding: 11px 12px;

            border-radius: 6px;

            font-size: 11px;

            cursor: pointer;

            color: #4b5563;

        }


        .settings-menu button:hover {

            background: #f9fafb;

        }


        .settings-menu button.active {

            background: #f3f4f6;

            color: #111827;

            font-weight: 600;

        }


        .settings-card {

            background: white;

            border:
                1px solid #e5e7eb;

            border-radius: 10px;

            padding: 24px;

        }


        .settings-card h2 {

            margin: 0;

            font-size: 15px;

            color: #111827;

        }


        .settings-card-description {

            margin-top: 5px;

            margin-bottom: 25px;

            font-size: 10px;

            color: #9ca3af;

        }


        .form-group {

            margin-bottom: 18px;

        }


        .form-group label {

            display: block;

            margin-bottom: 7px;

            font-size: 10px;

            font-weight: 600;

            color: #374151;

        }


        .form-group input,
        .form-group select {

            width: 100%;

            box-sizing: border-box;

            height: 36px;

            border:
                1px solid #d1d5db;

            border-radius: 6px;

            padding: 0 10px;

            font-size: 10px;

            outline: none;

        }


        .form-group input:focus,
        .form-group select:focus {

            border-color: #9ca3af;

            box-shadow:
                0 0 0 2px
                rgba(17,24,39,.05);

        }


        .form-row {

            display: grid;

            grid-template-columns:
                repeat(2, 1fr);

            gap: 15px;

        }


        .save-button {

            border: none;

            background: #111827;

            color: white;

            padding:
                9px 16px;

            border-radius: 6px;

            font-size: 10px;

            cursor: pointer;

        }


        .save-button:hover {

            background: #1f2937;

        }


        .setting-section {

            display: none;

        }


        .setting-section.active {

            display: block;

        }


        .info-box {

            background: #f9fafb;

            border:
                1px solid #e5e7eb;

            border-radius: 8px;

            padding: 15px;

            margin-bottom: 20px;

        }


        .info-title {

            font-size: 11px;

            font-weight: 600;

            color: #111827;

            margin-bottom: 5px;

        }


        .info-text {

            font-size: 10px;

            color: #6b7280;

            line-height: 1.6;

        }


        @media(max-width:800px) {

            .settings-grid {

                grid-template-columns: 1fr;

            }

        }


        @media(max-width:500px) {

            .settings-page {

                padding: 20px;

            }

            .form-row {

                grid-template-columns: 1fr;

            }

        }

    </style>

</head>


<body>


<div class="app">


    <!-- ================================================= -->
    <!-- SIDEBAR -->
    <!-- ================================================= -->

    <aside class="sidebar">

        <div class="brand">

            <div class="brand-logo">
                G
            </div>

            <div>

                <div class="brand-name">
                    Gyansify
                </div>

                <div class="brand-subtitle">
                    HRMS
                </div>

            </div>

        </div>


        <div class="menu-title">
            MAIN
        </div>


        <nav class="sidebar-menu">


            <a
                href="/dashboard"
                class="menu-item"
            >
                <span>▦</span>
                Dashboard
            </a>


            <a
                href="/employees"
                class="menu-item"
            >
                <span>👥</span>
                Employees
            </a>


            <a
                href="/attendance"
                class="menu-item"
            >
                <span>◷</span>
                Attendance
            </a>


            <a
                href="/leave"
                class="menu-item"
            >
                <span>▣</span>
                Leave
            </a>


            <a
                href="/payroll"
                class="menu-item"
            >
                <span>₹</span>
                Payroll
            </a>


            <a
                href="/organization"
                class="menu-item"
            >
                <span>⚙</span>
                Organization
            </a>


            <a
                href="/recruitment"
                class="menu-item"
            >
                <span>◫</span>
                Recruitment
            </a>


            <a
                href="/settings"
                class="menu-item active"
            >
                <span>⚙</span>
                Settings
            </a>


        </nav>

    </aside>


    <!-- ================================================= -->
    <!-- MAIN -->
    <!-- ================================================= -->

    <main class="main">


        <header class="header">

            <span class="page-title">
                Settings
            </span>

        </header>


        <section class="settings-page">


            <div class="page-heading">

                <h1>
                    Settings
                </h1>

                <p>
                    Manage your HRMS preferences
                    and system configuration.
                </p>

            </div>


            <div class="settings-grid">


                <!-- SETTINGS MENU -->

                <div class="settings-menu">


                    <button
                        type="button"
                        class="active"
                        data-section="general"
                    >
                        General
                    </button>


                    <button
                        type="button"
                        data-section="account"
                    >
                        Account
                    </button>


                    <button
                        type="button"
                        data-section="notifications"
                    >
                        Notifications
                    </button>


                    <button
                        type="button"
                        data-section="security"
                    >
                        Security
                    </button>


                </div>


                <!-- SETTINGS CONTENT -->

                <div class="settings-card">


                    <!-- GENERAL -->

                    <div
                        id="general"
                        class="setting-section active"
                    >

                        <h2>
                            General Settings
                        </h2>

                        <div class="settings-card-description">
                            Configure basic HRMS preferences.
                        </div>


                        <div class="info-box">

                            <div class="info-title">
                                Gyansify HRMS
                            </div>

                            <div class="info-text">
                                These settings control
                                the general behavior of
                                your HRMS system.
                            </div>

                        </div>


                        <div class="form-row">


                            <div class="form-group">

                                <label>
                                    Timezone
                                </label>

                                <select>

                                    <option selected>
                                        Asia/Kolkata
                                    </option>

                                    <option>
                                        Asia/Dubai
                                    </option>

                                    <option>
                                        Asia/Singapore
                                    </option>

                                    <option>
                                        UTC
                                    </option>

                                </select>

                            </div>


                            <div class="form-group">

                                <label>
                                    Currency
                                </label>

                                <select>

                                    <option selected>
                                        INR - Indian Rupee
                                    </option>

                                    <option>
                                        USD - US Dollar
                                    </option>

                                    <option>
                                        EUR - Euro
                                    </option>

                                </select>

                            </div>


                        </div>


                        <button
                            type="button"
                            class="save-button"
                        >
                            Save Changes
                        </button>


                    </div>


                    <!-- ACCOUNT -->

                    <div
                        id="account"
                        class="setting-section"
                    >

                        <h2>
                            Account Settings
                        </h2>

                        <div class="settings-card-description">
                            Manage your account information.
                        </div>


                        <div class="form-group">

                            <label>
                                Name
                            </label>

                            <input
                                type="text"
                                value="<%= user?.name || '' %>"
                            >

                        </div>


                        <div class="form-group">

                            <label>
                                Email
                            </label>

                            <input
                                type="email"
                                value="<%= user?.email || '' %>"
                                readonly
                            >

                        </div>


                        <button
                            type="button"
                            class="save-button"
                        >
                            Update Account
                        </button>


                    </div>


                    <!-- NOTIFICATIONS -->

                    <div
                        id="notifications"
                        class="setting-section"
                    >

                        <h2>
                            Notifications
                        </h2>

                        <div class="settings-card-description">
                            Control HRMS notification preferences.
                        </div>


                        <div class="info-box">

                            <div class="info-title">
                                Email Notifications
                            </div>

                            <div class="info-text">
                                Notification preferences will
                                be connected to the HRMS
                                notification service.
                            </div>

                        </div>


                        <button
                            type="button"
                            class="save-button"
                        >
                            Save Preferences
                        </button>


                    </div>


                    <!-- SECURITY -->

                    <div
                        id="security"
                        class="setting-section"
                    >

                        <h2>
                            Security
                        </h2>

                        <div class="settings-card-description">
                            Manage account security settings.
                        </div>


                        <div class="info-box">

                            <div class="info-title">
                                Password
                            </div>

                            <div class="info-text">
                                Password management,
                                sessions and security
                                controls will be available
                                here.
                            </div>

                        </div>


                        <button
                            type="button"
                            class="save-button"
                        >
                            Change Password
                        </button>


                    </div>


                </div>

            </div>


        </section>


    </main>


</div>


<script>

document.addEventListener(
    "DOMContentLoaded",
    function () {

        const buttons =
            document.querySelectorAll(
                ".settings-menu button"
            );

        const sections =
            document.querySelectorAll(
                ".setting-section"
            );


        buttons.forEach(
            button => {

                button.addEventListener(
                    "click",
                    function () {

                        const target =
                            this.dataset.section;


                        buttons.forEach(
                            item => {

                                item.classList.remove(
                                    "active"
                                );

                            }
                        );


                        sections.forEach(
                            section => {

                                section.classList.remove(
                                    "active"
                                );

                            }
                        );


                        this.classList.add(
                            "active"
                        );


                        const section =
                            document.getElementById(
                                target
                            );


                        if (section) {

                            section.classList.add(
                                "active"
                            );

                        }

                    }
                );

            }
        );

    }

);

</script>


</body>

</html>