            </div>


            <!-- INTERVIEW -->

            <div class="recruitment-pipeline-item">

                <div class="recruitment-pipeline-top">

                    <span class="recruitment-pipeline-label">
                        Interview
                    </span>

                    <span class="recruitment-pipeline-icon pipeline-orange">
                        🎯
                    </span>

                </div>

                <div class="recruitment-pipeline-number">
                    <%= safeNumber(recruitmentStats.interviews) %>
                </div>

                <div class="recruitment-pipeline-description">
                    Scheduled interviews
                </div>

            </div>


            <!-- OFFER -->

            <div class="recruitment-pipeline-item">

                <div class="recruitment-pipeline-top">

                    <span class="recruitment-pipeline-label">
                        Offer
                    </span>

                    <span class="recruitment-pipeline-icon pipeline-yellow">
                        📄
                    </span>

                </div>

                <div class="recruitment-pipeline-number">
                    <%= safeNumber(recruitmentStats.offers) %>
                </div>

                <div class="recruitment-pipeline-description">
                    Offers released
                </div>

            </div>


            <!-- HIRED -->

            <div class="recruitment-pipeline-item">

                <div class="recruitment-pipeline-top">

                    <span class="recruitment-pipeline-label">
                        Hired
                    </span>

                    <span class="recruitment-pipeline-icon pipeline-green">
                        ✓
                    </span>

                </div>

                <div class="recruitment-pipeline-number">
                    <%= safeNumber(recruitmentStats.hired) %>
                </div>

                <div class="recruitment-pipeline-description">
                    Successfully hired
                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         JOBS + QUICK ACTIONS
         ===================================================== -->

    <div class="recruitment-main-grid">


        <!-- =================================================
             JOB OPENINGS
             ================================================= -->

        <div class="recruitment-section-card recruitment-jobs-card">


            <!-- HEADER -->

            <div class="recruitment-section-header">

                <div>

                    <h2 class="recruitment-section-title">
                        Job Openings
                    </h2>

                    <p class="recruitment-section-description">
                        Current recruitment positions.
                    </p>

                </div>


                <a
                    href="/recruitment/create"
                    class="recruitment-section-link"
                >
                    + Add Job
                </a>

            </div>


            <!-- BODY -->

            <div class="recruitment-jobs-body">


                <% if (recruitmentJobList.length === 0) { %>


                    <!-- EMPTY STATE -->

                    <div class="recruitment-empty">

                        <div class="recruitment-empty-icon">
                            💼
                        </div>

                        <div class="recruitment-empty-title">
                            No job openings yet
                        </div>

                        <div class="recruitment-empty-description">
                            Create your first job opening to start
                            receiving applications and building your
                            recruitment pipeline.
                        </div>

                        <a
                            href="/recruitment/create"
                            class="recruitment-empty-btn"
                        >
                            Create Job Opening
                        </a>

                    </div>


                <% } else { %>


                    <!-- JOB LIST -->

                    <% recruitmentJobList.forEach(function(job) { %>

                        <div class="recruitment-job-row">


                            <div class="recruitment-job-info">

                                <div class="recruitment-job-title">
                                    <%= job.title || "Untitled Position" %>
                                </div>


                                <div class="recruitment-job-meta">

                                    <span class="recruitment-job-meta-item">
                                        🏢
                                        <%= job.department || "Department not specified" %>
                                    </span>


                                    <% if (job.location) { %>

                                        <span class="recruitment-job-meta-item">
                                            📍
                                            <%= job.location %>
                                        </span>

                                    <% } %>


                                    <% if (job.employmentType) { %>

                                        <span class="recruitment-job-meta-item">
                                            💼
                                            <%= job.employmentType %>
                                        </span>

                                    <% } %>

                                </div>

                            </div>


                            <div class="recruitment-job-actions">


                                <span class="recruitment-status <%= getJobStatusClass(job.status) %>">

                                    <%= job.status || "OPEN" %>

                                </span>


                                <span class="recruitment-job-applications">

                                    <%= safeNumber(job.applications) %>
                                    applications

                                </span>

                            </div>

                        </div>

                    <% }); %>


                <% } %>

            </div>

        </div>


        <!-- =================================================
             QUICK ACTIONS
             ================================================= -->

        <div class="recruitment-section-card">


            <div class="recruitment-section-header">

                <div>

                    <h2 class="recruitment-section-title">
                        Quick Actions
                    </h2>

                    <p class="recruitment-section-description">
                        Frequently used recruitment actions.
                    </p>

                </div>

            </div>


            <div class="recruitment-actions-body">


                <!-- CREATE JOB -->

                <a
                    href="/recruitment/create"
                    class="recruitment-action"
                >

                    <div class="recruitment-action-icon action-blue">
                        💼
                    </div>

                    <div class="recruitment-action-content">

                        <div class="recruitment-action-title">
                            Create Job
                        </div>

                        <div class="recruitment-action-description">
                            Create a new vacancy
                        </div>

                    </div>

                    <div class="recruitment-action-arrow">
                        →
                    </div>

                </a>


                <!-- CANDIDATES -->

                <a
                    href="/recruitment/candidates"
                    class="recruitment-action"
                >

                    <div class="recruitment-action-icon action-purple">
                        👥
                    </div>

                    <div class="recruitment-action-content">

                        <div class="recruitment-action-title">
                            Candidates
                        </div>

                        <div class="recruitment-action-description">
                            Manage applicants
                        </div>

                    </div>

                    <div class="recruitment-action-arrow">
                        →
                    </div>

                </a>


                <!-- INTERVIEWS -->

                <a
                    href="/recruitment/interviews"
                    class="recruitment-action"
                >

                    <div class="recruitment-action-icon action-orange">
                        📅
                    </div>

                    <div class="recruitment-action-content">

                        <div class="recruitment-action-title">
                            Interviews
                        </div>

                        <div class="recruitment-action-description">
                            Manage interview schedules
                        </div>

                    </div>

                    <div class="recruitment-action-arrow">
                        →
                    </div>

                </a>


                <!-- OFFERS -->

                <a
                    href="/recruitment/offers"
                    class="recruitment-action"
                >

                    <div class="recruitment-action-icon action-green">
                        📄
                    </div>

                    <div class="recruitment-action-content">

                        <div class="recruitment-action-title">
                            Offers
                        </div>

                        <div class="recruitment-action-description">
                            Manage job offers
                        </div>

                    </div>

                    <div class="recruitment-action-arrow">
                        →
                    </div>

                </a>

            </div>

        </div>

    </div>


    <!-- =====================================================
         RECENT APPLICATIONS
         ===================================================== -->

    <div class="recruitment-section-card recruitment-applications-card">


        <div class="recruitment-section-header">

            <div>

                <h2 class="recruitment-section-title">
                    Recent Applications
                </h2>

                <p class="recruitment-section-description">
                    Latest candidate applications.
                </p>

            </div>


            <a
                href="/recruitment/candidates"
                class="recruitment-section-link"
            >
                View All
            </a>

        </div>


        <% if (recruitmentApplicationList.length === 0) { %>


            <!-- EMPTY -->

            <div class="recruitment-empty">

                <div class="recruitment-empty-icon">
                    👥
                </div>

                <div class="recruitment-empty-title">
                    No applications yet
                </div>

                <div class="recruitment-empty-description">
                    Candidate applications will appear here once
                    applicants start applying for open positions.
                </div>

            </div>


        <% } else { %>


            <!-- APPLICATION LIST -->

            <% recruitmentApplicationList.forEach(function(application) { %>

                <%
                    const candidateName =
                        application.name ||
                        application.candidateName ||
                        "Candidate";

                    const candidatePosition =
                        application.position ||
                        application.jobTitle ||
                        "Position not specified";

                    const applicationStatus =
                        application.status ||
                        "APPLIED";

                    const candidateInitial =
                        String(candidateName)
                            .charAt(0)
                            .toUpperCase();
                %>


                <div class="recruitment-application-row">


                    <div class="recruitment-candidate">


                        <div class="recruitment-candidate-avatar">

                            <%= candidateInitial %>

                        </div>


                        <div class="recruitment-candidate-info">

                            <div class="recruitment-candidate-name">

                                <%= candidateName %>

                            </div>

                            <div class="recruitment-candidate-position">

                                <%= candidatePosition %>

                            </div>

                        </div>

                    </div>


                    <span
                        class="recruitment-application-status <%= getApplicationStatusClass(applicationStatus) %>"
                    >
                        <%= applicationStatus %>
                    </span>

                </div>

            <% }); %>


        <% } %>

    </div>


</div>