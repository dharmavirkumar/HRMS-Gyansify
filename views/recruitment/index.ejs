<%
/* =========================================================
   SAFE RECRUITMENT DATA
   ========================================================= */

const recruitmentStats =
    typeof stats !== "undefined" && stats
        ? stats
        : {
            openPositions: 0,
            applications: 0,
            interviews: 0,
            hired: 0,
            screening: 0,
            offers: 0
        };


const recruitmentJobList =
    typeof jobOpenings !== "undefined" &&
    Array.isArray(jobOpenings)
        ? jobOpenings
        : [];


const recruitmentApplicationList =
    typeof recentApplications !== "undefined" &&
    Array.isArray(recentApplications)
        ? recentApplications
        : [];


/* =========================================================
   SAFE NUMBER
   ========================================================= */

const safeNumber = (value) => {

    const number = Number(value);

    return Number.isFinite(number)
        ? number
        : 0;
};


/* =========================================================
   STATUS CLASS
   ========================================================= */

const getJobStatusClass = (status) => {

    const normalized =
        String(status || "OPEN")
            .toUpperCase()
            .trim();

    if (normalized === "OPEN") {
        return "recruitment-status-open";
    }

    if (normalized === "CLOSED") {
        return "recruitment-status-closed";
    }

    if (normalized === "ON_HOLD") {
        return "recruitment-status-hold";
    }

    if (normalized === "DRAFT") {
        return "recruitment-status-draft";
    }

    return "recruitment-status-default";
};


/* =========================================================
   APPLICATION STATUS CLASS
   ========================================================= */

const getApplicationStatusClass = (status) => {

    const normalized =
        String(status || "APPLIED")
            .toUpperCase()
            .trim();

    if (
        normalized === "HIRED" ||
        normalized === "SELECTED"
    ) {
        return "recruitment-application-success";
    }

    if (
        normalized === "INTERVIEW" ||
        normalized === "INTERVIEW_SCHEDULED"
    ) {
        return "recruitment-application-warning";
    }

    if (
        normalized === "REJECTED"
    ) {
        return "recruitment-application-danger";
    }

    if (
        normalized === "SCREENING"
    ) {
        return "recruitment-application-purple";
    }

    return "recruitment-application-default";
};

